#!/usr/bin/env bash
# pre-push — refuse to push onto a main whose CI is red, unless the push says it knows; and refuse to push
# app or package code that `Tools/local-tests.sh` has not passed on.
#
# This fork pushes straight to main (no pull requests), so nothing forces anyone to look at CI after a
# push. `Swift Packages CI` stayed red on main from 2026-09-22 for days while ten more commits landed on
# top of it: the failure was in code that compiles with the Swift on a developer's Mac and not with the
# older default toolchain of the `macos-15` runner, so every local run was green and nobody saw it.
# The consequence was worse than one red badge — none of the package tests of those ten commits ran in
# CI at all, because the test target no longer compiled.
#
# So before a push to main, this asks GitHub how the workflows finished on the commit the push is about
# to build on. Any failure stops the push and names it. A push that is the fix goes through deliberately:
#
#   NOOP_ALLOW_RED_MAIN=1 git push origin HEAD:main
#
# Runs still in progress are not waited for. Without `gh`, without a network or without a GitHub login the
# check is skipped with a note rather than blocking every push; source-hygiene and the CI itself remain
# the backstop.
#
# Second check, run first: a push to main that changes app code (Strand*/, NOOPWatch*/, project.yml) or a
# package needs a stamp from `Tools/local-tests.sh` for exactly the tree being pushed, because no CI runs
# StrandTests or the package tests on a push (decisions 2026-09-30 and 2026-10-10). Deliberately skipped:
#
#   NOOP_SKIP_LOCAL_TESTS=1 git push origin HEAD:main
#
# Enable once per clone (hooks are not cloned by git):
#   git config core.hooksPath .githooks
set -uo pipefail

REMOTE_NAME="${1:-origin}"
REPO="DX23876/noop"

note() { echo "pre-push: $*" >&2; }

# stdin: <local ref> <local sha> <remote ref> <remote sha> per pushed ref.
TARGET_SHA=""
LOCAL_SHA=""
while read -r _local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    TARGET_SHA="$remote_sha"
    LOCAL_SHA="$local_sha"
  fi
done

# Not a push to main, or main does not exist yet on the remote.
[ -n "$TARGET_SHA" ] || exit 0
case "$TARGET_SHA" in 0000000000000000000000000000000000000000) exit 0 ;; esac

# --- local test stamp ---------------------------------------------------------------------------------
needs_local_tests() {
  git diff --name-only "$TARGET_SHA" "$LOCAL_SHA" 2>/dev/null | grep -qE \
    '^(Strand|StrandTests|StrandiOS|StrandiOSShared|StrandiOSWidgets|StrandiOSTests|NOOPWatch[^/]*|Packages/[^/]+)/|^project\.yml$'
}
case "$LOCAL_SHA" in ""|0000000000000000000000000000000000000000) ;; *)
  if [ "${NOOP_SKIP_LOCAL_TESTS:-}" = "1" ]; then
    note "NOOP_SKIP_LOCAL_TESTS=1 — not checking for a local test run."
  elif needs_local_tests; then
    TREE="$(git rev-parse "$LOCAL_SHA^{tree}")"
    STAMPS="$(git rev-parse --git-common-dir)/noop-local-tests"
    if ! { [ -f "$STAMPS" ] && grep -q "^$TREE " "$STAMPS"; }; then
      echo "" >&2
      echo "  ✖ push rejected: app or package code changed, and Tools/local-tests.sh has not passed on this tree." >&2
      echo "" >&2
      echo "    Run it:  Tools/local-tests.sh $TARGET_SHA" >&2
      echo "    Skip deliberately:  NOOP_SKIP_LOCAL_TESTS=1 git push $REMOTE_NAME HEAD:main" >&2
      echo "" >&2
      exit 1
    fi
  fi
  ;;
esac

if [ "${NOOP_ALLOW_RED_MAIN:-}" = "1" ]; then
  note "NOOP_ALLOW_RED_MAIN=1 — skipping the CI check on $REMOTE_NAME/main."
  exit 0
fi

if ! command -v gh >/dev/null 2>&1; then
  note "gh not installed — CI state of main not checked."
  exit 0
fi

RUNS="$(gh run list --repo "$REPO" --branch main --commit "$TARGET_SHA" --limit 50 \
          --json workflowName,status,conclusion \
          --jq '.[] | select(.status == "completed") | "\(.workflowName)\t\(.conclusion)"' 2>/dev/null)" || {
  note "could not reach GitHub — CI state of main not checked."
  exit 0
}

FAILED="$(printf '%s\n' "$RUNS" | awk -F '\t' '$2 == "failure" || $2 == "timed_out" { print "      • " $1 }' | sort -u)"
[ -z "$FAILED" ] && exit 0

SHORT="$(printf '%s' "$TARGET_SHA" | cut -c1-9)"
echo "" >&2
echo "  ✖ push rejected: CI is red on $REMOTE_NAME/main ($SHORT)." >&2
echo "" >&2
printf '%s\n' "$FAILED" >&2
echo "" >&2
echo "    Look at it first:  gh run list --repo $REPO --branch main --commit $TARGET_SHA" >&2
echo "    If this push is the fix, say so:  NOOP_ALLOW_RED_MAIN=1 git push $REMOTE_NAME HEAD:main" >&2
echo "" >&2
exit 1
