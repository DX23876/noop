          "stringUnit" : {
            "state" : "translated",
            "value" : "Cel tygodniowy lub miesięczny w skrócie: ile zostało i czy idziesz zgodnie z planem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um objetivo semanal ou mensal num relance: o que falta e se estás no rumo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недельная или месячная цель с первого взгляда: сколько осталось и идёте ли вы по плану."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一眼看懂每周或每月目标：还差多少、是否进展顺利。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
