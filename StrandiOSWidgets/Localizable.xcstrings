    "A weekly or monthly goal at a glance: what is left and whether you are on course." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Wochen- oder Monatsziel auf einen Blick: was fehlt und ob du auf Kurs bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un objetivo semanal o mensual de un vistazo: lo que falta y si vas bien."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un objectif hebdomadaire ou mensuel en un coup d’œil : ce qui reste et si tu es sur la bonne voie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un obiettivo settimanale o mensile a colpo d’occhio: cosa manca e se sei in linea."
          }
