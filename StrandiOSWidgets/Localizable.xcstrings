        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cel tygodniowy lub miesięczny w skrócie: ile zostało i czy idziesz zgodnie z planem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um objetivo semanal ou mensal num relance: o que falta e se estás no rumo."
