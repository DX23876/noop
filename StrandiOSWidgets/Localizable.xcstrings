    "Charge, Effort and Rest as score rings, plus live HR and strap battery at a glance." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energie, Belastung und Erholung als Ringe, dazu Live-Herzfrequenz und Strap-Akku auf einen Blick."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carga, Esfuerzo y Descanso como anillos, más frecuencia cardíaca en vivo y batería de la pulsera de un vistazo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Charge, Effort et Repos en anneaux, avec la fréquence cardiaque en direct et la batterie du bracelet en un coup d'œil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carica, Sforzo e Riposo come anelli, più frequenza cardiaca in diretta e batteria della fascia a colpo d'occhio."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energia, Wysiłek i Odpoczynek jako pierścienie oraz tętno na żywo i bateria opaski w skrócie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carga, Esforço e Descanso em anéis, mais frequência cardíaca em direto e bateria da pulseira num relance."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заряд, Усилие и Отдых в виде колец, а также пульс в реальном времени и заряд браслета с одного взгляда."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以圆环显示能量、消耗和休息，并一眼看到实时心率和手环电量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以圓環顯示能量、消耗和休息，並一眼看到即時心率和手環電量。"
          }
        }
      }
    },
    "Charge, Effort and Rest as three rings, just like Today." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Charge, Effort und Rest als drei Ringe, genau wie unter Heute."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Charge, Effort y Rest como tres anillos, igual que en Hoy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Charge, Effort et Repos sous forme de trois anneaux, comme dans Aujourd'hui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Charge, Fatica e Riposo come tre anelli, proprio come Oggi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poziom energii, Wysiłek i Odpoczynek jako trzy pierścienie, tak jak w Dziś."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Charge, Esforço e Descanso como três anéis, assim como hoje."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Charge, Усилие и отдых в виде трех колец, как и сегодня."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "能量、消耗和休息三个圆环，与“今天”页面一致。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "能量、消耗和休息三個圓環，與「今天」頁面一致。"
          }
        }
      }
    },
