    "Total, active and basal calories for today, with an honest projection.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesamter, aktiver und basaler Kalorienverbrauch für heute – mit ehrlicher Prognose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calorías totales, activas y basales de hoy, con una proyección clara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calories totales, actives et basales du jour, avec une projection transparente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calorie totali, attive e basali di oggi, con una proiezione trasparente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzisiejsze kalorie całkowite, aktywne i podstawowe wraz z uczciwą prognozą."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Calorias totais, ativas e basais de hoje, com uma projeção transparente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Общий, активный и базовый расход калорий за сегодня с прозрачным прогнозом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的总消耗、活动消耗和基础消耗，并提供如实预测。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的總消耗、活動消耗和基礎消耗，並提供如實預測。"
          }
        }
      }
    },
