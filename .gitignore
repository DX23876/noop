# ── Claude Code session state (local, ephemeral — never commit) ──
# Tracked here (not .git/info/exclude) so the ignore behaves the same for every
# account/clone. See CLAUDE.md § Documentation & session workflow.
.claude/worktrees/
.claude/handoff/

# ── Misc / secrets (never commit) ───────────────────────────────
*.log
.env
# Deployment credentials (PAT / signing / endpoints) — never commit. `.env` above
# won't match `deploy.env`, so list it (and any `deploy.env.<stage>`) explicitly.
deploy.env
deploy.env.*
secrets.*
android/local.properties
android/keystore.properties
android/noop-release.jks

