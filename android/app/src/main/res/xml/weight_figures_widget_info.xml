<?xml version="1.0" encoding="utf-8"?>
<!-- Owner decisions 2026-11-26: the weight figures widget (iOS WeightTrackerWidgets). The app pushes updates whenever the
     weight page loads (WeightWidgets.publish); the colour is chosen when the widget is placed or edited. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:description="@string/wt_widget_desc_figures"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="1800000"
    android:configure="com.noop.widget.WeightWidgetConfigureActivity"
    android:widgetFeatures="reconfigurable|configuration_optional"
    android:initialLayout="@layout/glance_default_loading_layout" />
