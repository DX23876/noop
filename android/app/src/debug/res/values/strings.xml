<?xml version="1.0" encoding="utf-8"?>
<!--
  Fork-only (noop-staging): debug builds are the testing/staging app. The package is already
  io.github.dx23876.noop.debug (debug applicationIdSuffix), so it installs ALONGSIDE the release
  NOOP Forge (io.github.dx23876.noop) with its own data. This override gives it a distinct launcher name so the two
  are tellable apart on the home screen. Build-type source set wins over main/flavor, so
  assembleFullDebug shows "NOOP Forge Staging". Mirrors how the demo flavor labels itself "NOOP Forge Demo".
-->
<resources>
    <string name="app_name">NOOP Forge Staging</string>
</resources>
