    "Too short to judge — the band needs a few minutes to mean anything.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu kurz für eine Bewertung - der Zielbereich braucht ein paar Minuten, um aussagekräftig zu sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiado corto para juzgar: la zona necesita unos minutos para significar algo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop court pour juger - la zone a besoin de quelques minutes pour avoir un sens."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppo breve per giudicare - la fascia ha bisogno di qualche minuto per avere un senso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiado curto para julgar – a banda precisa de alguns minutos para tignificar alguma coisa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком коротко для оценки — браслету нужно несколько минут, чтобы данные обрели смысл."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时间太短，无法判断——目标区间需要几分钟才有参考意义。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "時間太短，無法判斷——目標區間需要幾分鐘才有參考意義。"
          }
        }
      }
    },
