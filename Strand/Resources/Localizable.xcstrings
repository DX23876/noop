    "Turn off to hide the Coach card and floating button. Per-metric “Ask coach” and the AI that writes your card summaries keep working." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausschalten, um die Coach-Karte und den schwebenden Button auszublenden. Das „Coach fragen“ pro Messwert und die KI, die deine Kartenzusammenfassungen schreibt, laufen weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn off to hide the Coach card and floating button. Per-metric “Ask coach” and the AI that writes your card summaries keep working."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactívalo para ocultar la tarjeta del Coach y el botón flotante. El “Preguntar al coach” por métrica y la IA que redacta los resúmenes de tus tarjetas siguen funcionando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivez pour masquer la carte du Coach et le bouton flottant. Le « Demander au coach » par métrique et l’IA qui rédige les résumés de vos cartes continuent de fonctionner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattiva per nascondere la carta Coach e il pulsante mobile. Il sistema \"Chiedi al coach\" permetrico e l'intelligenza artificiale che scrive i riepiloghi delle tue carte continuano a funzionare."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłącz, by ukryć kartę trenera i pływający przycisk. Opcja „Zapytaj trenera” przy poszczególnych wskaźnikach oraz AI pisząca podsumowania kart działają dalej."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desligue para ocultar o cartão Coach e o botão flutuante. O “Pergunte ao treinador” por métrica e a IA que escreve os resumos do seu cartão continuam funcionando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключите, чтобы скрыть карточку Coach и плавающую кнопку. Функция «Спросите тренера» по каждому показателю и ИИ, который записывает сводки ваших карточек, продолжают работать."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭以隐藏 Coach 卡和浮动按钮。按指标“询问教练”和编写卡片摘要的人工智能继续工作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉以隱藏 Coach 卡和浮動按鈕。按指標「詢問教練」和編寫卡片摘要的人工智慧繼續運作。"
          }
        }
      }
    },
