    "%@ from %@ was never finished. Saving ends it at its last logged change." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ vom %2$@ wurde nie beendet. Beim Speichern endet es mit der letzten erfassten Änderung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ from %@ was never finished. Saving ends it at its last logged change."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ del %2$@ nunca se terminó. Al guardarlo, termina en su último cambio registrado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ du %2$@ n’a jamais été terminé. L’enregistrer le termine à sa dernière modification."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ del %2$@ non è mai stato concluso. Salvandolo termina all’ultima modifica registrata."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ z %2$@ nie został zakończony. Zapisanie kończy go na ostatniej zarejestrowanej zmianie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ de %2$@ nunca foi terminado. Ao guardar, termina na última alteração registada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ от %2$@ так и не был завершён. При сохранении он закончится последним записанным изменением."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ 的 %1$@ 从未结束。保存后将以最后一次记录的更改作为结束。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ 的 %1$@ 從未結束。儲存後將以最後一次記錄的變更作為結束。"
          }
        }
      }
    },
