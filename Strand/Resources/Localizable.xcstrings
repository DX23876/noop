          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta pulseira não envia nenhum fluxo respiratório bruto. Sua frequência respiratória estimada aparece na tela Saúde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот ремень не создает необработанного потока дыхания. Предполагаемая частота дыхания отображается на экране «Здоровье»."
