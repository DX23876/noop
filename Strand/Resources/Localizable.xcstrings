    "Installing NOOP's key and confirming the ring answers only to NOOP. Keep the ring close and do not open the Oura app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOOPs Schlüssel wird installiert und bestätigt, dass der Ring nur noch NOOP antwortet. Halte den Ring in der Nähe und öffne die Oura-App nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalando la clave de NOOP y confirmando que el anillo responde solo a NOOP. Mantén el anillo cerca y no abras la app de Oura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installation de la clé de NOOP et confirmation que l'anneau ne répond qu'à NOOP. Gardez l'anneau à proximité et n'ouvrez pas l'app Oura."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installazione della chiave di NOOP e conferma che l'anello risponda solo a NOOP. Tieni l'anello vicino e non aprire l'app Oura."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalacja klucza NOOP i potwierdzenie dzwonienia odpowiada tylko na NOOP. Trzymaj pierścień blisko i nie otwieraj aplikacji Oura."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A instalação da chave do NOOP e a confirmação do anel responde apenas ao NOOP. Mantenha o anel fechado e não abra a aplicação Oura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установка ключа NOOP и подтверждение того, что кольцо отвечает только NOOP. Держите кольцо рядом и не открывайте приложение Oura."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在安装 NOOP 的密钥，并确认戒指只响应 NOOP。请让戒指保持在附近，且不要打开 Oura 应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在安裝 NOOP 的金鑰，並確認戒指只回應 NOOP。請讓戒指保持在附近，且不要打開 Oura 應用程式。"
          }
        }
      }
    },
