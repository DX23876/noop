          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У удаление удаляются сессии, наборы и упражнения __NOOP__ сгенерированные __Hevy__. Конфигурация __Hevy__ остаётся без изменений."
          }
        },
        "zh-Hans" : {
