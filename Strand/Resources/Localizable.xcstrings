        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto é uma estimativa do estímulo de treino restante, não uma medição da recuperação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это расчётный оставшийся тренировочный стимул, а не измерение восстановления."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是预计剩余的训练刺激，不是对恢复的测量。"
