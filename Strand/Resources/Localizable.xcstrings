    "Press and hold the NOOP wordmark at the top to change the order of the sections, or to show and hide them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke und halte das NOOP-Logo oben, um die Abschnitte umzuordnen oder zu verstecken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén presionado el logotipo de NOOP en la parte superior para cambiar el orden de las secciones o para mostrar y ocultarlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez et maintenez le mot-clé NOOP en haut pour modifier l’ordre des sections ou afficher/masquer les éléments."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premi e tieni premuto il logo NOOP in alto per modificare l'ordine delle sezioni o per visualizzarle e nasconderle."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naciśnij i przytrzymaj logo NOOP na górze, aby zmienić kolejność sekcji lub pokazać i ukryć je."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segurar o nome da marca NOOP no topo para alterar a ordem das seções, ou para mostrar e ocultar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите и держите слово «NOOP» вверху, чтобы изменить порядок разделов или показать и спрятать их."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
