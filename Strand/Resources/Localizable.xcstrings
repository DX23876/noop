          }
        }
      }
    },
    "It's too early to call a trend — barely any of the runway has passed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist noch zu früh, um einen Trend auszurufen – kaum etwas vom Laufsteg ist passiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's too early to call a trend — barely any of the runway has passed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es demasiado pronto para señalar una tendencia: apenas ha pasado algo de la pasarela."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est trop tôt pour qualifier une tendance : presque aucune piste n'a été franchie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È troppo presto per definire una tendenza: non è passata quasi nessuna passerella."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É muito cedo para definir uma tendência – quase nenhuma passarela passou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тенденцию называть пока рано — взлетно-посадочную полосу почти не проехали."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在判断趋势还为时过早——几乎没有任何一条跑道已经过去。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在判斷趨勢還為時過早——幾乎沒有任何一條跑道已經過去。"
          }
        }
      }
    },
    "It's within about a metre of %@.": {
