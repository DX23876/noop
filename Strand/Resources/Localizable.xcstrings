          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por agora só existe um número, por isso ainda não há com que o comparar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока доступно только одно значение, поэтому сравнивать его ещё не с чем."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前只有一个数值，因此还没有可比对象。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前只有一個數值，因此還沒有可比物件。"
          }
        }
      }
    },
    "Only one route can answer so far. The others fill in as your strap records days and you log what you eat — and the comparison is what this screen is for." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bisher kann nur ein Weg antworten. Die anderen füllen sich, während dein Band Tage aufzeichnet und du erfasst, was du isst — und der Vergleich ist der Zweck dieses Schirms."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por ahora solo una vía puede responder. Las demás se completan a medida que tu banda registra días y tú anotas lo que comes: y la comparación es para lo que sirve esta pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une seule voie peut répondre pour l'instant. Les autres se remplissent à mesure que votre bracelet enregistre des jours et que vous notez ce que vous mangez — et la comparaison est la raison d'être de cet écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per ora può rispondere una sola via. Le altre si completano man mano che il tuo braccialetto registra giorni e tu annoti cosa mangi — e il confronto è lo scopo di questa schermata."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na razie odpowiedzieć może tylko jedna droga. Pozostałe wypełnią się, gdy opaska zapisze dni, a ty zapiszesz, co jesz — a porównanie jest właśnie po to."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por agora só uma via consegue responder. As outras preenchem-se à medida que a sua pulseira regista dias e regista o que come — e a comparação é a razão de ser deste ecrã."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока ответить может только один путь. Остальные заполнятся, когда браслет запишет дни, а вы запишете, что едите, — и сравнение как раз и есть смысл этого экрана."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前只有一条路径能给出答案。随着腕带记录天数、你记录饮食，其余路径会逐步补齐——而这个界面存在的意义正是这份比较。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前只有一條路徑能給出答案。隨著腕帶記錄天數、你記錄飲食，其餘路徑會逐步補齊——而這個介面存在的意義正是這份比較。"
          }
        }
      }
    },
    "Only selected exercise definitions are stored. Workout rows retain the exercise id, not instructions or media files." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
