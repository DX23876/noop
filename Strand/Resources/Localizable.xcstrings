    "Your strap isn't accepting the alarm" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Gurt akzeptiert den Alarm nicht"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu correa no acepta la alarma"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre sangle n'accepte pas l'alarme"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo cinturino non sta accettando l'allarme."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój pasek nie akceptuje alarmu"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
