    "This is a plain, unencrypted archive — anyone who gets the file can open it with any zip tool. Store it somewhere you trust.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist ein einfaches, unverschlüsseltes Archiv — wer die Datei bekommt, kann sie mit jedem Zip-Programm öffnen. Bewahren Sie sie an einem Ort auf, dem Sie vertrauen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a plain, unencrypted archive — anyone who gets the file can open it with any zip tool. Store it somewhere you trust."
