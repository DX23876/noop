          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 trame de transfert historique type-0x2F détectée en dehors de notre synchronisation. Ce sont des éléments d'historique (par ex. une autre appli qui récupère l'arriéré du bracelet), pas un flux R22 en direct (#494)."
          }
        },
        "it" : {
          "stringUnit" : {
