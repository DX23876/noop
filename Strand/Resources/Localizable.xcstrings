    "Deletes your %@ key from the Keychain. You'll need to paste it again to reconnect." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht Ihren Schlüssel %@ aus dem Schlüsselbund. Sie müssen es erneut einfügen, um die Verbindung wiederherzustellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes your %@ key from the Keychain. You'll need to paste it again to reconnect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina su clave %@ del llavero. Tendrás que pegarlo nuevamente para volver a conectarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime votre clé %@ du trousseau. Vous devrez le coller à nouveau pour vous reconnecter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina la tua chiave %@ dal portachiavi. Dovrai incollarlo di nuovo per riconnetterti."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa Twój klucz %@ z Pęku kluczy. Aby połączyć się ponownie, trzeba będzie wkleić go jeszcze raz."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclui sua chave %@ do chaveiro. Você precisará colá-lo novamente para reconectar."
          }
