    "Is this good, or something to watch?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist das gut oder etwas, das man sich ansehen sollte?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is this good, or something to watch?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Es esto bueno o algo para ver?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Est-ce bien ou quelque chose à regarder ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Va bene o è qualcosa da guardare?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso é bom ou algo para assistir?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это хорошо или стоит посмотреть?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是好事还是值得一看的？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是好事還是值得一看的？"
          }
        }
      }
    },
    "It all stays on your strap and %@: no account, no cloud.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bleibt auf deinem Strap und %@: kein Konto, keine Cloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo permanece en tu pulsera y en %@: sin cuenta, sin nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout reste sur votre bracelet et %@ : pas de compte, pas de cloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto resta sulla tua fascia e su %@: nessun account, nessun cloud."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fica tudo na tua bracelete e %@: sem conta, sem nuvem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё остаётся на вашем браслете и %@: без аккаунта, без облака."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一切都留在你的手环和 %@ 上：无账号，无云端。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一切都留在你的手環和 %@ 上：沒有帳號，沒有雲端。"
          }
        }
      }
    },
