    },
    "Deep breathing with a short pause: inhale 4s, hold 2s, exhale 6s. Breathe through the nose when you can, fill the lungs without forcing, and let the longer exhale slow you down." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiefes Atmen mit kurzer Pause: ein 4 s, halten 2 s, aus 6 s. Wenn möglich durch die Nase, Lungen füllen ohne zu pressen, und den längeren Ausatem dich verlangsamen lassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deep breathing with a short pause: inhale 4s, hold 2s, exhale 6s. Breathe through the nose when you can, fill the lungs without forcing, and let the longer exhale slow you down."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiración profunda con pausa corta: inhala 4 s, mantén 2 s, exhala 6 s. Por la nariz cuando puedas, llena los pulmones sin forzar y deja que la exhalación más larga te frene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiration profonde avec courte pause : inspire 4 s, retenez 2 s, expire 6 s. Par le nez si possible, remplissez les poumons sans forcer et laissez la plus longue expiration vous ralentir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiro profondo con breve pausa: ispira 4 s, trattieni 2 s, espira 6 s. Dal naso quando puoi, riempi i polmoni senza forzare e lascia che l’espirazione più lunga ti rallenti."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Głęboki oddech z krótką pauzą: wdech 4 s, wstrzymaj 2 s, wydech 6 s. Nosem gdy możesz, wypełnij płuca bez forsowania i pozwól dłuższemu wydechowi cię spowolnić."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiração profunda com pausa curta: inspira 4 s, segura 2 s, expira 6 s. Pelo nariz quando puderes, enche os pulmões sem forçar e deixa a expiração mais longa abrandar-te."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Глубокое дыхание с короткой паузой: вдох 4 с, задержка 2 с, выдох 6 с. Носом когда можно, наполняйте лёгкие без силы и пусть более длинный выдох вас замедлит."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深呼吸加短暂停：吸 4 秒、屏 2 秒、呼 6 秒。尽量用鼻，充肺但不强推，让较长呼气帮你慢下来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深呼吸加短暫停：吸 4 秒、屏 2 秒、呼 6 秒。盡量用鼻，充肺但不強推，讓較長呼氣幫你慢下來。"
          }
        }
      }
    },
    "Deep calm" : {
      "localizations" : {
