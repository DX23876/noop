        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fazer da %1$@ a tua bracelete ativa? A partir de agora fornece os teus dados em direto. A histórico de %2$@ permanece exatamente como está, apenas novos dias vêm de %3$@."
          }
