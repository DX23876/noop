    "The scatter looked rounder and more spread out than a tight, steady beat. This has many ordinary causes and is not a diagnosis." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Streuung sah runder und weiter verteilt aus als ein enger, gleichmäßiger Schlag. Das hat viele gewöhnliche Ursachen und ist keine Diagnose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dispersión se vio más redonda y extendida que un latido compacto y estable. Esto tiene muchas causas comunes y no es un diagnóstico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dispersion semblait plus ronde et plus étalée qu'un battement compact et régulier. Cela a de nombreuses causes ordinaires et n'est pas un diagnostic."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dispersione appariva più rotonda e più sparsa rispetto a un battito compatto e regolare. Ha molte cause ordinarie e non è una diagnosi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozproszenie wyglądało na bardziej okrągłe i rozproszone niż ciasny, równy rytm. Ma to wiele zwyczajnych przyczyn i nie jest diagnozą."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A dispersão parecia mais redonda e espalhada do que uma batida firme e constante. Isto tem muitas causas comuns e não é um diagnóstico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разброс выглядел более круглым и рассеянным, чем при чётком, ровном ритме. У этого много обычных причин, и это не диагноз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "散点图比紧密、稳定的心搏显得更圆、更分散。这有许多常见原因，并非诊断结论。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "散點圖看起來比緊湊、穩定的心跳更圓、更分散。這有許多常見的原因，並非診斷。"
          }
        }
      }
    },
