    "No site has two readings far enough apart yet. Measure again in a few weeks and this fills in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch hat keine Stelle zwei Messungen mit genug Abstand. Miss in ein paar Wochen erneut, dann füllt sich das hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningún punto tiene todavía dos mediciones suficientemente separadas. Vuelve a medir en unas semanas y esto se completará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun point n'a encore deux mesures suffisamment espacées. Mesurez à nouveau dans quelques semaines et ceci se remplira."
