    "Front, side and back, taken in a fixed frame so two months apart are actually comparable. They stay on this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorne, seitlich und hinten, in einem festen Rahmen aufgenommen, damit zwei Monate Abstand wirklich vergleichbar sind. Sie bleiben auf diesem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frente, perfil y espalda, tomadas en un marco fijo para que dos meses de diferencia sean realmente comparables. Se quedan en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face, profil et dos, pris dans un cadre fixe pour que deux mois d'écart soient réellement comparables. Elles restent sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fronte, profilo e schiena, scattate in un'inquadratura fissa perché due mesi di distanza siano davvero confrontabili. Restano su questo dispositivo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przód, bok i tył, robione w stałym kadrze, żeby dwa miesiące różnicy dało się naprawdę porównać. Zostają na tym urządzeniu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frente, perfil e costas, tiradas num enquadramento fixo para que dois meses de intervalo sejam realmente comparáveis. Ficam neste dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спереди, сбоку и сзади, снятые в фиксированной рамке, чтобы два месяца разницы были действительно сравнимы. Остаются на этом устройстве."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正面、侧面和背面，在固定取景框中拍摄，相隔两个月才真正可比。它们只保存在本设备上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正面、側面和背面，在固定取景框中拍攝，相隔兩個月才真正可比。它們只儲存在本裝置上。"
          }
        }
      }
    },
