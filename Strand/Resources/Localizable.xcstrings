    "Advanced. Avoid if pregnant, cardiovascular issues, or unwell. Not medical advice." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortgeschritten. Vermeiden bei Schwangerschaft, Herz-Kreislauf-Problemen oder Unwohlsein. Keine medizinische Beratung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advanced. Avoid if pregnant, cardiovascular issues, or unwell. Not medical advice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avanzado. Evítalo si estás embarazada, con problemas cardiovasculares o te sientes mal. No es consejo médico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avancé. À éviter en cas de grossesse, problèmes cardiovasculaires ou malaise. Pas un avis médical."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avanzato. Evita se in gravidanza, con problemi cardiovascolari o se ti senti male. Non è un consiglio medico."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaawansowane. Unikaj w ciąży, przy problemach sercowo-naczyniowych lub złym samopoczuciu. To nie porada medyczna."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avançado. Evita se estiveres grávida, com problemas cardiovasculares ou te sentires mal. Não é aconselhamento médico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продвинутый уровень. Избегайте при беременности, сердечно-сосудистых проблемах или недомогании. Не медицинский совет."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "进阶。孕期、心血管问题或不适时避免。非医疗建议。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "進階。孕期、心血管問題或不適時避免。非醫療建議。"
          }
        }
      }
    },
