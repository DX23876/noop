    "Use Bearer for most local servers; use x-api-key for gateways that require the key in that header." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende Bearer für die meisten lokalen Server; verwende x-api-key für Gateways, die den Schlüssel in diesem Header verlangen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Bearer for most local servers; use x-api-key for gateways that require the key in that header."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Bearer para la mayoría de los servidores locales; usa x-api-key para las pasarelas que requieren la clave en ese encabezado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez Bearer pour la plupart des serveurs locaux ; utilisez x-api-key pour les passerelles qui exigent la clé dans cet en-tête."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Bearer per la maggior parte dei server locali; usa x-api-key per i gateway che richiedono la chiave in quell'header."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj Bearera dla większości serwerów lokalnych; użyj klucza x-api dla bram, które wymagają klucza w tym nagłówku."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Bearer para a maioria dos servidores locais; usa x-api-key para gateways que exigem a chave nesse cabeçalho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте Bearer для большинства локальных серверов; используйте x-api-key для шлюзов, которым нужен ключ в этом заголовке."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大多数本地服务器使用 Bearer；对于要求在该标头中提供密钥的网关，请使用 x-api-key。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大多數本機伺服器使用 Bearer；對於要求在該標頭中提供金鑰的閘道，請使用 x-api-key。"
          }
        }
      }
    },
