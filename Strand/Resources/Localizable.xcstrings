        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE всей тренировки × длительность. Добавьте в деталях тренировки; пропущенные оценки не угадываются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整场 RPE × 时长。可在任意训练详情中添加；缺失评分绝不会被猜测。"
