    },
    "Apple's own sleep stages drive Rest directly. This is one of the watch's strengths.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apples eigene Schlafphasen fließen direkt in Ruhe ein. Das ist eine der Stärken der Uhr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fases de sueño de Apple alimentan Descanso directamente. Es uno de los puntos fuertes del reloj."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les stades de sommeil propres à Apple alimentent directement le Repos. C'est l'un des points forts de la montre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fasi del sonno di Apple guidano direttamente il riposo. È uno dei punti di forza dell'orologio."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As fases de sono da Apple alimentam diretamente o Descanso. Este é um dos pontos fortes do relógio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собственные стадии сна Apple напрямую формируют показатель «Отдых». Это одна из сильных сторон часов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 自己的睡眠分期直接驱动休息评分。这是手表的强项之一。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 自己的睡眠階段直接驅動休息分數。這是手錶的強項之一。"
          }
        }
      }
    },
    "Apple's sleep stages are strong, and they drive your Rest score directly.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apples Schlafphasen sind stark und fließen direkt in deinen Ruhewert ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fases de sueño de Apple son sólidas y alimentan tu puntuación de Descanso directamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les stades de sommeil d'Apple sont fiables et alimentent directement votre score de Repos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fasi del sonno di Apple sono affidabili e guidano direttamente il tuo punteggio di riposo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os estágios de sono da Apple são fortes e impulsionam diretamente a tua pontuação de descanso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стадии сна от Apple точны и напрямую формируют ваш показатель «Отдых»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 的睡眠分期很可靠，它们直接驱动你的休息评分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
