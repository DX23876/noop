    "Remove %@? NOOP will stop connecting to it. Its recorded data is kept and you can re-add it any time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ entfernen? NOOP verbindet sich dann nicht mehr damit. Die aufgezeichneten Daten bleiben, und du kannst es jederzeit wieder hinzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Eliminar %@? NOOP dejará de conectarse a este dispositivo. Sus datos grabados se conservan y puedes volver a añadirlo cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer %@ ? NOOP cessera de s'y connecter. Ses données enregistrées sont conservées et vous pouvez le rajouter à tout moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovere %@? NOOP smetterà di connettersi ad esso. I dati registrati vengono conservati e puoi riaggiungerlo in qualsiasi momento."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunąć %@? NOOP przestanie się z nim łączyć. Zapisane dane są zachowywane i w każdej chwili możesz je ponownie dodać."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remover %@? O NOOP irá parar de se ligar a ele. Os teus dados registados são mantidos e pode adicioná-los novamente a qualquer momento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалить %@? NOOP перестанет к нему подключаться. Записанные данные сохранятся, и вы сможете добавить его снова в любой момент."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除 %@？NOOP 将停止连接它。它已记录的数据会保留，你可以随时重新添加它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除 %@？NOOP 將停止連接它。它已記錄的資料會保留，你可以隨時重新新增它。"
          }
        }
      }
    },
    "Remove a question to tidy your list. Custom questions are deleted; the built-in ones are hidden and can be restored below." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entferne eine Frage, um deine Liste aufzuräumen. Eigene Fragen werden gelöscht; die eingebauten werden ausgeblendet und lassen sich unten wiederherstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina una pregunta para ordenar tu lista. Las preguntas personalizadas se borran; las integradas se ocultan y pueden restaurarse abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimez une question pour ranger votre liste. Les questions personnalisées sont supprimées ; les questions intégrées sont masquées et peuvent être restaurées ci-dessous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovi una domanda per riordinare la tua lista. Le domande personalizzate vengono eliminate; quelle integrate vengono nascoste e possono essere ripristinate qui sotto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuń pytanie, aby uporządkować swoją listę. Pytania niestandardowe zostały usunięte; wbudowane są ukryte i można je przywrócić poniżej."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remova uma pergunta para organizar a tua lista. As perguntas personalizadas são eliminadas; os integrados estão ocultos e podem ser restaurados abaixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалите вопрос, чтобы упорядочить список. Пользовательские вопросы удаляются полностью; встроенные скрываются, и их можно восстановить ниже."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除一个问题以整理你的列表。自定义问题会被删除；内置问题会被隐藏，可在下方恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除一個問題以整理你的列表。自訂問題會被刪除；內建問題會被隱藏，可在下方恢復。"
          }
        }
      }
    },
