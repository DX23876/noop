    "Strained: a signal flagged on %lld of %lld nights. Above 1.3 × usual this turns strength into overreaching." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angespannt: Ein Wert war in %lld von %lld Nächten auffällig. Über dem 1,3-Fachen des Üblichen wird Kraft dadurch „überlastend“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tensión: una señal dio aviso en %lld de %lld noches. Por encima de 1,3 × lo habitual, esto convierte la fuerza en sobrecarga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tendu : un signal a alerté sur %lld nuits sur %lld. Au-dessus de 1,3 × l'habituel, la force passe en surcharge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto sforzo: segnale anomalo in %lld notti su %lld. Oltre 1,3 × il solito, la forza passa a sovraccarico."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obciążenie: sygnał nieprawidłowy w %lld z %lld nocy. Powyżej 1,3 × zwykłego poziomu siła przechodzi w przeciążenie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em esforço: um sinal deu alerta em %lld de %lld noites. Acima de 1,3 × o habitual, a força passa a sobrecarga."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напряжение: отклонение в %lld из %lld ночей. Выше 1,3 × обычного это переводит силу в перегрузку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "紧张：%lld/%lld 晚有信号异常。负荷超过常规 1.3 倍时，力量状态将变为负荷过高。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "緊張：%lld/%lld 晚有訊號異常。負荷超過常規 1.3 倍時，力量狀態將變為負荷過高。"
          }
        }
      }
    },
