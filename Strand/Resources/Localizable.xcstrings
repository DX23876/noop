        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa en la semana de entrenamiento, el plan semanal, el mapa de constancia y las semanas activas de Fuerza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
