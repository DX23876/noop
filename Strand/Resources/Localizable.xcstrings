    "Well above your usual load. Fine for a short block, risky if it lasts." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deutlich über deiner üblichen Belastung. Für einen kurzen Block in Ordnung, riskant, wenn es anhält."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muy por encima de tu carga habitual. Bien para un bloque corto, arriesgado si se prolonga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nettement au-dessus de votre charge habituelle. Acceptable sur un court bloc, risqué si cela dure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ben sopra il tuo carico abituale. Va bene per un blocco breve, rischioso se dura."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyraźnie powyżej zwykłego obciążenia. W porządku na krótki blok, ryzykowne, jeśli trwa dłużej."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bem acima da tua carga habitual. Aceitável num bloco curto, arriscado se se prolongar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заметно выше обычной нагрузки. Нормально для короткого блока, рискованно, если затянется."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "负荷明显高于平时。短期训练块尚可，持续下去有风险。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "負荷明顯高於平時。短期訓練塊尚可，持續下去有風險。"
          }
        }
      }
    },
