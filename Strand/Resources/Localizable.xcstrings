    "No %@ recorded since you set this goal.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein %@ wurde aufgezeichnet, seit Sie dieses Ziel festgelegt haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No %@ recorded since you set this goal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha registrado ningún %@ desde que estableciste este objetivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun %@ enregistré depuis que vous avez défini cet objectif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun %@ registrato da quando hai impostato questo obiettivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum %@ foi registrado desde que você definiu essa meta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С тех пор, как вы установили эту цель, %@ не зарегистрировано."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自从您设定此目标以来，没有记录 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自從您設定此目標以來，沒有記錄 %@。"
          }
        }
      }
    },
    "No Charge banked today, so your band takes a careful middle course: %lld–%lld bpm.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute ist kein Charge-Wert erfasst, daher wählt dein Zielbereich einen vorsichtigen Mittelweg: %lld–%lld bpm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy no hay Charge registrado, así que tu zona toma un rumbo intermedio prudente: %lld–%lld ppm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun Charge enregistré aujourd'hui, donc votre zone adopte une voie médiane prudente : %lld–%lld bpm."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi non c'è un Charge registrato, quindi la tua fascia segue una via di mezzo prudente: %lld–%lld bpm."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem Carga bancária hoje, pelo que a tua banda segue um caminho intermédio cuidadoso: %lld–%lld bpm."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня заряд не накоплен, поэтому браслет выбирает осторожный средний вариант: %lld–%lld уд/мин."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天没有记录 Charge 值，因此你的目标区间采用稳妥的中间值：%lld–%lld bpm。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天沒有記錄 Charge 值，因此你的目標區間採用穩妥的中間值：%lld–%lld bpm。"
          }
        }
      }
    },
    "No Charge breakdown yet": {
      "localizations": {
