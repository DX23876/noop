    "Steps, heart rate, sleep, SpO₂ and stress, imported from Mi Fitness, read locally on %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schritte, Herzfrequenz, Schlaf, SpO₂ und Stress, importiert aus Mi Fitness, lokal auf %@ gelesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasos, frecuencia cardíaca, sueño, SpO₂ y estrés, importados de Mi Fitness, leídos localmente en %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas, fréquence cardiaque, sommeil, SpO₂ et stress, importés depuis Mi Fitness, lus localement sur %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passi, frequenza cardiaca, sonno, SpO₂ e stress, importati da Mi Fitness, letti in locale su %@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Passos, frequência cardíaca, sono, SpO₂ e stress, importados do Mi Fitness, lidos localmente em %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаги, пульс, сон, SpO₂ и стресс, импортированы из Mi Fitness, считаны локально на %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "步数、心率、睡眠、SpO₂ 和压力，从 Mi Fitness 导入，在 %@ 上本地读取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "步數、心率、睡眠、SpO₂ 和壓力，從 Mi Fitness 匯入，在 %@ 上本地讀取。"
          }
        }
      }
    },
    "Steps, heart, sleep, body composition and VO₂ max, read locally on %@.": {
