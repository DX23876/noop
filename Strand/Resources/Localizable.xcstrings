    "iOS decides when a background wake happens, so the brief may arrive later than this — or on your next open." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS entscheidet, wann es im Hintergrund aufweckt — die Zusammenfassung kann also später kommen oder erst beim nächsten Öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS decides when a background wake happens, so the brief may arrive later than this — or on your next open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS decide cuándo se produce una activación en segundo plano, así que el resumen puede llegar más tarde, o la próxima vez que abras la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS décide du moment d'un réveil en arrière-plan : le récapitulatif peut donc arriver plus tard, ou à ta prochaine ouverture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È iOS a decidere quando avviene un risveglio in background, quindi il riepilogo può arrivare più tardi — o alla prossima apertura."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To iOS decyduje, kiedy nastąpi wybudzenie w tle, więc podsumowanie może pojawić się później — albo przy następnym otwarciu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É o iOS que decide quando ocorre um despertar em segundo plano, por isso o resumo pode chegar mais tarde — ou na tua próxima abertura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS сам решает, когда разбудить приложение в фоне, поэтому сводка может прийти позже — или при следующем открытии."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "后台唤醒的时机由 iOS 决定，简报可能晚于此时间到达，或在你下次打开时出现。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景喚醒的時機由 iOS 決定，簡報可能晚於此時間送達，或在你下次開啟時出現。"
          }
        }
      }
    },
