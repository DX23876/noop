    "Your HRV dipped while you were still. Want a minute to breathe?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine HRV ist gesunken, während du still warst. Eine Minute zum Atmen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu VFC bajó mientras estabas en reposo. ¿Quieres un minuto para respirar?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre VFC a baissé pendant que vous étiez immobile. Une minute pour respirer ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo HRV è calato mentre eri fermo, vuoi un minuto per respirare?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój HRV spadł, gdy byłeś nieruchomy. Chcesz chwilę odetchnąć?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O teu HRV caiu enquanto estavas parado. Queres um minuto para respirar?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша ВСР снизилась, пока вы были неподвижны. Хотите минуту подышать?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
