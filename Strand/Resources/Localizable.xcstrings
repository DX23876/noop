    "There is no undo, and no archive. The coach starts again from nothing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt kein Zurück und kein Archiv. Der Coach fängt wieder bei null an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is no undo, and no archive. The coach starts again from nothing."
          }
        },
        "es" : {
