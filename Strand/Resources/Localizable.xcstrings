          }
        }
      }
    },
    "Wear it snug on your wrist or bicep, sensor against skin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trag ihn eng am Handgelenk oder Bizeps, Sensor auf der Haut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llévala ajustada en la muñeca o el bíceps, con el sensor contra la piel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Portez-le bien ajusté au poignet ou au biceps, capteur contre la peau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indossala aderente al polso o al bicipite, con il sensore a contatto con la pelle."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
