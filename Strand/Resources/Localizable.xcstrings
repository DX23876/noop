    "You already have %lld active goals — set one aside or close one out before adding another." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast bereits %lld aktive Ziele — lege eines beiseite oder schließe eines ab, bevor du ein weiteres hinzufügst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You already have %lld active goals — set one aside or close one out before adding another."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya tienes %lld objetivos activos — aparta uno o cierra uno antes de añadir otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as déjà %lld objectifs actifs — mets-en un de côté ou clôtures-en un avant d'en ajouter un autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai già %lld obiettivi attivi: mettine da parte uno o chiudine uno prima di aggiungerne un altro."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masz już aktywne cele: %lld — odłóż jeden na bok albo zamknij, zanim dodasz kolejny."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você já tem %lld metas ativas – reserve uma ou feche uma antes de adicionar outra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У вас уже есть %lld активных целей — отложите одну или закройте одну, прежде чем добавлять другую."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您已经有 %lld 个活跃目标 - 在添加另一个目标之前先搁置一个目标或关闭一个目标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您已經有 %lld 個活躍目標 - 在新增另一個目標之前先擱置一個目標或關閉一個目標。"
          }
        }
      }
    },
    "You already have an active %@ goal — continuing will offer to replace it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast bereits ein aktives %@-Ziel — wenn du fortfährst, kannst du es ersetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You already have an active %@ goal — continuing will offer to replace it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya tienes un objetivo de %@ activo — si continúas, podrás reemplazarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as déjà un objectif de %@ actif — en continuant, tu pourras le remplacer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai già un obiettivo %@ attivo: continuando ti verrà proposta la possibilità di sostituirlo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masz już aktywny cel %@ — kontynuowanie zaproponuje jego zastąpienie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você já tem uma meta %@ ativa – ao continuar, você se oferecerá para substituí-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У вас уже есть активная цель %@ — при продолжении будет предложено заменить ее."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您已经有一个活跃的 %@ 目标 - 继续将取代它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您已經有一個活躍的 %@ 目標 - 繼續將取代它。"
          }
        }
      }
    },
    "You already have an active %@ goal. Replacing it closes that one out — its story stays in your history." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast bereits ein aktives %@-Ziel. Es zu ersetzen schließt dieses ab — seine Geschichte bleibt in deiner Historie erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You already have an active %@ goal. Replacing it closes that one out — its story stays in your history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya tienes un objetivo de %@ activo. Reemplazarlo lo cierra — su historia se conserva en tu historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as déjà un objectif de %@ actif. Le remplacer le clôture — son histoire reste dans ton historique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai già un obiettivo %@ attivo. Sostituirlo lo chiude: la sua storia rimane nella tua storia."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masz już aktywny cel %@. Zastąpienie zamyka tamten — jego historia pozostaje w Twoich zapisach."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você já tem uma meta %@ ativa. Substituí-lo encerra essa questão – sua história permanece na sua história."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У вас уже есть активная цель %@. Замена его закроет эту проблему — ее история останется в вашей истории."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您已经有一个有效的 %@ 目标。更换它就结束了那个——它的故事留在你的历史中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您已經有一個有效的 %@ 目標。更換它就結束了那個——它的故事留在你的歷史中。"
          }
        }
      }
    },
    "You are %@ short against your own need this week." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist heute %@ weniger aktiv als nötig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás %@ por debajo de tus necesidades semanales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes %@ en dessous de votre besoin personnel cette semaine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei %@ sotto la tua necessità settimanale."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jesteś %@ mniej niż potrzebujesz tego tygodnia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está %@ abaixo da sua necessidade pessoal esta semana."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы находитесь на недостатке %@ по сравнению с вашим потреблением этой недели."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您本周相对于自身需求处于%@缺口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您此週與自身需求相比，%@ 處於不足狀態。"
          }
        }
      }
    },
    "You are holding your level. To build, raise the load in small steps." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hältst dein Niveau. Für Aufbau steigere die Belastung in kleinen Schritten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantienes tu nivel. Para progresar, sube la carga poco a poco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous maintenez votre niveau. Pour progresser, augmentez la charge par petites étapes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stai mantenendo il tuo livello. Per progredire, aumenta il carico a piccoli passi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utrzymujesz swój poziom. Aby się rozwijać, zwiększaj obciążenie małymi krokami."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás a manter o teu nível. Para progredir, aumenta a carga aos poucos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы удерживаете свой уровень. Чтобы расти, повышайте нагрузку небольшими шагами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在维持现有水平。想要提升，就小步增加负荷。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在維持現有水準。想要提升，就小步增加負荷。"
          }
        }
      }
    },
    "You bring your own API key. The provider — right now %@ — is who actually receives your data, so it's the real privacy choice: pick one you trust, and check how they handle it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bringst deinen eigenen API-Schlüssel mit. Der Anbieter — aktuell %@ — ist derjenige, der deine Daten tatsächlich erhält, also ist er die eigentliche Datenschutz-Entscheidung: Wähle einen, dem du vertraust, und prüfe, wie er damit umgeht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You bring your own API key. The provider — right now %@ — is who actually receives your data, so it's the real privacy choice: pick one you trust, and check how they handle it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tú aportas tu propia clave de API. El proveedor — ahora mismo %@ — es quien realmente recibe tus datos, así que es la verdadera decisión de privacidad: elige uno en el que confíes y comprueba cómo los gestiona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu apportes ta propre clé d'API. Le fournisseur — actuellement %@ — est celui qui reçoit réellement tes données, c'est donc le vrai choix de confidentialité : choisis-en un de confiance et vérifie comment il les traite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porta la tua chiave API. Il fornitore, in questo momento %@, è chi riceve effettivamente i tuoi dati, quindi è la vera scelta in materia di privacy: scegline uno di cui ti fidi e controlla come li gestiscono."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przynosisz własny klucz API. To dostawca — obecnie %@ — faktycznie otrzymuje Twoje dane, więc to on jest prawdziwym wyborem dotyczącym prywatności: wybierz takiego, któremu ufasz, i sprawdź, jak postępuje z danymi."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você traz sua própria chave API. O provedor – agora %@ – é quem realmente recebe seus dados, então é a verdadeira escolha de privacidade: escolha um em que você confia e verifique como eles lidam com isso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы приносите с собой собственный ключ API. Поставщик — прямо сейчас %@ — это тот, кто на самом деле получает ваши данные, так что это реальный выбор конфиденциальности: выберите того, кому вы доверяете, и проверьте, как он с ними обращается."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您携带自己的 API 密钥。提供商（现在是 %@）是实际接收您数据的人，因此这是真正的隐私选择：选择您信任的提供商，并检查他们如何处理数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您攜帶自己的 API 密鑰。提供者（現在是 %@）是實際接收您資料的人，因此這是真正的隱私選擇：選擇您信任的供應商，並檢查他們如何處理資料。"
          }
        }
      }
    },
    "You can also reach it in Settings under Dashboard style." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst es auch unter Einstellungen → Dashboard-Stil finden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También puedes acceder a ello en Configuración, bajo Estilo de tablero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez également accéder à cela dans les paramètres sous le style du tableau de bord."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi trovare anche questa opzione nelle Impostazioni, nella sezione Stile dashboard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz również dostosować ustawienia w zakładce Styl interfejsu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você também pode acessá-lo nas Configurações, na seção Estilo do Painel."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете настроить это в разделе «Настройки» под «Стиль панели»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您也可以在设置中的仪表盘样式下找到。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您也可以在設定中的儀表板風格選項下找到。"
          }
        }
      }
    },
    "You can change what you share any time in Settings › Health › Data Access & Devices." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst jederzeit unter Einstellungen › Health › Datenzugriff & Geräte ändern, was du teilst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes cambiar lo que compartes en cualquier momento en Ajustes › Salud › Acceso a datos y dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez modifier ce que vous partagez à tout moment dans Paramètres › Santé › Accès aux données et appareils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi cambiare ciò che condividi in qualsiasi momento in Impostazioni › Salute › Accesso ai dati e dispositivi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W dowolnym momencie możesz zmienić to, co udostępniasz, wybierając Ustawienia > Zdrowie > Dostęp do danych i urządzenia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode alterar o que partilha a qualquer momento em Definições › Saúde › Acesso a dados e dispositivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете изменить, чем делитесь, в любое время в разделе Настройки › Здоровье › Доступ к данным и устройства."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以随时在「设置 › 健康 › 数据访问与设备」中更改你分享的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以隨時在「設定 › 健康 › 資料存取與裝置」中更改你分享的內容。"
          }
        }
      }
    },
    "You can still bring your data in by importing a Health export from Data Sources. A build from the App Store, or one signed with a paid Apple Developer account, connects directly." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst deine Daten trotzdem hereinbringen, indem du unter „Datenquellen“ einen Health-Export importierst. Ein Build aus dem App Store oder mit bezahltem Apple-Developer-Konto signiert verbindet sich direkt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aun así puedes traer tus datos importando una exportación de Salud desde Fuentes de datos. Una versión del App Store, o una firmada con una cuenta de pago de Apple Developer, se conecta directamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez tout de même récupérer vos données en important un export Santé depuis Sources de données. Une version de l'App Store, ou une version signée avec un compte Apple Developer payant, se connecte directement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi comunque importare i tuoi dati importando un'esportazione di Salute dalle Sorgenti dati. Una versione dall'App Store, o una firmata con un account Apple Developer a pagamento, si connette direttamente."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadal możesz przenieść swoje dane, importując eksport stanu zdrowia ze źródeł danych. Kompilacja z App Store lub podpisana za pomocą płatnego konta Apple Developer łączy się bezpośrednio."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode ainda trazer os teus dados importando uma exportação de Saúde de fontes de dados. Uma versão da App Store ou assinada com uma conta paga de programador da Apple liga-se diretamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы всё равно можете перенести данные, импортировав экспорт «Здоровья» из раздела «Источники данных». Сборка из App Store или подписанная платным аккаунтом Apple Developer подключается напрямую."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你仍然可以通过在「数据来源」中导入一个健康导出文件来引入你的数据。从 App Store 安装的版本，或用付费 Apple 开发者账户签名的版本，可直接连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你仍然可以透過在「資料來源」中匯入一個健康匯出檔案來引入你的資料。從 App Store 安裝的版本，或用付費 Apple 開發者帳戶簽名的版本，可直接連接。"
          }
        }
      }
    },
    "You disconnected, but your key is still saved locally — reconnect without re-entering it, or pick a different provider below." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast die Verbindung getrennt, aber dein Schlüssel ist weiterhin lokal gespeichert — verbinde dich erneut, ohne ihn neu einzugeben, oder wähle unten einen anderen Anbieter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You disconnected, but your key is still saved locally — reconnect without re-entering it, or pick a different provider below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te desconectaste, pero tu clave sigue guardada localmente: vuelve a conectar sin volver a introducirla, o elige otro proveedor abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous vous êtes déconnecté, mais votre clé est toujours enregistrée localement — reconnectez-vous sans la ressaisir, ou choisissez un autre fournisseur ci-dessous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti sei disconnesso, ma la tua chiave è ancora salvata localmente: riconnettiti senza reinserirla o scegli un provider diverso di seguito."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozłączyłeś się, ale klucz nadal jest zapisany lokalnie — połącz ponownie bez wpisywania go albo wybierz poniżej innego dostawcę."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você se desconectou, mas sua chave ainda está salva localmente. Reconecte-se sem digitá-la novamente ou escolha um provedor diferente abaixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы отключились, но ваш ключ по-прежнему сохраняется локально — подключитесь повторно, не вводя его повторно, или выберите другого провайдера ниже."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您已断开连接，但您的密钥仍保存在本地 - 无需重新输入即可重新连接，或者在下面选择其他提供商。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您已斷開連接，但您的金鑰仍保存在本地 - 無需重新輸入即可重新連接，或在下方選擇其他提供者。"
          }
        }
      }
    },
    "You have been training well below your usual level. If this is not a planned break, restart with a few easy sessions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du trainierst deutlich unter deinem üblichen Niveau. Wenn das keine geplante Pause ist, steig mit ein paar leichten Einheiten wieder ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llevas un tiempo entrenando muy por debajo de tu nivel habitual. Si no es una pausa planificada, vuelve con unas sesiones suaves."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous vous entraînez nettement sous votre niveau habituel. Si ce n'est pas une pause prévue, reprenez avec quelques séances faciles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti stai allenando ben al di sotto del tuo livello abituale. Se non è una pausa pianificata, riparti con qualche sessione leggera."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trenujesz wyraźnie poniżej zwykłego poziomu. Jeśli to nie planowana przerwa, wróć od kilku lekkich treningów."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tens treinado bem abaixo do teu nível habitual. Se não é uma pausa planeada, recomeça com algumas sessões leves."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы тренируетесь заметно ниже обычного уровня. Если это не запланированный перерыв, начните снова с нескольких лёгких тренировок."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的训练明显低于常规水平。如果不是计划中的休息，先从几次轻松训练重新开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的訓練明顯低於常規水準。如果不是計畫中的休息，先從幾次輕鬆訓練重新開始。"
          }
        }
      }
    },
    "You have the maximum of %lld active goals. Set one aside or close one out to add another." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast das Maximum von %lld aktiven Zielen erreicht. Lege eines beiseite oder schließe eines ab, um ein weiteres hinzuzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have the maximum of %lld active goals. Set one aside or close one out to add another."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has alcanzado el máximo de %lld objetivos activos. Aparta uno o cierra uno para añadir otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as atteint le maximum de %lld objectifs actifs. Mets-en un de côté ou clôtures-en un pour en ajouter un autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai il massimo di %lld obiettivi attivi. Mettine uno da parte o chiudine uno per aggiungerne un altro."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masz maksymalną liczbę aktywnych celów: %lld. Odłóż jeden na bok albo zamknij, by dodać kolejny."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você tem no máximo %lld metas ativas. Deixe um de lado ou feche um para adicionar outro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У вас есть максимум %lld активных целей. Отложите один или закройте один, чтобы добавить другой."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您最多有 %lld 个活跃目标。将其中一项放在一边或关闭一项以添加另一项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您最多有 %lld 個活躍目標。將其中一項放在一邊或關閉一項以添加另一項。"
          }
        }
      }
    },
    "You held the band. Right where today wanted you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast den Zielbereich gehalten. Genau da, wo dich der heutige Tag haben wollte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantuviste la zona. Justo donde el día de hoy te quería."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez tenu la zone. Exactement là où la journée vous voulait."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai mantenuto la fascia. Esattamente dove oggi voleva che tu fossi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trzymałeś zespół. Dokładnie tam, gdzie dzisiaj cię chciałem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiveste-te na zona. Exatamente onde o dia pedia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы удержались в целевом диапазоне — именно там, где сегодня и было нужно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你稳稳保持在目标区间内。正是今天所需要的状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你穩穩保持在目標區間內。正是今天所需要的狀態。"
          }
        }
      }
    },
    "You logged feeling unwell, and your signals agree. Take it easy today. On-device estimate, not a diagnosis." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast angegeben, dass du dich unwohl fühlst, und deine Signale passen dazu. Geh es heute ruhig an. Schätzung auf dem Gerät, keine Diagnose."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You logged feeling unwell, and your signals agree. Take it easy today. On-device estimate, not a diagnosis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has registrado que no te encuentras bien y tus señales coinciden. Tómatelo con calma hoy. Estimación en el dispositivo, no es un diagnóstico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez indiqué ne pas vous sentir bien et vos signaux concordent. Levez le pied aujourd’hui. Estimation sur l’appareil, pas un diagnostic."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai registrato di non sentirti bene e i tuoi segnali lo confermano. Riposati oggi. Stima sul dispositivo, non è una diagnosi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zarejestrowano złe samopoczucie, a sygnały organizmu to potwierdzają. Dziś zwolnij tempo. Ocena na urządzeniu, nie diagnoza."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registaste que não te sentes bem e os teus sinais estão de acordo. Tem calma hoje. Estimativa no dispositivo, não é um diagnóstico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы отметили плохое самочувствие, и показатели это подтверждают. Сегодня снизьте нагрузку. Оценка на устройстве, не диагноз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你记录了身体不适，相关信号也与之吻合。今天请放松休息。设备端估算，不是诊断。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你記錄了身體不適，相關訊號也與之吻合。今天請放鬆休息。裝置端估算，不是診斷。"
          }
        }
      }
    },
