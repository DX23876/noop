    "Basal, active and total burn, not just the total." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grundumsatz, Aktivkalorien und Gesamtverbrauch – nicht nur die Summe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quema basal, activa y total, no solo la total."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combustion basale, active et totale, pas seulement la totale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caloria bruciata basale, attiva e totale, non solo quella totale."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podstawowa, aktywna i całkowita spalona, a nie tylko całkowita."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queima basal, ativa e total, não apenas a total."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Базовая, активная и общая выработка, а не только общая."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基础、活动和总消耗，不仅仅是总消耗。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
