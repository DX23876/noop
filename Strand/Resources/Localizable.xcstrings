    },
    "You'll be reminded around %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wirst gegen %@ erinnert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se te recordará alrededor de las %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous serez averti vers %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riceverai un promemoria intorno alle %@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Será lembrado por volta de %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вам напомнят примерно в %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你会在 %@ 左右收到提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你會在 %@ 左右收到提醒。"
          }
        }
      }
    },
    "You'll likely wake around %lld ± %lld Charge if you sleep about %@ tonight.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wachst voraussichtlich mit etwa %1$lld ± %2$lld Ladung auf, wenn du heute Nacht ungefähr %3$@ schläfst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "You'll likely wake around %1$lld ± %2$lld Charge if you sleep about %3$@ tonight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Probablemente despertarás con alrededor de %lld ± %lld de Carga si duermes unas %@ esta noche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous vous réveillerez probablement autour de %1$lld ± %2$lld de charge si vous dormez environ %3$@ cette nuit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Probabilmente ti sveglierai intorno a %1$lld ± %2$lld di carica se dormi circa %3$@ stanotte."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Provavelmente acordará por volta das %1$lld ± %2$lld Carga se dormir por volta das %3$@ esta noite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы, вероятно, проснётесь с Зарядом около %1$lld ± %2$lld, если поспите сегодня примерно %3$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你今晚睡大约 %3$@，你醒来时的能量可能在 %1$lld ± %2$lld 左右。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你今晚睡大約 %3$@，你醒來時的能量可能在 %1$lld ± %2$lld 左右。"
          }
        }
      }
    },
    "You'll need to paste it again to reconnect. This is different from Disconnect, which keeps the key.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du musst ihn zum erneuten Verbinden wieder einfügen. Das ist etwas anderes als „Trennen“, wobei der Schlüssel erhalten bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll need to paste it again to reconnect. This is different from Disconnect, which keeps the key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendrás que pegarla de nuevo para reconectar. Esto es diferente de Desconectar, que conserva la clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous devrez la coller à nouveau pour vous reconnecter. C'est différent de Déconnecter, qui conserve la clé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovrai incollarlo di nuovo per riconnetterti. Questo è diverso da Disconnect, che mantiene la chiave."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Você precisará colá-lo novamente para reconectar. Isso é diferente de Disconnect, que mantém a chave."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для повторного подключения вам придется вставить его еще раз. Это отличается от Disconnect, который сохраняет ключ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您需要再次粘贴它才能重新连接。这与 Disconnect 不同，Disconnect 保留密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您需要再次貼上它才能重新連接。這與 Disconnect 不同，Disconnect 保留密鑰。"
          }
        }
      }
    },
    "You're %lld%% of the way from your starting point to your target, with %lld%% of the time gone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie sind %lld%% of auf dem Weg von Ihrem Ausgangspunkt zu Ihrem Ziel, wobei %lld%% of die Zeit vergangen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "You're %1$lld%% of the way from your starting point to your target, with %2$lld%% of the time gone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás %lld%% of el camino desde tu punto de partida hasta tu objetivo, con %lld%% of el tiempo transcurrido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez %lld%% of chemin depuis votre point de départ jusqu'à votre objectif, avec %lld%% of temps écoulé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei al %lld%% of percorso dal punto di partenza al tuo obiettivo, con il %lld%% of tempo trascorso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está %lld%% odo caminho desde seu ponto de partida até seu destino, com %lld%% of o tempo passou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы прошли %lld%% o пути от начальной точки до цели, а времени осталось %lld%% of."
          }
        },
        "zh-Hans": {
          "stringUnit": {
