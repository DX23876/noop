          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt Persona, Stimme, Emoji, proaktive Nachrichten und Antwortlänge zusammen fest – passen Sie sie anschließend unten an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sets persona, voice, emoji, proactive messages, and reply length together — tweak any of them below afterward."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Establece la personalidad, la voz, los emoji, los mensajes proactivos y la duración de la respuesta juntos; modifica cualquiera de ellos a continuación después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définit ensemble le personnage, la voix, les emoji, les messages proactifs et la longueur des réponses – modifiez-les ci-dessous par la suite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta insieme persona, voce, emoji, messaggi proattivi e lunghezza della risposta: successivamente modificane uno qualsiasi di seguito."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawia naraz osobowość, ton, emoji, wiadomości z inicjatywy trenera i długość odpowiedzi — każde z nich dostroisz poniżej."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define persona, voz, emoji, mensagens proativas e duração da resposta – ajuste qualquer um deles abaixo depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устанавливает вместе личность, голос, смайлы, упреждающие сообщения и длину ответа — впоследствии настройте любой из них ниже."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将角色、语音、表情符号、主动消息和回复长度设置在一起 - 然后调整下面的任何一个。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將角色、語音、表情符號、主動訊息和回應長度設定在一起 - 然後調整下面的任何一個。"
          }
        }
      }
    },
