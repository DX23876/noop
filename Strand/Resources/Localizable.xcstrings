    "Darker squares mean more time logged. Empty days are rest or no workout." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dunklere Felder bedeuten mehr protokollierte Zeit. Leere Tage sind Ruhetage oder Tage ohne Training."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darker squares mean more time logged. Empty days are rest or no workout."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cuadros más oscuros indican más tiempo registrado. Los días vacíos son de descanso o sin entrenamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des carrés plus sombres signifient plus de temps enregistré. Les jours vides sont du repos ou pas d’entraînement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I quadrati più scuri indicano più tempo registrato. I giorni vuoti sono riposo o assenza di allenamento."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciemniejsze kwadraty oznaczają dłuższy czas rejestracji. Puste dni to odpoczynek lub brak treningu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quadrados mais escuros significam mais tempo registado. Dias vazios são descanso ou nenhum treino."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Более темные квадраты означают большее время регистрации. Пустые дни — это отдых или отсутствие тренировок."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "较暗的方块意味着记录的时间更多。空虚的日子就是休息或不锻炼。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "較暗的方塊意味著記錄的時間更多。空虛的日子就是休息或不運動。"
          }
        }
      }
    },
