    "Buteyko-style reduced breathing: small nasal inhale (~2.5s), relaxed nasal exhale (~3.5s), short comfortable hold (~3.5s). Keep it quiet and light — not a big gasp." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buteyko-ähnliche reduzierte Atmung: kleiner Naseneinatem (~2,5 s), entspannter Nasenausatem (~3,5 s), kurzes angenehmes Halten (~3,5 s). Ruhig und leicht — kein großer Schnappatem."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buteyko-style reduced breathing: small nasal inhale (~2.5s), relaxed nasal exhale (~3.5s), short comfortable hold (~3.5s). Keep it quiet and light — not a big gasp."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiración reducida estilo Buteyko: inhalación nasal pequeña (~2,5 s), exhalación nasal relajada (~3,5 s), retención corta y cómoda (~3,5 s). Quieto y ligero — no un gran bocanada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiration réduite style Buteyko : petite inspiration nasale (~2,5 s), expiration nasale détendue (~3,5 s), courte rétention confortable (~3,5 s). Calme et léger — pas une grosse bouffée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiro ridotto stile Buteyko: piccola inspirazione nasale (~2,5 s), espirazione nasale rilassata (~3,5 s), breve trattenuta comoda (~3,5 s). Calmo e leggero — non un grosso respiro."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zredukowane oddychanie w stylu Buteyko: mały wdech nosem (~2,5 s), rozluźniony wydech nosem (~3,5 s), krótkie wygodne wstrzymanie (~3,5 s). Cicho i lekko — nie wielki haust."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiração reduzida estilo Buteyko: inspiração nasal pequena (~2,5 s), expiração nasal relaxada (~3,5 s), retenção curta e confortável (~3,5 s). Quieto e leve — não uma grande golfada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сниженное дыхание в стиле Бутейко: небольшой носовой вдох (~2,5 с), расслабленный носовой выдох (~3,5 с), короткая комфортная задержка (~3,5 с). Тихо и легко — без большого вдоха."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buteyko 式减量呼吸：小鼻吸（约 2.5 秒）、放松鼻呼（约 3.5 秒）、短而舒适的屏息（约 3.5 秒）。安静轻柔——不要大口喘气。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buteyko 式減量呼吸：小鼻吸（約 2.5 秒）、放鬆鼻呼（約 3.5 秒）、短而舒適的屏息（約 3.5 秒）。安靜輕柔——不要大口喘氣。"
          }
        }
      }
    },
