    "Media ownership and redistribution rights are disputed. NOOP does not grant any licence for these files." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eigentum und Weiterverbreitungsrechte an den Medien sind umstritten. NOOP erteilt für diese Dateien keine Lizenz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La propiedad y los derechos de redistribución del contenido están en disputa. NOOP no concede ninguna licencia sobre estos archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La propriété et les droits de redistribution des médias sont contestés. NOOP n'accorde aucune licence sur ces fichiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La proprietà e i diritti di ridistribuzione dei contenuti sono controversi. NOOP non concede alcuna licenza su questi file."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Własność i prawa do rozpowszechniania multimediów są sporne. NOOP nie udziela żadnej licencji na te pliki."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A propriedade e os direitos de redistribuição da multimédia são contestados. A NOOP não concede qualquer licença sobre estes ficheiros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Права собственности и распространения на медиа оспариваются. NOOP не предоставляет лицензию на эти файлы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些媒体的所有权和再分发权存在争议。NOOP 不为这些文件授予任何许可。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些媒體的所有權和再散布權存在爭議。NOOP 不為這些檔案授予任何授權。"
          }
        }
      }
    },
    "Media stays with its provider and is opened only when you request it. It is not copied into workout history." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medien bleiben beim Anbieter und werden nur geöffnet, wenn du sie anforderst. Sie werden nicht in den Trainingsverlauf kopiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Media stays with its provider and is opened only when you request it. It is not copied into workout history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contenido multimedia permanece con su proveedor y solo se abre cuando lo solicitas. No se copia al historial de entrenamientos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les médias restent chez leur fournisseur et ne sont ouverts que lorsque vous le demandez. Ils ne sont pas copiés dans l'historique des entraînements."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I contenuti multimediali restano presso il fornitore e vengono aperti solo su richiesta. Non vengono copiati nella cronologia degli allenamenti."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Materiały pozostają u dostawcy i są otwierane tylko na Twoje żądanie. Nie są kopiowane do historii treningów."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os conteúdos multimédia permanecem no fornecedor e só são abertos quando solicitados. Não são copiados para o histórico de treinos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Медиа остаются у поставщика и открываются только по вашему запросу. Они не копируются в историю тренировок."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "媒体内容保留在提供方，仅在你主动请求时打开，不会复制到训练历史中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "媒體內容保留在提供者端，僅在你主動要求時開啟，不會複製到訓練歷史中。"
          }
        }
      }
    },
