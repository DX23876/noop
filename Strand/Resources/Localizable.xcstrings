    "Face away, arms relaxed. Same distance and same stance as the front shot." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem Rücken zur Kamera, Arme locker. Gleicher Abstand und gleicher Stand wie bei der Vorderansicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De espaldas, brazos relajados. Misma distancia y misma postura que en la toma frontal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De dos, bras relâchés. Même distance et même position que pour la vue de face."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di spalle, braccia rilassate. Stessa distanza e stessa posizione dello scatto frontale."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyłem, ramiona rozluźnione. Ta sama odległość i postawa co przy zdjęciu z przodu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De costas, braços relaxados. Mesma distância e mesma posição da fotografia de frente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спиной, руки расслаблены. То же расстояние и та же стойка, что и на фото спереди."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背对镜头，手臂放松。与正面照保持相同距离和站姿。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背對鏡頭，手臂放鬆。與正面照保持相同距離和站姿。"
          }
        }
      }
    },
    "Face the camera square on, arms relaxed at your sides, feet at shoulder width." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frontal zur Kamera, Arme locker seitlich, Füße schulterbreit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De frente a la cámara, brazos relajados a los lados, pies a la anchura de los hombros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face à l'appareil, bras relâchés le long du corps, pieds à largeur d'épaules."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di fronte alla fotocamera, braccia rilassate lungo i fianchi, piedi alla larghezza delle spalle."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przodem do aparatu, ramiona swobodnie wzdłuż ciała, stopy na szerokość barków."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De frente para a câmara, braços relaxados ao lado do corpo, pés à largura dos ombros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лицом к камере, руки свободно вдоль тела, ступни на ширине плеч."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正对镜头，手臂自然垂于体侧，双脚与肩同宽。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正對鏡頭，手臂自然垂於體側，雙腳與肩同寬。"
          }
        }
      }
    },
