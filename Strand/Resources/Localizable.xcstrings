    "Taking a break. Training suggestions are paused until you're active again.": {
      "comment": "Basiskarte fixed statement, ActivityStatus.onBreak",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewusste Pause. Trainingsvorschläge sind pausiert, bis du wieder aktiv bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taking a break. Training suggestions are paused until you're active again."
