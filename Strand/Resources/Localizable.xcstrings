    "Cheaper models for background jobs — leave blank to use %@'s small model. Keeps the pricey coaching model for the actual conversation." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günstigere Modelle für Hintergrundaufgaben — leer lassen, um das kleine Modell von %@ zu nutzen. So bleibt das teure Coaching-Modell dem eigentlichen Gespräch vorbehalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cheaper models for background jobs — leave blank to use %@'s small model. Keeps the pricey coaching model for the actual conversation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelos más económicos para tareas en segundo plano: déjalo en blanco para usar el modelo pequeño de %@. Reserva el costoso modelo de coaching para la conversación real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modèles moins chers pour les tâches d'arrière-plan — laissez vide pour utiliser le petit modèle de %@. Réserve le coûteux modèle de coaching à la conversation elle-même."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelli più economici per lavori in background: lascia vuoto per utilizzare il modello piccolo di %@. Mantiene il costoso modello di coaching per la conversazione vera e propria."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tańsze modele do zadań w tle — zostaw puste, by użyć małego modelu %@. Kosztowny model trenerski zostaje zarezerwowany dla właściwej rozmowy."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelos mais baratos para trabalhos em segundo plano — deixe em branco para usar o modelo pequeno de %@. Mantém o modelo de coaching caro para a conversa real."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Более дешевые модели для фоновых заданий — оставьте поле пустым, чтобы использовать маленькую модель %@. Сохраняет дорогостоящую модель коучинга для реального разговора."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于后台作业的更便宜的模型 - 留空以使用 %@ 的小模型。为实际对话保留昂贵的辅导模型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於後台作業的更便宜的模型 - 留空以使用 %@ 的小模型。為實際對話保留昂貴的輔導模型。"
          }
        }
      }
    },
