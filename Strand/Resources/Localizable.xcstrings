    "Replaces the Today tab with the prototype redesign. Turn it off any time to return to the classic dashboard. Reads the same live data from your strap." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ersetzt die Registerkarte Heute durch das Prototyp-Redesign. Schalte es jederzeit aus, um zum klassischen Dashboard zurückzukehren. Lies die gleichen live-daten von deinem strap."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reemplaza la pestaña Hoy con el prototipo de rediseño. Apágalo en cualquier momento para volver al panel clásico. Lea los mismos datos en vivo de su correa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplace l'onglet Aujourd'hui par la refonte du prototype. Éteignez-le à tout moment pour revenir au tableau de bord classique. Lis les mêmes données en direct de votre sangle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimpiazza la scheda Oggi con il design prototipo. Spegni sempre per tornare al pannello classico. Leggi i dati in tempo reale dallo stesso cinturino."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zastępuje zakładkę Dzisiaj przeprojektowanym prototypem. Wyłącz tę opcję w dowolnym momencie, aby powrócić do klasycznego pulpitu nawigacyjnego. Odczytuje te same dane w czasie rzeczywistym z Twojego paska."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substitui o separador Hoje pelo redesenho do protótipo. Desligue-o a qualquer momento para voltar ao painel clássico. Lê os mesmos dados em direto da tua bracelete."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заменит вкладку «Сегодня» новой прототипической дизайном. В любой момент можно отключить — вернуться к классическому диспетчеру. Данные от датчика всегда доступны."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "替换为今日标签的原型设计。随时关闭以返回经典仪表盘。从您的手环读取相同实时数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取代「今天」視窗，採用原型設計。隨時關閉以恢復經典儀表板。從您的錶帶讀取相同即時數據。"
          }
        }
      }
    },
    "Replaces the Today tab's layout. Switch back any time — every style reads the same live data from your strap." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ersetzt die Layout-Ansicht der heutigen Schaltfläche. Wechseln kannst du jederzeit — jeder Stil zeigt die gleichen Live-Daten von deinem Gürtel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia la vista de la pestaña de hoy. Cambia de vuelta en cualquier momento — cada estilo muestra los datos en vivo de tu correa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplace l’affichage de la barre du jour. Réinitialiser à tout moment — chaque style affiche les données en temps réel de votre montre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimpiazza il layout della scheda Oggi. Cambia scheda in qualsiasi momento — ogni stile legge i dati in tempo reale dallo stesso cinturino."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamienia układ zakładki „Dzisiaj”. Możesz wrócić do poprzedniego wyglądu – każdy styl wyświetla dane na żywo z pasa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substitui a disposição da aba Hoje. Alterne sempre que quiser — cada estilo lê os dados ao vivo da sua alça."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заменит дизайн вкладки «Сегодня». Можно вернуться в любой момент — все стили отображают данные от датчика одинаково."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "替换为今日标签的布局。随时切换——所有样式均从您的手环读取相同实时数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取代「今天」視窗的佈局。隨時切換回——所有風格均從您的錶帶讀取相同即時數據。"
          }
        }
      }
