    "Midway between hip crease and knee, weight evenly on both feet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mittig zwischen Hüftbeuge und Knie, Gewicht gleichmäßig auf beiden Füßen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A media distancia entre el pliegue de la cadera y la rodilla, peso repartido en ambos pies."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À mi-distance entre le pli de la hanche et le genou, poids réparti sur les deux pieds."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A metà tra la piega dell'anca e il ginocchio, peso ripartito su entrambi i piedi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W połowie między pachwiną a kolanem, ciężar równo na obu stopach."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A meio caminho entre a prega da anca e o joelho, peso repartido pelos dois pés."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посередине между складкой бедра и коленом, вес равномерно на обеих ступнях."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "髋褶与膝盖的中点，体重均匀分布于双脚。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "髖褶與膝蓋的中點，體重均勻分佈於雙腳。"
          }
        }
      }
    },
    "Midway between shoulder and elbow. Relaxed or flexed both work — record the same one every time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mittig zwischen Schulter und Ellenbogen. Locker oder angespannt geht beides — nimm jedes Mal dasselbe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A media distancia entre hombro y codo. Vale relajado o contraído: registra siempre el mismo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À mi-distance entre l'épaule et le coude. Relâché ou contracté, les deux marchent : notez toujours le même."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A metà tra spalla e gomito. Rilassato o contratto vanno entrambi: registra sempre lo stesso."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W połowie między barkiem a łokciem. Rozluźnione lub napięte — obie opcje są dobre, zapisuj zawsze tę samą."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A meio caminho entre o ombro e o cotovelo. Relaxado ou contraído servem ambos: registe sempre o mesmo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посередине между плечом и локтем. Расслабленно или напряжённо — оба варианта годятся, записывайте всегда один и тот же."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "肩与肘的中点。放松或发力都可以——每次记录同一种即可。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "肩與肘的中點。放鬆或發力都可以——每次記錄同一種即可。"
          }
        }
      }
    },
