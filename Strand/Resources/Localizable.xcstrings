            "value" : "Für einen Krafttrend sind mindestens vier geeignete Einheiten pro Übung nötig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At least four suitable sessions per exercise are needed for a strength trend."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesitan al menos cuatro sesiones adecuadas por ejercicio para obtener una tendencia de fuerza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
