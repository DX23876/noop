          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fenêtre privée sur votre récupération, votre sommeil et votre effort. Lue directement depuis votre bracelet, conservée uniquement sur votre %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
