    "Drag to reorder. Move an item to Hidden to remove it from Today without deleting it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Neuanordnen ziehen. Verschiebe ein Element nach „Ausgeblendet“, um es von „Heute“ zu entfernen, ohne es zu löschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para reordenar. Mueve un elemento a Ocultos para quitarlo de Hoy sin eliminarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour réorganiser. Déplacez un élément dans Masqués pour le retirer d’Aujourd’hui sans le supprimer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per riordinare. Sposta un elemento in Nascosti per rimuoverlo da Oggi senza eliminarlo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrasta para reordenar. Move um item para Ocultos para o remover de Hoje sem o apagar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскивайте элементы, чтобы изменить порядок. Переместите элемент в раздел «Скрыто», чтобы убрать его из «Сегодня», не удаляя."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以重新排序。将项目移至“已隐藏”可从“今天”中移除，但不会删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移以重新排序。將項目移至「已隱藏」可從「今天」中移除，但不會刪除。"
          }
        }
      }
    },
    "Drag to reorder. Toggle a card on or off. Cards with no value yet show a dash.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen zum Neuordnen. Karten ein- oder ausschalten. Karten ohne Wert zeigen einen Strich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para reordenar. Activa o desactiva una tarjeta. Las tarjetas sin valor todavía muestran un guion."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour réorganiser. Activez ou désactivez une carte. Les cartes sans valeur affichent encore un tiret."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per riordinare. Attiva o disattiva una scheda. Le schede senza valore mostrano un trattino."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para reordenar. Ative ou desative um cartão. Os cartões sem valor ainda mostram um vestígio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите, чтобы изменить порядок. Включайте и выключайте карточки. Карточки, для которых пока нет значения, показывают тире."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以重新排序。开启或关闭某张卡片。尚无数值的卡片会显示一个短横。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖動以重新排序。開啟或關閉某張卡片。尚無數值的卡片會顯示一個短橫。"
          }
        }
      }
    },
    "Dragged freely — tap a corner to pin it. Corners stay clear of the tab bar and header.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frei verschoben — tippe auf eine Ecke, um sie zu fixieren. Ecken bleiben frei von Tab-Leiste und Header."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dragged freely — tap a corner to pin it. Corners stay clear of the tab bar and header."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Movido libremente — toca una esquina para fijarlo. Las esquinas quedan libres de la barra de pestañas y el encabezado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacé librement — touchez un coin pour l'y fixer. Les coins restent dégagés de la barre d'onglets et de l'en-tête."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascinato liberamente: tocca un angolo per fissarlo. Gli angoli restano lontani dalla barra delle schede e dall'intestazione."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastado livremente — toque em um canto para fixá-lo. Os cantos ficam afastados da barra de guias e do cabeçalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскивание свободно — коснитесь угла, чтобы закрепить его. Углы остаются подальше от панели вкладок и заголовка."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自由拖动 - 点击一个角将其固定。角落远离标签栏和标题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自由拖曳 - 點擊一個角落將其固定。角落遠離標籤欄和標題。"
          }
        }
      }
    },
