    "Previously paired but not currently connected. Re-scan to reconnect." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuvor gekoppelt, aber gerade nicht verbunden. Scanne neu, um wieder zu verbinden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emparejada antes pero no conectada ahora. Vuelve a escanear para reconectar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Précédemment associé mais non connecté actuellement. Relancez un scan pour vous reconnecter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbinata in precedenza ma non connessa al momento. Riesegui la scansione per riconnetterla."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poprzednio sparowane, ale obecnie nie połączone. Przeskanuj ponownie, aby ponownie połączyć."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anteriormente emparelhado, mas não ligado de momento. Digitalize novamente para voltar a ligar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ранее сопряжено, но сейчас не подключено. Просканируйте заново, чтобы переподключиться."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
