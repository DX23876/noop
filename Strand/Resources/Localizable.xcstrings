    "Likely your Oura warranty and support, because the ring is no longer paired to Oura. Treat this as permanent.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wahrscheinlich deine Oura-Garantie und den Support, weil der Ring nicht mehr mit Oura gekoppelt ist. Betrachte das als dauerhaft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Probablemente tu garantía y soporte de Oura, porque el anillo ya no está emparejado con Oura. Considéralo permanente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Probablement votre garantie et l'assistance Oura, car l'anneau n'est plus associé à Oura. Considérez cela comme définitif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Probabilmente la tua garanzia e assistenza Oura, perché l'anello non è più associato a Oura. Consideralo permanente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Provavelmente a tua garantia e suporte Oura, pois o anel já não está emparelhado com Oura. Trate-o como permanente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скорее всего, гарантию и поддержку Oura, так как кольцо больше не сопряжено с Oura. Считайте это необратимым."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "很可能会失去你的 Oura 保修和支持，因为戒指不再与 Oura 配对。请把这视为不可逆。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "很可能是你的 Oura 保固和支援，因為戒指已不再與 Oura 配對。請將此視為永久性的。"
          }
        }
      }
    },
