    "Skip if pregnant, dizzy, or have uncontrolled hypertension. Stop if strained." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überspringen bei Schwangerschaft, Schwindel oder unkontrolliertem Bluthochdruck. Bei Überanstrengung stoppen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skip if pregnant, dizzy, or have uncontrolled hypertension. Stop if strained."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sáltarlo si estás embarazada, mareada o con hipertensión no controlada. Para si te esfuerzas de más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passez si grossesse, vertige ou hypertension non contrôlée. Arrêtez si vous forcez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salta se in gravidanza, con vertigini o ipertensione non controllata. Fermati se forzi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomiń w ciąży, przy zawrotach lub niekontrolowanym nadciśnieniu. Przerwij przy forsowaniu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salta se estiveres grávida, com tonturas ou hipertensão não controlada. Para se te estiveres a forçar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пропустите при беременности, головокружении или неконтролируемой гипертонии. Остановитесь при перенапряжении."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "孕期、头晕或未控制高血压时跳过。感觉勉强即停。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "孕期、頭暈或未控制高血壓時跳過。感覺勉強即停。"
          }
        }
      }
    },
    "Skip remaining sets" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restliche Sätze überspringen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omitir las series restantes"
          }
        },
