    "Latest sleep, %@. This is your last scored session. Wear the strap overnight for a fresh score.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letzter Schlaf, %@. Das ist deine letzte bewertete Sitzung. Trage den Strap über Nacht für einen frischen Wert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Último sueño, %@. Esta es tu última sesión puntuada. Usa la pulsera durante la noche para una puntuación nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dernier sommeil, %@. Il s'agit de votre dernière séance notée. Portez le bracelet toute la nuit pour un nouveau score."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ultimo sonno, %@. Questa è la tua ultima sessione con punteggio. Indossa la fascia durante la notte per un punteggio nuovo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Último sono, %@. Esta é a tua última sessão pontuada. Usa a bracelete durante a noite para obteres uma nova pontuação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последний сон, %@. Это ваша последняя оценённая сессия. Наденьте браслет на ночь, чтобы получить новую оценку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近睡眠，%@。这是你最后一次有评分的睡眠。整晚佩戴手环即可获得新分数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最近睡眠，%@。這是你最後一次評分的睡眠。整夜佩戴手環即可獲得新分數。"
          }
        }
      }
    },
