    "Without a target date there's no pace to measure against — only where you are now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne ein Zieldatum gibt es kein Tempo, an dem man sich messen kann – nur dort, wo man sich gerade befindet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without a target date there's no pace to measure against — only where you are now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin una fecha objetivo, no hay ritmo con el que medirse, sólo dónde se encuentra ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans date cible, il n’y a pas de rythme par rapport auquel mesurer – seulement là où vous en êtes actuellement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza una data target non c'è un ritmo con cui misurare, solo dove ti trovi ora."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez daty docelowej nie ma tempa, do którego można się odnieść — jest tylko to, gdzie jesteś teraz."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem uma data prevista, não há ritmo a ser medido – apenas onde você está agora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без целевой даты нет темпа, по которому можно было бы измерять — только тот, где вы находитесь сейчас."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果没有目标日期，就无法衡量进度——只能衡量你现在所处的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果沒有目標日期，就無法衡量進度──只能衡量你現在的位置。"
          }
        }
      }
    },
    "Without one I can't tell you how you're tracking." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Ziel kann ich dir nicht sagen, wo du stehst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without one I can't tell you how you're tracking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin uno no puedo decirte cómo vas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans objectif, je ne peux pas te dire où tu en es."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza uno non posso dirti come stai monitorando."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez tego nie powiem Ci, jak Ci idzie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem um, não posso dizer como você está rastreando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без него я не смогу сказать вам, как вы отслеживаете."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果没有的话，我无法告诉你你是如何追踪的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果沒有的話，我無法告訴你你是如何追蹤的。"
          }
        }
      }
    },
    "Without one there's no route, no pace and no arrival date." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne eines gibt es keine Route, kein Tempo und kein Ankunftsdatum."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without one there's no route, no pace and no arrival date."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin ella no hay ruta, ni ritmo, ni fecha de llegada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans elle, pas d'itinéraire, pas de rythme et pas de date d'arrivée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza non c'è rotta, né ritmo, né data di arrivo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez tego nie ma trasy, tempa ani daty dojścia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem ela não há rota, ritmo nem data de chegada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без неё нет ни маршрута, ни темпа, ни даты достижения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有它就没有路线、没有节奏，也没有达成日期。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有它就沒有路線、沒有節奏，也沒有達成日期。"
          }
        }
      }
    },
