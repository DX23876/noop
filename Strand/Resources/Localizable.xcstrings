    "Waiting for a resting heart rate. Start a live reading first, or come back when you're still.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte auf eine Ruheherzfrequenz. Starte zuerst eine Live-Messung oder komm zurück, wenn du still bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando una frecuencia cardíaca en reposo. Inicia primero una lectura en vivo, o vuelve cuando estés quieto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente d'une fréquence cardiaque au repos. Démarrez d'abord une lecture en direct, ou revenez lorsque vous êtes immobile."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa di una frequenza cardiaca a riposo, avvia prima una lettura in diretta, oppure torna quando sei fermo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "À espera de uma frequência cardíaca em repouso. Comece primeiro uma leitura em direto ou volte quando estiver parado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидание пульса в покое. Сначала запустите измерение в реальном времени или вернитесь, когда будете неподвижны."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待静息心率，请先开始一次实时读数，或在你静止时再回来。"
