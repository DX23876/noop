    "Logged as a nap. Wrong? Tap Edit to adjust your sleep and wake times." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als Nickerchen erfasst. Falsch? Tippe auf „Bearbeiten“, um Schlaf- und Aufwachzeiten anzupassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrado como siesta. ¿No es correcto? Toca Editar para ajustar tus horas de sueño y despertar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistré comme sieste. Ce n'est pas correct ? Touchez Modifier pour ajuster vos heures de coucher et de réveil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrato come sonnellino. Sbagliato? Tocca Modifica per regolare gli orari di sonno e risveglio."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisano jako drzemkę. Zło? Stuknij opcję Edytuj, aby dostosować godziny snu i budzenia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registado como um cochilo. Errado? Toque em Editar para ajustar os teus horários de deitar e acordar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записано как дневной сон. Неверно? Нажмите «Изменить», чтобы скорректировать время сна и пробуждения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已记录为小睡。不对？点击「编辑」以调整你的入睡和起床时间。"
