            "state" : "translated",
            "value" : "Tudo é computado em %@. O treinador é o ÚNICO recurso em NOOP que se comunica com a internet."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все вычисляется на %@. Тренер — это ОДНА функция в NOOP, которая общается с Интернетом."
          }
        },
        "zh-Hans" : {
