    "Energy appears as soon as a connected source records today's activity." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Energie erscheint, sobald eine vernetzte Quelle heute Aktivitäten feststellt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La energía aparece tan pronto como una fuente conectada registre la actividad de hoy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’énergie apparaît dès qu’une source connectée enregistre votre activité de la journée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'energia appare appena una fonte connessa registra l'attività di oggi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energia pojawia się tak szybko, jak aktywność zebrane przez podłączone źródło zostanie zarejestrowana dziś."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
