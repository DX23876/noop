    "The provider is rate-limiting requests right now. Wait a moment and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anbieter begrenzt die Anfragen gerade. Warte kurz und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider is rate-limiting requests right now. Wait a moment and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proveedor está limitando las solicitudes en este momento. Espera un momento e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur limite actuellement les requêtes. Patientez un instant et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il provider sta limitando le richieste. Attendi un momento e riprova."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O fornecedor está a limitar os pedidos neste momento. Aguarda um pouco e tenta novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас провайдер ограничивает частоту запросов. Немного подождите и повторите попытку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提供商目前正在限制请求频率。请稍候再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "供應商目前正在限制要求頻率。請稍候再試。"
          }
        }
      }
    },
    "The provider is rate-limiting requests. It asked to wait %lld seconds.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anbieter begrenzt die Anfragen. Er bittet darum, %lld Sekunden zu warten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider is rate-limiting requests. It asked to wait %lld seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proveedor está limitando las solicitudes. Ha indicado que esperes %lld segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur limite les requêtes. Il demande d’attendre %lld secondes."
          }
        },
        "it": {
