    "Choose how distances, weights, heights, temperatures and Effort are shown. Your data is always stored the same way. This only changes the display." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, wie Distanzen, Gewichte, Größen, Temperaturen und Belastung angezeigt werden. Deine Daten werden immer gleich gespeichert. Das ändert nur die Anzeige."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige cómo se muestran las distancias, pesos, alturas, temperaturas y Esfuerzo. Tus datos siempre se almacenan igual. Esto solo cambia la visualización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez comment les distances, poids, tailles, températures et l'effort sont affichés. Vos données sont toujours stockées de la même façon. Cela ne change que l'affichage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli come vengono mostrati distanze, pesi, altezze, temperature e sforzo. I tuoi dati vengono sempre memorizzati allo stesso modo, questo cambia solo la visualizzazione."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz sposób wyświetlania odległości, ciężarów, wysokości, temperatur i Wysiłek. Twoje dane są zawsze przechowywane w ten sam sposób. To tylko zmienia sposób wyświetlania."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha como são apresentadas as distâncias, os pesos, as alturas, as temperaturas e o esforço. Os teus dados são sempre armazenados da mesma forma. Isso apenas altera a apresentação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите, как отображаются расстояния, вес, рост, температура и Усилие. Данные всегда хранятся одинаково — меняется только отображение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择距离、体重、身高、温度和消耗的显示方式。你的数据始终以相同方式存储，这只改变显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇距離、體重、身高、溫度和消耗的顯示方式。你的資料始終以相同方式儲存，這只改變顯示。"
          }
        }
      }
    },
    "Choose how NOOP looks. The whole app updates as you tap. You can change this any time in Settings → Appearance." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, wie NOOP aussieht. Die ganze App aktualisiert sich beim Tippen. Du kannst das jederzeit unter Einstellungen → Erscheinungsbild ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige el aspecto de NOOP. Toda la app se actualiza al tocar. Puedes cambiarlo en cualquier momento en Ajustes → Apariencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez l'apparence de NOOP. Toute l'application se met à jour au fur et à mesure. Vous pouvez changer cela à tout moment dans Paramètres → Apparence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli l'aspetto di NOOP. Tutta l'app si aggiorna mentre tocchi. Puoi cambiarlo in qualsiasi momento in Impostazioni → Aspetto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz wygląd NOOP. Cała aplikacja aktualizuje się po dotknięciu. Możesz to zmienić w dowolnym momencie w Ustawieniach → Wygląd."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha o aspeto do NOOP. Todo o aplicativo é atualizado à medida que toca. Pode alterar isto a qualquer momento em Definições → Aparência."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите внешний вид NOOP. Всё приложение обновляется при нажатии. Изменить это можно в любой момент в Настройках → Внешний вид."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择 NOOP 的外观。点按即可全局生效。之后随时可在设置 → 外观中更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇 NOOP 的外觀。點擊後整個應用程式會即時更新。你隨時可以在「設定 → 外觀」中更改。"
          }
        }
      }
    },
    "Choose how workout entry, rest timers and optional exercise media behave." : {
      "localizations" : {
