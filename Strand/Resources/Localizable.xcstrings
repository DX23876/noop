        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estamos a aprender o teu padrão a partir da temperatura noturna. Continua a usar o dispositivo durante a noite."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estamos a aprender o teu padrão a partir da temperatura noturna. Continua a usar o dispositivo durante a noite."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estamos a aprender o teu padrão a partir da temperatura noturna. Continua a usar o dispositivo durante a noite."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estamos a aprender o teu padrão a partir da temperatura noturna. Continua a usar o dispositivo durante a noite."
          }
        }
      }
    },
    "Learning your wake time from your sleep. Until there's enough, it uses your fixed time (%@)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lernen Sie Ihre Wachzeit aus Ihrem Schlaf. Bis genug vorhanden ist, wird Ihre festgelegte Zeit (%@) verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Learning your wake time from your sleep. Until there's enough, it uses your fixed time (%@)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprender la hora de despertarse a partir del sueño. Hasta que haya suficiente, utiliza su tiempo fijo (%@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apprendre votre heure de réveil à partir de votre sommeil. Jusqu'à ce qu'il y en ait suffisamment, il utilise votre heure fixe (%@)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imparare l'ora della veglia dal sonno. Finché non ce n'è abbastanza, utilizza il tempo prestabilito (%@)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uczy się Twojej pory pobudki z Twojego snu. Dopóki danych jest za mało, używa stałej godziny (%@)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprendendo a hora de acordar durante o sono. Até que haja o suficiente, ele usa seu tempo fixo (%@)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Узнайте время бодрствования во время сна. Пока его не будет достаточно, будет использоваться ваше фиксированное время (%@)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从睡眠中了解您的醒来时间。直到足够为止，它会使用您的固定时间 (%@)。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從睡眠中了解您的醒來時間。直到足夠為止，它會使用您的固定時間 (%@)。"
          }
        }
      }
    },
    "Leave anything you did not measure empty. Only filled fields are saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was du nicht gemessen hast, lass leer. Gespeichert werden nur ausgefüllte Felder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja vacío lo que no hayas medido. Solo se guardan los campos rellenados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez vide ce que vous n'avez pas mesuré. Seuls les champs remplis sont enregistrés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia vuoto ciò che non hai misurato. Vengono salvati solo i campi compilati."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zostaw puste to, czego nie zmierzyłeś. Zapisywane są tylko wypełnione pola."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe em branco o que não mediu. Só os campos preenchidos são guardados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставьте пустым то, что не измеряли. Сохраняются только заполненные поля."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未测量的项目请留空。只有填写的字段会被保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未測量的專案請留空。只有填寫的欄位會被儲存。"
          }
        }
      }
    },
    "Leave none active" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keins aktiv lassen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No dejar ninguna activa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N'en laisser aucune active"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non lasciarne nessuna attiva"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie pozostawiaj żadnego aktywnego"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não deixe nenhum ativo"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не оставлять ни одного активным"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不保留任何活跃项"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不保留任何活躍項"
          }
        }
      }
    },
    "Led by your heart-rate variability (HRV) measured against your own personal baseline, plus resting heart rate, last night's Rest, breathing rate, and a skin-temperature signal (an early illness or overreach flag). Higher HRV versus your baseline means more Charge. NOOP needs a few nights to learn your baseline first. Until then you'll see “Calibrating”." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angeführt von deiner Herzfrequenzvariabilität (HRV) gegenüber deiner persönlichen Basislinie, plus Ruheherzfrequenz, Erholung der letzten Nacht, Atemfrequenz und einem Hauttemperatur-Signal (ein frühes Zeichen für Krankheit oder Überlastung). Höhere HRV gegenüber deiner Basislinie bedeutet mehr Energie. NOOP braucht zuerst ein paar Nächte, um deine Basislinie zu lernen. Bis dahin siehst du „Kalibrierung“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liderada por tu variabilidad de la frecuencia cardíaca (VFC) medida frente a tu propia línea base personal, más la frecuencia cardíaca en reposo, el Descanso de anoche, la frecuencia respiratoria y una señal de temperatura de la piel (una alerta temprana de enfermedad o sobreentrenamiento). Una VFC más alta frente a tu línea base significa más Carga. NOOP necesita unas cuantas noches para aprender tu línea base primero. Hasta entonces verás “Calibrando”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piloté par votre variabilité de la fréquence cardiaque (VFC) mesurée par rapport à votre propre référence personnelle, plus la fréquence cardiaque au repos, le Repos de la nuit dernière, la fréquence respiratoire et un signal de température cutanée (une alerte précoce de maladie ou de surcharge). Une VFC plus élevée que votre référence signifie plus de Charge. NOOP a d'abord besoin de quelques nuits pour apprendre votre référence. En attendant, vous verrez « Calibration en cours »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guidata dalla tua variabilità della frequenza cardiaca (HRV) misurata rispetto alla tua linea di base personale, più frequenza cardiaca a riposo, il Riposo della scorsa notte, la frequenza respiratoria e un segnale di temperatura cutanea (un campanello precoce di malattia o sovraccarico). Un'HRV più alta rispetto alla tua linea di base significa più Carica. NOOP ha bisogno prima di qualche notte per imparare la tua linea di base. Fino ad allora vedrai “Calibrazione”."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na podstawie zmienności tętna (HRV) zmierzonej w stosunku do Twojej osobistej wartości bazowej, plus tętno spoczynkowe, Odpoczynek z ostatniej nocy, częstość oddechów i sygnał temperatury skóry (wskaźnik wczesnej choroby lub przekroczenia zasięgu). Wyższe HRV w porównaniu z wartością bazową oznacza więcej Energia. NOOP potrzebuje najpierw kilku nocy, aby nauczyć się linii bazowej. Do tego czasu zobaczysz komunikat „Kalibracja”."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liderado pela variabilidade da frequência cardíaca (VFC) medida em relação à sua linha de base pessoal, além da frequência cardíaca em repouso, descanso da noite anterior, frequência respiratória e um sinal de temperatura da pele (uma doença precoce ou sinal de excesso). Uma VFC mais elevada em relação à linha de base significa mais carga. O NOOP precisa de algumas noites para aprender primeiro a tua linha de base. Até lá verá “A calibrar”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Определяется вариабельностью сердечного ритма (ВСР) относительно вашей личной нормы, а также пульсом в покое, вчерашним Отдыхом, частотой дыхания и сигналом температуры кожи (ранний признак болезни или перетренированности). Более высокая ВСР относительно нормы означает больше Заряда. Сначала NOOP нужно несколько ночей, чтобы изучить вашу норму. До этого вы увидите «Калибровка»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主要由相对于你个人基线测量的心率变异性（HRV）驱动，再加上静息心率、昨晚的休息、呼吸频率，以及皮肤温度信号（疾病或过度训练的早期标志）。HRV 高于基线意味着更多能量。NOOP 需要几个晚上先学习你的基线，在那之前你会看到「校准中」。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主要依據你的心率變異性（HRV）相對於你個人基線的表現，再加上靜息心率、昨晚的休息、呼吸率，以及皮膚溫度訊號（疾病或過度訓練的早期標誌）。HRV 相對基線越高，能量就越多。NOOP 需要先花幾晚學習你的基線，在那之前你會看到「校準中」。"
          }
        }
      }
    },
    "Led by your heart-rate variability versus your own baseline. The watch samples HRV rather than streaming it, so this needs about a week of nights to calibrate. Until then NOOP shows “needs more data”, never a guessed number." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angeführt von deiner Herzfrequenzvariabilität gegenüber deiner eigenen Basislinie. Die Uhr misst HRV stichprobenartig statt im Stream, daher braucht das etwa eine Woche an Nächten zum Kalibrieren. Bis dahin zeigt NOOP „braucht mehr Daten“, nie eine geratene Zahl."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liderada por tu variabilidad de la frecuencia cardíaca frente a tu propia línea base. El reloj muestrea la VFC en lugar de transmitirla, así que esto necesita alrededor de una semana de noches para calibrarse. Hasta entonces NOOP muestra “necesita más datos”, nunca un número adivinado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piloté par votre variabilité de la fréquence cardiaque par rapport à votre propre référence. La montre échantillonne la VFC plutôt que de la diffuser en continu, ce qui nécessite environ une semaine de nuits pour se calibrer. En attendant, NOOP affiche « données insuffisantes », jamais un chiffre deviné."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guidata dalla tua variabilità della frequenza cardiaca rispetto alla tua linea di base. L'orologio campiona l'HRV invece di trasmetterla in continuo, quindi serve circa una settimana di notti per calibrarsi. Fino ad allora NOOP mostra “servono più dati”, mai un numero inventato."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na podstawie zmienności tętna w porównaniu z wartością bazową. Zegarek zamiast przesyłać strumieniowo próbki HRV, więc kalibracja zajmuje około tygodnia. Do tego czasu NOOP pokazuje „potrzebuje więcej danych”, nigdy nie jest to odgadnięta liczba."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liderado pela variabilidade da tua frequência cardíaca em relação à sua própria linha de base. O relógio faz uma amostragem do HRV em vez de o transmitir, pelo que é necessário cerca de uma semana para calibrar. Até lá, o NOOP mostra “precisa de mais dados”, nunca um número adivinhado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Определяется вариабельностью сердечного ритма относительно вашей нормы. Часы измеряют ВСР точечно, а не непрерывно, поэтому калибровка занимает около недели ночей. До этого NOOP показывает «нужно больше данных», а не угаданное число."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主要看你的心率变异性相对于自身基线的表现。手表是抽样测量 HRV 而不是持续记录，所以需要大约一周的夜晚来校准。在那之前 NOOP 会显示「需要更多数据」，绝不给出猜测的数字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主要依據你的心率變異性相對於自身基線的表現。手錶是抽樣測量 HRV 而非持續串流，因此這需要大約一週的夜晚來校準。在那之前 NOOP 會顯示「需要更多資料」，絕不顯示猜測的數字。"
          }
        }
      }
    },
