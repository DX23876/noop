    "Oura's own Readiness and Sleep scores. NOOP does not copy them. It computes its own.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouras eigene Readiness- und Schlafwerte. NOOP kopiert sie nicht. Es berechnet seine eigenen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las puntuaciones propias de Readiness y Sueño de Oura. NOOP no las copia. Calcula las suyas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les scores Readiness et Sommeil propres à Oura. NOOP ne les copie pas. Il calcule les siens."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
