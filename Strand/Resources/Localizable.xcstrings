          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти данные генерируются внутри приложения на основе ваших последних тренировок, а не тренера. Вы можете отправить их."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
