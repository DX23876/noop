      }
    },
    "On: a reminder at the time you set for a planned session.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An: eine Erinnerung zur Uhrzeit, die du für eine geplante Einheit gesetzt hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On: a reminder at the time you set for a planned session."
          }
        },
        "es": {
