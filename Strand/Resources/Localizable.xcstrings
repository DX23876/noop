    "The images and animations belong to Gym visual. Keep this attribution and use them only for personal, non-commercial purposes. NOOP does not grant any licence for these files." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bilder und Animationen gehören Gym visual. Behalte diese Namensnennung bei und nutze sie nur privat und nicht-kommerziell. NOOP vergibt keine Lizenz für diese Dateien."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The images and animations belong to Gym visual. Keep this attribution and use them only for personal, non-commercial purposes. NOOP does not grant any licence for these files."
