        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entendo que NOOP não é oficial e é experimental, é fornecido gratuitamente e \"como está\", sem garantia, e não é um dispositivo médico ou aconselhamento médico."
          }
        },
        "ru" : {
          "stringUnit" : {
