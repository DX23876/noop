      }
    },
    "A 60-second snapshot of your beat-to-beat (R-R) intervals from the strap, cleaned (range and ectopic-beat filtering) before computing RMSSD the same way your overnight HRV is computed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine 60-Sekunden-Momentaufnahme deiner Herzschlag-Intervalle (R-R) vom Strap, bereinigt (Bereichs- und Extrasystolen-Filterung), bevor RMSSD genauso berechnet wird wie deine nächtliche HRV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una instantánea de 60 segundos de tus intervalos latido a latido (R-R) desde la pulsera, depurada (filtrado de rango y de latidos ectópicos) antes de calcular el RMSSD de la misma forma en que se calcula tu VFC nocturna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un instantané de 60 secondes de vos intervalles battement à battement (R-R) provenant du bracelet, nettoyés (filtrage de plage et des battements ectopiques) avant de calculer le RMSSD de la même façon que votre VFC nocturne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'istantanea di 60 secondi degli intervalli battito-battito (R-R) dalla fascia, ripuliti (filtraggio di intervallo e battiti ectopici) prima di calcolare l'RMSSD nello stesso modo in cui viene calcolata la tua HRV notturna."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um instantâneo de 60 segundos dos teus intervalos batimento a batimento (R-R) da correia, limpos (filtragem de intervalo e batimento ectópico) antes de calcular o RMSSD da mesma forma que a tua VFC noturna é calculada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "60-секундный снимок межударных (R-R) интервалов с браслета, очищенный (фильтрация по диапазону и по эктопическим сокращениям) перед расчётом RMSSD — тем же способом, что и ваша ночная ВСР."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自手环的 60 秒逐拍（R-R）间期快照，在计算 RMSSD 之前经过清洗（范围和异位搏动过滤），计算方式与你的夜间 HRV 相同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來自手環的 60 秒逐拍（R-R）間期快照，在計算 RMSSD 之前經過清洗（範圍和異位搏動過濾），計算方式與你的夜間 HRV 相同。"
          }
        }
      }
    },
    "A Shortcut wants to add %lld days and %lld workouts to the Apple Health import source.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kurzbefehl möchte %lld Tage und %lld Workouts zur Apple-Health-Importquelle hinzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un atajo quiere añadir %lld días y %lld entrenamientos a la fuente de importación de Apple Health."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un raccourci veut ajouter %lld jours et %lld entraînements à la source d'import Apple Santé."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um atalho pretende adicionar %lld dias e %lld treinos à fonte de importação do Apple Health."
          }
        }
      }
    },
    "A Shortcut wants to add data to the Apple Health import source.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kurzbefehl möchte Daten zur Apple-Health-Importquelle hinzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un atajo quiere añadir datos a la fuente de importación de Apple Health."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un raccourci veut ajouter des données à la source d'import Apple Santé."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um atalho pretende adicionar dados à fonte de importação do Apple Health."
          }
        }
      }
    },
    "A WHOOP export backfills recovery, strain, sleep and workouts. Apple Health can add HR, HRV, sleep, SpO₂, steps, workouts and weight.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein WHOOP-Export füllt Erholung, Belastung, Schlaf und Workouts rückwirkend auf. Apple Health kann HF, HRV, Schlaf, SpO₂, Schritte, Workouts und Gewicht ergänzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una exportación de WHOOP rellena recuperación, esfuerzo, sueño y entrenamientos. Apple Health puede añadir FC, VFC, sueño, SpO₂, pasos, entrenamientos y peso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une exportation WHOOP complète rétroactivement la récupération, l'effort, le sommeil et les entraînements. Apple Santé peut ajouter la FC, la VFC, le sommeil, le SpO₂, les pas, les entraînements et le poids."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'esportazione WHOOP ricostruisce recupero, carico, sonno e allenamenti. Apple Health può aggiungere FC, HRV, sonno, SpO₂, passi, allenamenti e peso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma exportação WHOOP preenche a recuperação, o esforço, o sono e os treinos. O Apple Health pode adicionar FC, VFC, sono, SpO₂, passos, treinos e peso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспорт WHOOP восполняет данные восстановления, нагрузки, сна и тренировок. Apple Health может добавить пульс, ВСР, сон, SpO₂, шаги, тренировки и вес."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WHOOP 导出文件可回填恢复、强度、睡眠和锻炼。Apple Health 可补充心率、HRV、睡眠、SpO₂、步数、锻炼和体重。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "WHOOP 匯出可回填恢復、強度、睡眠與訓練。Apple Health 則可補充心率、HRV、睡眠、SpO₂、步數、訓練與體重。"
          }
        }
      }
    },
    "A WHOOP membership runs $300–480 a year, for life. NOOP does this for free: one person, no servers, no subscription.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine WHOOP-Mitgliedschaft kostet 300–480 $ im Jahr, lebenslang. NOOP macht das kostenlos: eine Person, keine Server, kein Abo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una membresía de WHOOP cuesta entre $300 y $480 al año, de por vida. NOOP hace esto gratis: una sola persona, sin servidores, sin suscripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un abonnement WHOOP coûte 300–480 $ par an, à vie. NOOP fait cela gratuitement : une seule personne, aucun serveur, aucun abonnement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un abbonamento WHOOP costa 300–480 $ all'anno, a vita. NOOP lo fa gratis, una persona, nessun server, nessun abbonamento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma filiação no WHOOP custa entre 300 e 480 dólares por ano, para toda a vida. A NOOP faz isso de graça: uma pessoa, sem servidores, sem assinatura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписка WHOOP стоит $300–480 в год, пожизненно. NOOP делает то же самое бесплатно: один человек, без серверов, без подписки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WHOOP 会员资格每年 300–480 美元，终身如此。NOOP 免费做到这一点，一个人，没有服务器，没有订阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "WHOOP 會員資格每年 300–480 美元，終身如此。NOOP 免費做到這一點，一個人，沒有伺服器，沒有訂閱。"
          }
        }
      }
    },
    "A badge shows whether a number was scored on-device by NOOP, or imported from Whoop or Apple Health.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Badge zeigt, ob ein Wert von NOOP auf dem Gerät berechnet oder aus Whoop bzw. Apple Health importiert wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una insignia muestra si un número fue calculado en el dispositivo por NOOP, o importado desde Whoop o Apple Health."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un badge indique si un nombre a été calculé sur l'appareil par NOOP, ou importé depuis Whoop ou Apple Santé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un badge indica se un numero è stato calcolato sul dispositivo da NOOP o importato da Whoop o Apple Health."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um emblema mostra se um número foi pontuado no dispositivo pelo NOOP ou importado do Whoop ou Apple Health."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значок показывает, был ли показатель рассчитан на устройстве в NOOP или импортирован из Whoop либо Apple Health."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "徽章会标明某个数字是由 NOOP 在设备上计算的，还是从 Whoop 或 Apple Health 导入的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "徽章會標明某個數字是由 NOOP 在裝置上計算，還是從 Whoop 或 Apple Health 匯入。"
          }
        }
      }
    },
    "A baseline-normalized recovery score: your resting heart rate, sleep quality and night-to-night consistency, weighted against your own baseline, with heart-rate variability (rMSSD) leading wherever the strap gives us a clean reading.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein an der Basislinie normalisierter Erholungswert: deine Ruheherzfrequenz, Schlafqualität und Konsistenz von Nacht zu Nacht, gewichtet gegen deine eigene Basislinie, wobei die Herzfrequenzvariabilität (rMSSD) führt, wo immer der Strap einen sauberen Messwert liefert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una puntuación de recuperación normalizada según tu línea base: tu frecuencia cardíaca en reposo, la calidad del sueño y la consistencia noche a noche, ponderadas contra tu propia línea base, con la variabilidad de la frecuencia cardíaca (rMSSD) al frente siempre que la pulsera nos dé una lectura limpia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un score de récupération normalisé par rapport à une référence : votre fréquence cardiaque au repos, la qualité du sommeil et la régularité nuit après nuit, pondérées par rapport à votre propre référence, la variabilité de la fréquence cardiaque (rMSSD) primant partout où le bracelet fournit une lecture propre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un punteggio di recupero normalizzato sulla linea di base: la tua frequenza cardiaca a riposo, la qualità del sonno e la costanza notte dopo notte, ponderate rispetto alla tua linea di base, con la variabilità della frequenza cardiaca (rMSSD) in primo piano ovunque la fascia ci dia una lettura pulita."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pontuação de recuperação normalizada na linha de base: a tua frequência cardíaca em repouso, a qualidade do sono e a consistência noite a noite, ponderadas em relação à sua própria linha de base, com a variabilidade da frequência cardíaca (rMSSD) a conduzir para onde quer que a bracelete nos forneça uma leitura limpa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показатель восстановления, нормализованный по вашей норме: пульс в покое, качество сна и стабильность от ночи к ночи, взвешенные относительно вашей собственной нормы, где вариабельность сердечного ритма (rMSSD) играет ведущую роль везде, где браслет даёт чистое показание."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个按基线归一化的恢复评分：你的静息心率、睡眠质量和逐夜一致性，均相对于你自身的基线加权，只要手环能给出干净的读数，就以心率变异性（rMSSD）为主导。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個以基線正規化的恢復分數：你的靜息心率、睡眠品質與每晚的一致性，皆對照你自己的基線加權，只要手環給出乾淨的讀數，就以心率變異性（rMSSD）為主導。"
          }
        }
      }
    },
    "A blend of how long you slept versus your personal need (the biggest factor), how efficiently (asleep versus in bed), how much was restorative (deep + REM sleep), and how consistent your sleep and wake timing is.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Mischung daraus, wie lange du im Verhältnis zu deinem persönlichen Bedarf geschlafen hast (der größte Faktor), wie effizient (schlafend vs. im Bett), wie viel erholsam war (Tiefschlaf + REM) und wie konsistent deine Schlaf- und Aufwachzeiten sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una combinación de cuánto dormiste frente a tu necesidad personal (el factor más importante), con qué eficiencia (dormido frente a en la cama), cuánto fue reparador (sueño profundo + REM), y qué tan consistentes son tus horarios de sueño y despertar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mélange de la durée de votre sommeil par rapport à votre besoin personnel (le facteur le plus important), de son efficacité (endormi par rapport au temps au lit), de sa part réparatrice (sommeil profond + paradoxal), et de la régularité de vos horaires de sommeil et de réveil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mix di quanto hai dormito rispetto al tuo bisogno personale (il fattore più importante), con quale efficienza (addormentato rispetto a letto), quanto è stato rigenerante (sonno profondo + REM) e quanto sono regolari i tuoi orari di sonno e risveglio."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma mistura de quanto tempo dormiu versus a tua necessidade pessoal (o fator mais importante), quão eficientemente (adormecido versus na cama), quanto foi reparador (sono profundo + REM) e quão consistente é o teu horário de sono e vigília."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сочетание того, сколько вы спали относительно вашей личной потребности (главный фактор), насколько эффективно (сон против времени в постели), сколько сна было восстановительным (глубокий + быстрый сон), и насколько стабильны ваши время отхода ко сну и пробуждения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "综合考量：你的睡眠时长相对于个人需求（最大因素）、睡眠效率（入睡时间与在床时间之比）、恢复性睡眠占比（深睡 + REM 睡眠），以及你的入睡和起床时间是否规律。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "綜合考量你的睡眠時長相對於個人需求（最大的因素）、睡眠效率（實際入睡與躺床時間之比）、恢復性睡眠的比例（深睡 + REM 睡眠），以及你入睡與起床時間的一致性。"
          }
        }
      }
    },
    "A bulk markers CSV import (date, marker, value, unit) lands with the file importers in Data Sources, same as nutrition and lifting. For now, add readings one at a time above. Everything you import stays on %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Massen-CSV-Import für Marker (Datum, Marker, Wert, Einheit) kommt zu den Datei-Importern in „Datenquellen“, wie schon Ernährung und Krafttraining. Füge Messwerte vorerst oben einzeln hinzu. Alles, was du importierst, bleibt auf %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una importación masiva de marcadores por CSV (fecha, marcador, valor, unidad) llegará con los importadores de archivos en Fuentes de datos, igual que nutrición y pesas. Por ahora, añade lecturas de una en una arriba. Todo lo que importes se queda en %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une importation groupée de marqueurs par CSV (date, marqueur, valeur, unité) arrivera avec les importateurs de fichiers dans Sources de données, comme la nutrition et la musculation. Pour l'instant, ajoutez les lectures une par une ci-dessus. Tout ce que vous importez reste sur %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'importazione di marcatori in blocco da CSV (data, marcatore, valore, unità) arriverà con gli importatori di file in Sorgenti dati, come per nutrizione e sollevamento pesi. Per ora, aggiungi le letture una alla volta qui sopra. Tutto ciò che importi resta su %@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma importação CSV de marcadores em massa (data, marcador, valor, unidade) chega aos importadores de ficheiros nas fontes de dados, o mesmo que nutrição e levantamento. Por enquanto, adicione as leituras uma de cada vez acima. Tudo o que importa permanece em %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Массовый импорт маркеров из CSV (дата, маркер, значение, единица измерения) появится вместе с остальными импортёрами файлов в разделе «Источники данных» — как для питания и силовых тренировок. Пока добавляйте показания по одному выше. Всё, что вы импортируете, остаётся на %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批量标记 CSV 导入（日期、标记、数值、单位）将随「数据来源」中的文件导入器一起推出，与营养和力量训练相同。目前请在上方逐条添加读数。你导入的一切都留在 %@ 上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "批量標記 CSV 匯入（日期、標記、數值、單位）將隨「資料來源」中的檔案匯入器一起推出，與營養和力量訓練相同。目前請在上方逐筆新增讀數。你匯入的一切都留在 %@ 上。"
          }
        }
      }
    },
    "A buzz, not a banner": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Vibrieren, kein Banner"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vibración, no un banner"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une vibration, pas une bannière"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vibrazione, non un banner"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um buzz, não um banner"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрация, а не баннер"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次震动，而非横幅"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次震動，而非橫幅通知"
          }
        }
      }
    },
    "A calm evening reminder, timed from your wake time and usual sleep need. It's a suggestion, not an alarm.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine ruhige Abenderinnerung, abgestimmt auf deine Aufwachzeit und deinen üblichen Schlafbedarf. Ein Vorschlag, kein Wecker."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un recordatorio tranquilo por la tarde, calculado a partir de tu hora de despertar y tu necesidad habitual de sueño. Es una sugerencia, no una alarma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rappel calme en soirée, calculé à partir de votre heure de réveil et de votre besoin habituel de sommeil. C'est une suggestion, pas une alarme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un promemoria serale tranquillo, calibrato sulla tua ora di risveglio e sul consueto bisogno di sonno. È un suggerimento, non una sveglia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um lembrete calmo à noite, cronometrado a partir da hora de acordar e da necessidade habitual de dormir. É uma sugestão, não um alarme."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спокойное вечернее напоминание, рассчитанное от времени пробуждения и обычной потребности во сне. Это подсказка, а не будильник."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个平静的傍晚提醒，根据你的起床时间和通常的睡眠需求来定时。它是一个建议，而非闹钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個平靜的傍晚提醒，根據你的起床時間和通常的睡眠需求來定時。它是一個建議，而非鬧鐘。"
          }
        }
      }
    },
    "A calm hour now helps you hit your wake time well-rested.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine ruhige Stunde jetzt hilft dir, deine Aufwachzeit ausgeruht zu erreichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una hora tranquila ahora te ayuda a llegar bien descansado a tu hora de despertar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une heure calme maintenant vous aide à atteindre votre heure de réveil bien reposé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'ora tranquilla adesso ti aiuta ad arrivare riposato alla tua ora di risveglio."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma hora calma ajuda-o agora a acordar bem descansado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спокойный час сейчас поможет вам проснуться отдохнувшим к нужному времени."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在安静一小时，有助于你在起床时间精力充沛地醒来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在安靜地度過一小時，有助於你在起床時間醒來時精神飽滿。"
          }
        }
      }
    },
    "A calm nudge %lldh %lldm before your wake time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein sanfter Anstoß %1$lldh %2$lldm vor deiner Aufwachzeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "A calm nudge %1$lldh %2$lldm before your wake time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aviso suave %lldh %lldm antes de tu hora de despertar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rappel doux %1$lldh %2$lldm avant votre heure de réveil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un avviso tranquillo %1$lldh %2$lldm prima della tua ora di risveglio."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um empurrãozinho calmo %1$lldh %2$lldm antes de acordar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спокойное напоминание за %1$lldч %2$lldм до времени пробуждения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你起床时间前 %1$lld 小时 %2$lld 分钟的一次平静提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你起床時間前 %1$lld 小時 %2$lld 分鐘的一次平靜提醒。"
          }
        }
      }
    },
    "A cardiovascular load in the Banister TRIMP family: time spent in each heart-rate zone, weighted so harder zones count for more, summed into one daily figure.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine kardiovaskuläre Last aus der Banister-TRIMP-Familie: Zeit in jeder Herzfrequenzzone, gewichtet, sodass härtere Zonen mehr zählen, aufsummiert zu einer Tageszahl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una carga cardiovascular de la familia TRIMP de Banister: tiempo en cada zona de frecuencia cardíaca, ponderado para que las zonas más duras cuenten más, sumado en una sola cifra diaria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une charge cardiovasculaire de la famille TRIMP de Banister : le temps passé dans chaque zone de fréquence cardiaque, pondéré pour que les zones plus intenses comptent davantage, additionné en un seul chiffre journalier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un carico cardiovascolare della famiglia Banister TRIMP: il tempo trascorso in ciascuna zona di frequenza cardiaca, ponderato in modo che le zone più dure contino di più, sommato in un unico dato giornaliero."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma carga cardiovascular na família Banister TRIMP: o tempo passado em cada zona de frequência cardíaca, ponderado para que as zonas mais difíceis contem mais, resumido num valor diário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сердечно-сосудистая нагрузка из семейства Banister TRIMP: время, проведённое в каждой пульсовой зоне, взвешенное так, что более тяжёлые зоны учитываются сильнее, суммированное в одно дневное значение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "属于 Banister TRIMP 家族的心血管负荷：统计你在各心率区间的时长，区间越高权重越大，汇总为一个每日数字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "屬於 Banister TRIMP 家族的心血管負荷：在各心率區間停留的時間，較高強度區間權重更大，加總成每日一個數字。"
          }
        }
      }
    },
    "A classic one-glance read of NOOP's own scores. Same data, different lens.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein klassischer Überblick über NOOPs eigene Werte auf einen Blick. Gleiche Daten, andere Perspektive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una lectura clásica de una sola vez de las propias puntuaciones de NOOP. Los mismos datos, lente diferente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une lecture classique en un coup d'œil des scores propres à NOOP. Mêmes données, différents objectifs."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma leitura clássica das próprias pontuações do NOOP. Mesmos dados, lentes diferentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Классический взгляд на собственные показатели NOOP одним взглядом. Те же данные, другой ракурс."
          }
        }
      }
    },
    "A clean, shareable one-page PDF of your recovery, sleep, HRV, resting heart rate and strain over a date range. Saved on your %@. Nothing leaves the device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein sauberes, teilbares einseitiges PDF deiner Erholung, deines Schlafs, deiner HRV, Ruheherzfrequenz und Belastung über einen Zeitraum. Gespeichert auf deinem %@. Nichts verlässt das Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un PDF limpio y compartible de una página con tu recuperación, sueño, VFC, frecuencia cardíaca en reposo y esfuerzo en un rango de fechas. Guardado en tu %@. Nada sale del dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un PDF d'une page, clair et partageable, de votre récupération, sommeil, VFC, fréquence cardiaque au repos et effort sur une période. Enregistré sur votre %@. Rien ne quitte l'appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un PDF di una pagina, ordinato e condivisibile, del tuo recupero, sonno, HRV, frequenza cardiaca a riposo e carico in un intervallo di date. Salvato sul tuo %@, niente lascia il dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um PDF de uma página limpo e partilhável da tua recuperação, sono, VFC, frequência cardíaca em repouso e esforço durante um período. Salvo no teu %@. Nada sai do dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аккуратный, готовый для отправки одностраничный PDF с вашим восстановлением, сном, ВСР, пульсом в покое и нагрузкой за выбранный период. Сохраняется на вашем %@. Ничего не покидает устройство."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一份简洁、可分享的单页 PDF，涵盖某个日期范围内你的恢复、睡眠、HRV、静息心率和强度。保存在你的 %@ 上，没有任何内容离开设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一份簡潔、可分享的單頁 PDF，涵蓋某個日期範圍內你的恢復、睡眠、HRV、靜息心率和強度。保存在你的 %@ 上，沒有任何內容離開裝置。"
          }
        }
      }
    },
