    },
    "A lab marker you logged": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein von dir erfasster Laborwert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A lab marker you logged"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un marcador de laboratorio que registraste"
          }
        },
        "fr": {
          "stringUnit": {
