    "Re-anchors every baseline that feeds Charge to your recent nights. No stored day is deleted.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verankert jede Basislinie, die in die Ladung einfließt, neu an deinen letzten Nächten. Kein gespeicherter Tag wird gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a anclar todas las líneas base que alimentan la Carga a tus noches recientes. No se elimina ningún día almacenado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réancre chaque ligne de base qui alimente la Charge sur vos nuits récentes. Aucun jour enregistré n'est supprimé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riancora alle tue notti recenti ogni linea di base che alimenta la carica. Nessun giorno memorizzato viene eliminato."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Reancora cada linha de base que alimenta Carga nas tuas noites recentes. Nenhum dia armazenado é eliminado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пересчитывает все нормы, влияющие на Заряд, по последним ночам. Ни один сохранённый день не удаляется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将所有为能量提供数据的基线重新锚定到你近期的夜晚。不会删除任何已存储的日期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將所有為能量提供資料的基線重新錨定到你近期的夜晚。不會刪除任何已儲存的日期。"
          }
        }
      }
    },
