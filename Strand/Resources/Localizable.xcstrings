            "value" : "Żadne miejsce nie ma jeszcze dwóch pomiarów wystarczająco odległych. Zmierz ponownie za kilka tygodni, a to się wypełni."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
