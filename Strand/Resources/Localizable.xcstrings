    "A draggable button that floats over every screen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine ziehbare Schaltfläche, die über jedem Bildschirm schwebt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A draggable button that floats over every screen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un botón arrastrable que flota sobre cada pantalla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bouton déplaçable qui flotte sur chaque écran"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
