    "Wear the strap overnight and these read from your nightly skin temperature." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trage den Strap über Nacht, dann lesen diese aus deiner nächtlichen Hauttemperatur."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la pulsera durante la noche y estos se leen de tu temperatura nocturna de la piel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Portez le bracelet la nuit et ces valeurs se basent sur votre température cutanée nocturne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indossa la fascia durante la notte e questi valori vengono letti dalla temperatura cutanea notturna."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noś pasek przez noc, a odczytana zostanie temperatura skóry w nocy."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a bracelete durante a noite e medem a temperatura noturna da tua pele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наденьте браслет на ночь, и эти показатели считываются с вашей ночной температуры кожи."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整晚佩戴手环，这些数据便会从你的夜间皮肤温度中读取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整晚佩戴手環，這些資料便會從你的夜間皮膚溫度中讀取。"
          }
        }
      }
    },
    "Wear the strap overnight to score a night first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
