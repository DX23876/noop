            "state": "translated",
            "value": "Identique au modèle de coaching"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stesso del modello di coaching"
          }
        },
        "pt-PT": {
          "stringUnit": {
