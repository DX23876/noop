    "Bhastrika (bellows): forceful 1-second nasal inhale and exhale. Energising and intense. Keep rounds short and rest between them." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bhastrika (Blasebalg): kraftvolles 1-Sekunden-Ein- und Ausatmen durch die Nase. Energetisierend und intensiv. Runden kurz halten und dazwischen pausieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bhastrika (bellows): forceful 1-second nasal inhale and exhale. Energising and intense. Keep rounds short and rest between them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bhastrika (fuelle): inhalación y exhalación nasal forzadas de 1 segundo. Energizante e intensa. Mantén rondas cortas y descansa entre ellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bhastrika (soufflet) : inspire et expire nasales forcées d’1 seconde. Énergisant et intense. Gardez des tours courts et reposez-vous entre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bhastrika (mantice): inspirazione ed espirazione nasale forzate da 1 secondo. Energizzante e intensa. Tieni round corti e riposa tra di essi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bhastrika (miechy): forsowny 1-sekundowy wdech i wydech nosem. Energetyzujące i intensywne. Trzymaj krótkie rundy i odpoczywaj między nimi."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bhastrika (fole): inspiração e expiração nasal forçadas de 1 segundo. Energizante e intensa. Mantém rondas curtas e descansa entre elas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bhastrika (меха): форсированный 1-секундный носовой вдох и выдох. Энергично и интенсивно. Держите раунды короткими и отдыхайте между ними."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bhastrika（风箱）：用力鼻吸与鼻呼各约 1 秒。提神且强度高。轮次宜短，中间休息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bhastrika（風箱）：用力鼻吸與鼻呼各約 1 秒。提神且強度高。輪次宜短，中間休息。"
          }
        }
      }
    },
