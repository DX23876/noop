        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O início e o objetivo são iguais"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начало и цель совпадают"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起点与目标相同"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起點與目標相同"
          }
        }
      }
    },
    "Start and target are the same number — there'd be nothing to move toward, so no progress, no route and no arrival date." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start und Ziel sind dieselbe Zahl — es gäbe nichts, worauf du zugehst: kein Fortschritt, keine Route, kein Ankunftsdatum."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start and target are the same number — there'd be nothing to move toward, so no progress, no route and no arrival date."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El inicio y el objetivo son el mismo número: no habría nada hacia lo que avanzar, así que no hay progreso, ni ruta, ni fecha de llegada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le départ et l'objectif sont le même nombre — il n'y aurait rien vers quoi avancer : ni progression, ni itinéraire, ni date d'arrivée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partenza e obiettivo sono lo stesso numero — non ci sarebbe nulla verso cui muoversi: nessun progresso, nessuna rotta, nessuna data di arrivo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartość początkowa i docelowa to ta sama liczba — nie byłoby do czego dążyć, więc nie ma postępu, trasy ani daty dojścia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O início e o objetivo são o mesmo número — não haveria nada para onde avançar: sem progresso, sem rota e sem data de chegada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начало и цель — одно и то же число: двигаться будет не к чему, а значит не будет ни прогресса, ни маршрута, ни даты достижения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起点和目标是同一个数字 — 就没有可前进的方向，因此没有进度、没有路线，也没有达成日期。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起點和目標是同一個數字 — 就沒有可前進的方向，因此沒有進度、沒有路線，也沒有達成日期。"
          }
        }
      }
    },
