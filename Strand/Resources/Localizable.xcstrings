    },
    "This strap sends no raw respiration stream. Your estimated respiratory rate appears on the Health screen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Gurt sendet keinen rohen Atemstrom aus. Ihre geschätzte Atemfrequenz wird auf dem Gesundheitsbildschirm angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This strap sends no raw respiration stream. Your estimated respiratory rate appears on the Health screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta correa no envía ningún flujo de respiración bruta. Su frecuencia respiratoria estimada aparece en la pantalla Salud."
          }
        },
        "fr" : {
          "stringUnit" : {
