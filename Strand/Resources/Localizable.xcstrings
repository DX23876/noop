    "This session's contribution to the day's Effort, as captured during the workout.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Beitrag dieser Sitzung zur Tages-Anstrengung, wie während des Workouts erfasst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La contribución de esta sesión al Esfuerzo del día, tal como se capturó durante el entrenamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La contribution de cette séance à l'Effort du jour, telle que capturée pendant l'entraînement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contributo di questa sessione allo sforzo della giornata, come rilevato durante l'allenamento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A contribuição desta sessão para o esforço do dia, tal como captado durante o treino."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вклад этой тренировки в дневное Усилие, зафиксированный во время тренировки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次会话对当天消耗的贡献，即在锻炼期间所捕获的部分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本次工作階段對當天消耗的貢獻，即在鍛鍊期間所擷取的部分。"
          }
        }
      }
    },
