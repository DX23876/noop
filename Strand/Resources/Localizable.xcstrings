    "Overnight sleep staging, resting heart rate, skin-temperature trend, motion and battery, read straight off the ring." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nächtliche Schlafphasen, Ruheherzfrequenz, Hauttemperatur-Trend, Bewegung und Akku, direkt vom Ring gelesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fases del sueño nocturno, frecuencia cardíaca en reposo, tendencia de temperatura de la piel, movimiento y batería, leídos directamente del anillo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stades du sommeil nocturne, fréquence cardiaque au repos, tendance de la température cutanée, mouvement et batterie, lus directement depuis la bague."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fasi del sonno notturno, frequenza cardiaca a riposo, andamento della temperatura cutanea, movimento e batteria, letti direttamente dall'anello."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocena snu w nocy, tętno spoczynkowe, trend temperatury skóry, ruch i bateria – odczytaj bezpośrednio z ringu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estadiamento do sono noturno, frequência cardíaca em repouso, tendência da temperatura da pele, movimento e bateria, lidos diretamente no anel."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стадии сна за ночь, пульс в покое, динамика температуры кожи, движение и заряд батареи — считываются напрямую с кольца."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜间睡眠分期、静息心率、皮肤温度趋势、运动和电量，直接从戒指读取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜間睡眠分期、靜息心率、皮膚溫度趨勢、運動與電量，直接從戒指讀取。"
          }
        }
      }
    },
    "Overreaching" : {
      "extractionState" : "stale",
      "localizations" : {
