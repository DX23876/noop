    "Pairs directly with your strap over Bluetooth: no WHOOP app, no cloud.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppelt sich direkt über Bluetooth mit deinem Strap: keine WHOOP-App, keine Cloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se empareja directamente con tu pulsera por Bluetooth: sin app de WHOOP, sin nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'associe directement à votre bracelet par Bluetooth : pas d'app WHOOP, pas de cloud."
          }
        },
        "it": {
          "stringUnit": {
