    "This deletes the sessions, sets and exercises NOOP synced from Hevy. Your Hevy account is untouched." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese löscht die von NOOP synchronisierten Sessions, Sets und Übungen von Hevy. Dein Hevy-Konto bleibt unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
