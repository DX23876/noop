    "Stop if dizzy. Avoid with high blood pressure, pregnancy, or recent surgery unless cleared by a clinician." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Schwindel stoppen. Bei Bluthochdruck, Schwangerschaft oder kürzlicher OP nur nach Freigabe durch eine Fachperson."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop if dizzy. Avoid with high blood pressure, pregnancy, or recent surgery unless cleared by a clinician."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para si te mareas. Evítalo con hipertensión, embarazo o cirugía reciente salvo OK clínico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêtez si vertige. Évitez avec hypertension, grossesse ou chirurgie récente sauf feu vert clinique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fermati se hai vertigini. Evita con ipertensione, gravidanza o chirurgia recente salvo OK clinico."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przerwij przy zawrotach. Unikaj przy nadciśnieniu, ciąży lub niedawnej operacji bez zgody klinicznej."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para se tiveres tonturas. Evita com hipertensão, gravidez ou cirurgia recente salvo OK clínico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остановитесь при головокружении. Избегайте при гипертонии, беременности или недавней операции без допуска врача."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "头晕即停。高血压、孕期或近期手术未经临床许可请避免。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "頭暈即停。高血壓、孕期或近期手術未經臨床許可請避免。"
          }
        }
      }
    },
