        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facultatif. Ajoutez une photo et un nom pour l'en-tête d'aujourd'hui. Stocké uniquement sur %@. NOOP est hors ligne, il n'est donc jamais téléchargé."
