          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus bandas definen la zona que se muestra en directo, el reparto por zonas de un entrenamiento y las zonas en las que te planifica tu coach."
          }
        },
        "fr" : {
          "stringUnit" : {
