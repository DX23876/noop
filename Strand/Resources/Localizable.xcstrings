            "state": "translated",
            "value": "Reiniciar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redémarrer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riavvia"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Reiniciar"
          }
        },
        "ru": {
          "stringUnit": {
