    "In and out, but the band won more than it lost." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mal drin, mal draußen, aber der Zielbereich hat öfter gewonnen als verloren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dentro y fuera, pero la zona ganó más de lo que perdió."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans la zone et hors zone, mais la zone l'a emporté plus souvent qu'elle n'a perdu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dentro e fuori, ma la fascia ha vinto più di quanto abbia perso."
