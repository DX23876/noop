            "state": "translated",
            "value": "供應商正在限制要求頻率。請等待 %lld 秒。"
          }
        }
      }
    },
    "The provider returned an error (%lld)%@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
