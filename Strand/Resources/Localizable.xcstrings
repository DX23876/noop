    "Ujjayi (ocean) breath: slightly constrict the throat so the breath sounds like distant waves. Equal slow inhale and exhale through the nose (~4.5s each)." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ujjayi-(Ozean-)Atem: Kehle leicht verengen, sodass der Atem wie ferne Wellen klingt. Gleich langsames Ein- und Ausatmen durch die Nase (~je 4,5 s)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ujjayi (ocean) breath: slightly constrict the throat so the breath sounds like distant waves. Equal slow inhale and exhale through the nose (~4.5s each)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiración Ujjayi (océano): estrecha un poco la garganta para que el aliento suene como olas lejanas. Inhala y exhala iguales y lentos por la nariz (~4,5 s cada uno)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Souffle Ujjayi (océan) : resserrez légèrement la gorge pour que le souffle sonne comme des vagues lointaines. Inspiration et expiration nasales égales et lentes (~4,5 s chacune)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiro Ujjayi (oceano): restringi leggermente la gola così il respiro suona come onde lontane. Inspirazione ed espirazione nasali uguali e lente (~4,5 s ciascuna)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oddech Ujjayi (ocean): lekko zwęż gardło, by oddech brzmiał jak odległe fale. Równy wolny wdech i wydech nosem (~4,5 s każdy)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiração Ujjayi (oceano): aperta ligeiramente a garganta para o fôlego soar como ondas distantes. Inspiração e expiração iguais e lentas pelo nariz (~4,5 s cada)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дыхание Удджайи (океан): слегка сузьте горло, чтобы дыхание звучало как далёкие волны. Равный медленный носовой вдох и выдох (~по 4,5 с)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ujjayi（海洋）呼吸：略收喉，使气息如远浪。鼻吸鼻呼均等缓慢（各约 4.5 秒）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ujjayi（海洋）呼吸：略收喉，使氣息如遠浪。鼻吸鼻呼均等緩慢（各約 4.5 秒）。"
          }
        }
      }
    },
