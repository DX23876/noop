    "Save a full backup to a folder you choose - point it at Google Drive, iCloud or Dropbox for off-device sync.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichere eine vollständige Sicherung in einen Ordner deiner Wahl – richte ihn auf Google Drive, iCloud oder Dropbox für Sync außerhalb des Geräts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda una copia de seguridad completa en la carpeta que elijas: apúntala a Google Drive, iCloud o Dropbox para sincronizar fuera del dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez une sauvegarde complète dans un dossier de votre choix - dirigez-la vers Google Drive, iCloud ou Dropbox pour une synchronisation hors appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva un backup completo in una cartella a tua scelta - indirizzalo a Google Drive, iCloud o Dropbox per la sincronizzazione fuori dal dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde um cópia de segurança completo numa pasta à sua escolha - aponte-o para o Google Drive, iCloud ou Dropbox para tincronização fora do dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните полную резервную копию в выбранную папку — укажите Google Drive, iCloud или Dropbox для синхронизации вне устройства."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将完整备份保存到你选择的文件夹，将它指向 Google Drive、iCloud 或 Dropbox 以进行设备外同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將完整備份保存到你選擇的資料夾，將它指向 Google Drive、iCloud 或 Dropbox 以進行裝置外同步。"
          }
        }
      }
    },
