    "Guarding your session. Silence means you're on track.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Session wird bewacht. Stille bedeutet, du bist auf Kurs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vigilando tu sesión. El silencio significa que vas bien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surveillance de votre séance. Le silence signifie que vous êtes sur la bonne voie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sto monitorando la tua sessione. Il silenzio significa che sei in linea."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Protegendo a tua sessão. Silêncio significa que está no caminho certo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отслеживаем вашу сессию. Тишина означает, что всё идёт по плану."
