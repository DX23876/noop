    "Days with higher %@ tend to be your better-mood days.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tage mit höherem %@ sind tendenziell deine Tage mit besserer Stimmung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los días con %@ más alto suelen ser tus días de mejor ánimo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jours avec un %@ plus élevé ont tendance à être vos jours de meilleure humeur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I giorni con %@ più alto tendono a essere quelli in cui il tuo umore è migliore."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dias com maior %@ tendem a ser dias de melhor humor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дни с более высоким показателем %@ обычно соответствуют лучшему настроению."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 较高的日子，往往是你心情较好的日子。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 較高的日子，往往是你心情較好的日子。"
          }
        }
      }
    },
    "Days with higher %@ tend to be your lower-mood days.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tage mit höherem %@ sind tendenziell deine Tage mit schlechterer Stimmung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los días con %@ más alto suelen ser tus días de peor ánimo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jours avec un %@ plus élevé ont tendance à être vos jours de moins bonne humeur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I giorni con %@ più alto tendono a essere quelli in cui il tuo umore è peggiore."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dias com maior %@ tendem a ser dias de menor humor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дни с более высоким показателем %@ обычно соответствуют более низкому настроению."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 较高的日子，往往是你心情较差的日子。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 較高的日子，往往是你心情較差的日子。"
          }
        }
      }
    },
