    "I understand NOOP is unofficial and experimental, is provided free and \"as is\" with no warranty, and is not a medical device or medical advice." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich verstehe, dass NOOP inoffiziell und experimentell ist, kostenlos und „wie besehen“ ohne Garantie bereitgestellt wird und kein medizinisches Gerät oder medizinischer Rat ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I understand NOOP is unofficial and experimental, is provided free and \"as is\" with no warranty, and is not a medical device or medical advice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entiendo que NOOP no es oficial y es experimental, se proporciona de forma gratuita y \"tal cual\", sin garantía, y no es un dispositivo médico ni un consejo médico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je comprends que NOOP n'est pas officiel et expérimental, est fourni gratuitement et « tel quel », sans garantie, et ne constitue pas un dispositif médical ni un avis médical."
          }
        },
        "it" : {
          "stringUnit" : {
