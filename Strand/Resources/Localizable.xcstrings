    "Choose body measurements and exercise distance separately. Your data is always stored the same way; these settings only change its display." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle Einheiten für Körpermaße und Trainingsdistanz separat. Deine Daten werden immer gleich gespeichert; diese Einstellungen ändern nur die Anzeige."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
