            "state" : "translated",
            "value" : "Twoja waga wzrosła o %@ kg, a taśma poszła w obie strony — jedne miejsca rosną, inne maleją."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu peso subiu %@ kg, e a fita foi nos dois sentidos: alguns pontos a crescer enquanto outros desceram."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш вес вырос на %@ кг, и лента пошла в обе стороны: одни точки растут, другие уменьшаются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的体重上升了 %@ 公斤，皮尺则两个方向都有——有些部位在增长，有些在缩小。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的體重上升了 %@ 公斤，皮尺則兩個方向都有——有些部位在增長，有些在縮小。"
          }
        }
      }
    },
    "Your whole-session RPE × duration. Add it from any workout detail; missing ratings are never guessed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE der gesamten Einheit × Dauer. Füge sie in jeder Trainingsansicht hinzu; fehlende Bewertungen werden nie geschätzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE de toda la sesión × duración. Añádela desde cualquier detalle de entrenamiento; las valoraciones que faltan nunca se estiman."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE de la séance entière × durée. Ajoutez-la depuis le détail d'un entraînement ; les notes manquantes ne sont jamais estimées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE dell'intera sessione × durata. Aggiungilo dai dettagli di qualsiasi allenamento; i dati mancanti non vengono stimati."
