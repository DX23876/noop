    "Tip: choose a folder in iCloud Drive and your backups sync to all your Apple devices automatically, no account setup needed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipp: Wähle einen Ordner in iCloud Drive, und deine Sicherungen synchronisieren automatisch auf alle deine Apple-Geräte, ohne Kontoeinrichtung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consejo: elige una carpeta en iCloud Drive y tus respaldos se sincronizan automáticamente en todos tus dispositivos Apple, sin configurar ninguna cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astuce : choisissez un dossier dans iCloud Drive et vos sauvegardes se synchronisent automatiquement sur tous vos appareils Apple, sans configuration de compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggerimento: scegli una cartella in iCloud Drive e i tuoi backup si sincronizzeranno automaticamente su tutti i tuoi dispositivi Apple, senza configurazione di account."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wskazówka: wybierz folder na iCloud Drive, a Twoje kopie zapasowe zostaną automatycznie zsynchronizowane ze wszystkimi urządzeniami Apple, bez konieczności zakładania konta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dica: escolha uma pasta no iCloud Drive e os teus cópia de seguranças serão sincronizados com todos os teus dispositivos Apple automaticamente, sem necessidade de configuração de conta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Совет: выберите папку в iCloud Drive, и ваши резервные копии будут автоматически синхронизироваться на всех устройствах Apple без дополнительной настройки аккаунта."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提示：选择 iCloud 云盘中的一个文件夹，你的备份就会自动同步到你所有的 Apple 设备，无需设置账户。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提示：選擇 iCloud 雲碟中的一個資料夾，你的備份就會自動同步到你所有的 Apple 裝置，無需設定帳戶。"
          }
        }
      }
    },
    "Tip: the share sheet can save the PDF to Files, AirDrop it, or send it on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipp: Über das Teilen-Blatt kannst du das PDF in „Dateien“ sichern, per AirDrop senden oder weiterleiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consejo: la hoja de compartir puede guardar el PDF en Archivos, enviarlo por AirDrop o reenviarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astuce : le menu de partage permet d'enregistrer le PDF dans Fichiers, de l'envoyer par AirDrop ou de le transférer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggerimento: il foglio di condivisione può salvare il PDF in File, inviarlo via AirDrop o inoltrarlo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wskazówka: arkusz udostępniania umożliwia zapisanie pliku PDF w Plikach, upuszczenie go za pomocą funkcji AirDrop lub przesłanie dalej."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dica: a folha de partilha pode guardar o PDF em Ficheiros, AirDrop ou enviá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Совет: меню «Поделиться» позволяет сохранить PDF в Файлы, отправить через AirDrop или переслать дальше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提示：分享面板可以将 PDF 保存到「文件」、通过隔空投送发送，或转发出去。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提示：分享面板可以將 PDF 保存到「檔案」、透過 AirDrop 發送，或轉發出去。"
          }
        }
      }
