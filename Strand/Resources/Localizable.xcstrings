    "%lld of them frame every reply — injuries and hard constraints you'd have to tell the coach again. There is no undo, and no archive." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld davon prägen jede Antwort — Verletzungen und harte Einschränkungen, die du dem Coach erneut sagen müsstest. Es gibt kein Zurück und kein Archiv."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld of them frame every reply — injuries and hard constraints you'd have to tell the coach again. There is no undo, and no archive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld de ellos enmarcan cada respuesta: lesiones y limitaciones que tendrías que volver a contarle al coach. No hay deshacer ni archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld d'entre eux encadrent chaque réponse — blessures et contraintes que vous devriez redire au coach. Il n'y a ni annulation ni archive."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld di questi inquadrano ogni risposta: infortuni e vincoli che dovresti raccontare di nuovo al coach. Non c'è modo di annullare, né un archivio."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld z nich kształtuje każdą odpowiedź — kontuzje i twarde ograniczenia, o których musiałbyś powiedzieć trenerowi ponownie. Nie ma cofania ani archiwum."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld deles enquadram cada resposta — lesões e limitações que terias de contar de novo ao coach. Não há forma de anular, nem arquivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld из них влияют на каждый ответ — травмы и жёсткие ограничения, о которых придётся рассказать тренеру заново. Отмены нет, архива тоже."
          }
        },
        "zh-Hans" : {
