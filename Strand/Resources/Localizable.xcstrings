          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As pontuações de prontidão e sono da própria Oura. O NOOP não os copia. Ele calcula o teu próprio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собственные показатели Oura Readiness и Sleep. NOOP их не копирует. Он рассчитывает свои собственные."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Oura 自己的准备度和睡眠分数。NOOP 不会照搬它们，而是自行计算。"
