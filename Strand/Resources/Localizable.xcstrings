        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一扇通往你恢復、睡眠與強度的私密窗口，直接從手環讀取，只保存在 %@ 上。"
          }
        }
      }
    },
    "A quick nudge": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kurzer Hinweis"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A quick nudge"
          }
        },
        "es": {
          "stringUnit": {
