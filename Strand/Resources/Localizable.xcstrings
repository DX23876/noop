        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En qué destaca tu reloj, dónde es menos preciso que una banda de pecho, y qué tan seguro está NOOP."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce en quoi votre montre excelle, où elle est plus légère qu'une ceinture pectorale, et le degré de confiance de NOOP."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In cosa eccelle il tuo orologio, dove è più carente di una fascia toracica e quanto NOOP ne è sicuro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Em que o teu relógio é excelente, onde é mais leve que uma bracelete torácica e quão seguro é o NOOP."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В чём хороши ваши часы, где они уступают нагрудному датчику и насколько уверен NOOP."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的手表擅长什么，在哪些方面比胸带更薄弱，以及 NOOP 有多确定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的手錶擅長什麼，在哪些方面比胸帶更薄弱，以及 NOOP 有多確定。"
          }
        }
      }
    },
