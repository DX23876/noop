    "Never practice in water or while driving. Stop if dizzy. Not medical advice." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie im Wasser oder beim Fahren üben. Bei Schwindel stoppen. Keine medizinische Beratung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Never practice in water or while driving. Stop if dizzy. Not medical advice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca practiques en el agua ni conduciendo. Para si te mareas. No es consejo médico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne pratiquez jamais dans l’eau ni en conduisant. Arrêtez si vertige. Pas un avis médical."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non praticare in acqua né alla guida. Fermati se hai vertigini. Non è un consiglio medico."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nigdy nie ćwicz w wodzie ani podczas jazdy. Przerwij przy zawrotach. To nie porada medyczna."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca pratiques na água nem a conduzir. Para se tiveres tonturas. Não é aconselhamento médico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Никогда не практикуйте в воде или за рулём. Остановитесь при головокружении. Не медицинский совет."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切勿在水中或驾驶时练习。头晕即停。非医疗建议。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切勿在水中或駕駛時練習。頭暈即停。非醫療建議。"
          }
        }
      }
    },
    "Never push into panic or strong air hunger." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie in Panik oder starken Luftwunsch treiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
