    "Put the band into pairing mode, on your wrist and awake.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versetze das Band in den Kopplungsmodus, am Handgelenk und wach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon la banda en modo de emparejamiento, en tu muñeca y activa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez la bande en mode d'appairage, à votre poignet et activée."
          }
        },
