        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non c'è modo di annullare, né un archivio. Il coach ricomincia da zero."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie ma cofania ani archiwum. Trener zaczyna od zera."
