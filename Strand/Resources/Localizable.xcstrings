          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已填入你上次的数据。今天有变化的地方改一下就行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
