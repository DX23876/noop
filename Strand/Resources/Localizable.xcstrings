    "Its story below stays yours. A new goal is one tap away in Coach settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Geschichte unten bleibt deine. Ein neues Ziel ist in den Coach-Einstellungen einen Tipp entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its story below stays yours. A new goal is one tap away in Coach settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su historia abajo sigue siendo tuya. Un nuevo objetivo está a un toque en los ajustes del Coach."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son histoire ci-dessous reste la tienne. Un nouvel objectif est à un geste dans les réglages du Coach."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sua storia qui sotto rimane tua. Un nuovo obiettivo è a portata di tocco nelle impostazioni Coach."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A história abaixo permanece sua. Uma nova meta está a um toque de distância nas configurações de Coach."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его история ниже останется вашей. Новая цель — одним касанием в настройках Coach."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下面的故事就留给你了。只需在 Coach 设置中轻按一下即可设定新目标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下面的故事就留給你了。只需在 Coach 設定中輕按一下即可設定新目標。"
          }
        }
      }
    },
