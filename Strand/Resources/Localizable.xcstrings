    "Alternate Nostril" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechselnasenatmung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternate Nostril"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fosa alterna"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Narine alternée"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nari alternata"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naprzemienne nozdrza"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Narina alternada"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поочерёдные ноздри"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "交替鼻孔"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "交替鼻孔"
          }
        }
      }
    },
    "Alternate-nostril breathing: inhale left, hold, exhale right, inhale right, hold, exhale left — about 4 seconds each step. Use a finger to gently close one nostril at a time. Labels cue which side; go at a calm pace." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechselnasenatmung: links ein, halten, rechts aus, rechts ein, halten, links aus — je ca. 4 Sekunden. Mit einem Finger sanft ein Nasenloch schließen. Labels zeigen die Seite; ruhiges Tempo."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternate-nostril breathing: inhale left, hold, exhale right, inhale right, hold, exhale left — about 4 seconds each step. Use a finger to gently close one nostril at a time. Labels cue which side; go at a calm pace."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiración por fosas alternas: inhala izquierda, mantén, exhala derecha, inhala derecha, mantén, exhala izquierda — unos 4 s por paso. Cierra suavemente una fosa con un dedo. Las etiquetas indican el lado; ve con calma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiration narine alternée : inspire gauche, retenez, expire droite, inspire droite, retenez, expire gauche — environ 4 s par étape. Fermez doucement une narine avec un doigt. Les labels indiquent le côté ; rythme calme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiro a nari alternate: ispira sinistra, trattieni, espira destra, ispira destra, trattieni, espira sinistra — circa 4 s per passo. Chiudi dolcemente una narice con un dito. Le etichette indicano il lato; ritmo calmo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oddychanie naprzemiennymi nozdrzami: wdech lewy, wstrzymaj, wydech prawy, wdech prawy, wstrzymaj, wydech lewy — ok. 4 s na krok. Delikatnie zamykaj nozdrze palcem. Etykiety wskazują stronę; spokojne tempo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiração de narina alternada: inspira esquerda, segura, expira direita, inspira direita, segura, expira esquerda — cerca de 4 s por passo. Fecha suavemente uma narina com um dedo. As etiquetas indicam o lado; ritmo calmo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дыхание поочерёдными ноздрями: вдох слева, задержка, выдох справа, вдох справа, задержка, выдох слева — около 4 с на шаг. Мягко закрывайте одну ноздрю пальцем. Подписи подсказывают сторону; спокойный темп."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "交替鼻孔呼吸：左吸、屏、右呼、右吸、屏、左呼——每步约 4 秒。用手指轻关一侧鼻孔。标签提示左右；保持平静节奏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "交替鼻孔呼吸：左吸、屏、右呼、右吸、屏、左呼——每步約 4 秒。用手指輕關一側鼻孔。標籤提示左右；保持平靜節奏。"
          }
        }
      }
    },
    "AltStore or SideStore can install it for you automatically if you added NOOP's source; a direct .ipa still has to be signed on your device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AltStore oder SideStore installieren es automatisch für dich, wenn du NOOPs Quelle hinzugefügt hast; eine direkte .ipa muss weiterhin auf deinem Gerät signiert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AltStore or SideStore can install it for you automatically if you added NOOP's source; a direct .ipa still has to be signed on your device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AltStore o SideStore pueden instalarla automáticamente si añadiste la fuente de NOOP; un .ipa directo aún debe firmarse en tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AltStore ou SideStore peuvent l'installer automatiquement si vous avez ajouté la source de NOOP ; un .ipa direct doit toujours être signé sur votre appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AltStore o SideStore possono installarla automaticamente se hai aggiunto la sorgente di NOOP; un .ipa diretto deve comunque essere firmato sul tuo dispositivo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AltStore lub SideStore zainstalują ją automatycznie, jeśli dodano źródło NOOP; bezpośredni plik .ipa nadal trzeba podpisać na urządzeniu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AltStore ou o SideStore podem instalá-la automaticamente se adicionou a fonte do NOOP; um .ipa direto continua a ter de ser assinado no seu dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AltStore или SideStore установят её автоматически, если вы добавили источник NOOP; прямой .ipa всё равно нужно подписать на устройстве."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你添加了 NOOP 的源，AltStore 或 SideStore 可以自动为你安装；直接下载的 .ipa 仍需在设备上签名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你加入了 NOOP 的來源，AltStore 或 SideStore 可以自動為你安裝；直接下載的 .ipa 仍需在裝置上簽名。"
          }
        }
      }
    },
    "Always" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immer"
          }
        },
