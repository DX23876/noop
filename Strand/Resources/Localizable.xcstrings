    "%lld logged caffeines are past your bedtime cutoff. They may still be on board and keep you up. Just a timing heads-up." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld erfasste Koffein-Einnahmen liegen nach deiner Schlafenszeit-Grenze. Sie können noch wirken und dich wachhalten. Nur ein Hinweis zum Timing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld cafeínas registradas pasan tu hora límite antes de dormir. Puede que sigan en tu sistema y te mantengan despierto. Solo un aviso de horario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld prises de caféine enregistrées dépassent votre limite avant le coucher. Elles peuvent encore agir et vous empêcher de dormir. Juste un avertissement sur le timing."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld caffeine registrate superano il tuo limite prima di dormire. Potrebbero essere ancora in circolo e tenerti sveglio. Solo un avviso sui tempi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zarejestrowana ilość kofeiny %lld przekroczyła limit pory snu. Mogą nadal być na pokładzie i utrzymać Cię na wodzy. Tylko informacja o czasie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld cafeínas registadas já passaram o limite da hora de deitar. Podem ainda estar a bordo e mantê-lo acordado. Apenas um aviso de tempo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld отмеченных приёмов кофеина позже вашего порога отхода ко сну. Кофеин может ещё действовать и мешать уснуть. Просто предупреждение о времени."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 条咖啡因记录已超过你的睡前截止时间。它们可能仍在起效，让你难以入睡。只是个时间提醒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有 %lld 筆咖啡因記錄超過了你的就寢截止時間。它們可能還在體內作用，讓你睡不著。只是提醒你留意時間。"
          }
        }
      }
    },
    "%lld logged days" : {
      "localizations" : {
