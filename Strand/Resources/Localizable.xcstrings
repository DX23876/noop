    "Connect your strap. Calm me is a felt rhythm on the wrist, so it needs a bonded connection.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde deinen Strap. „Beruhige mich“ ist ein spürbarer Rhythmus am Handgelenk und braucht daher eine gekoppelte Verbindung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta tu pulsera. Cálmame es un ritmo que se siente en la muñeca, así que necesita una conexión vinculada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez votre bracelet. Apaisez-moi est un rythme ressenti au poignet, cela nécessite donc une connexion associée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega la tua fascia, Calmami è un ritmo percepito sul polso, quindi necessita di una connessione associata."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligue a tua bracelete. Acalmar é um ritmo sentido no pulso, por isso precisa de uma ligação forte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите браслет. Функция «Успокоить меня» — это тактильный ритм на запястье, поэтому нужно привязанное соединение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接你的手环 ，「让我平静」是手腕上可感知的节律，因此需要已绑定的连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接你的手環 ，「讓我平靜」是手腕上可感知的節律，因此需要已綁定的連接。"
          }
        }
      }
    },
