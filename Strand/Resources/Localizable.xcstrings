    "Changed on %@. Days before that keep the formula that applied then — a switch never rewrites history." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gewechselt am %@. Frühere Tage behalten die damals gültige Formel — ein Wechsel schreibt nie Historie um."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiada el %@. Los días anteriores conservan la fórmula que regía entonces: un cambio nunca reescribe el historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changée le %@. Les jours antérieurs conservent la formule alors en vigueur : un changement ne réécrit jamais l'historique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiata il %@. I giorni precedenti mantengono la formula allora in vigore: un cambio non riscrive mai lo storico."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmieniono %@. Wcześniejsze dni zachowują obowiązującą wtedy formułę — zmiana nigdy nie przepisuje historii."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterada a %@. Os dias anteriores mantêm a fórmula então em vigor: uma mudança nunca reescreve o histórico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изменено %@. Предыдущие дни сохраняют действовавшую тогда формулу: смена никогда не переписывает историю."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "于 %@ 更改。之前的日期保留当时适用的公式——切换绝不改写历史。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "於 %@ 更改。之前的日期保留當時適用的公式——切換絕不改寫歷史。"
          }
        }
      }
    },
    "Changes could not be saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Änderungen konnten nicht gespeichert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changes could not be saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se han podido guardar los cambios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modifications n'ont pas pu être enregistrées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile salvare le modifiche."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się zapisać zmian."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As alterações não puderam ser guardadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось сохранить изменения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法保存更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法儲存變更。"
          }
        }
      }
    },
    "Changes the Bluetooth name your WHOOP 4.0 advertises (what you see when pairing). The strap reboots to apply, so the new name appears the next time it connects. WHOOP 4.0 only." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändert den Bluetooth-Namen, den dein WHOOP 4.0 sendet (was du beim Koppeln siehst). Der Strap startet zum Übernehmen neu, der neue Name erscheint also bei der nächsten Verbindung. Nur WHOOP 4.0."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia el nombre Bluetooth que anuncia tu WHOOP 4.0 (lo que ves al emparejar). La pulsera se reinicia para aplicarlo, así que el nuevo nombre aparece la próxima vez que se conecte. Solo WHOOP 4.0."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifie le nom Bluetooth annoncé par votre WHOOP 4.0 (celui que vous voyez lors de l'appairage). Le bracelet redémarre pour appliquer le changement, le nouveau nom apparaît donc à la prochaine connexion. WHOOP 4.0 uniquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia il nome Bluetooth diffuso dal tuo WHOOP 4.0, quello che vedi durante l'associazione. La fascia si riavvia per applicarlo, quindi il nuovo nome appare alla connessione successiva. Solo WHOOP 4.0."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmienia nazwę Bluetooth reklamowaną przez WHOOP 4.0 (którą widzisz podczas parowania). Pasek uruchamia się ponownie, aby zastosować, więc nowa nazwa pojawi się przy następnym połączeniu. Tylko WHOOP 4.0."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altera o nome do Bluetooth anunciado pelo WHOOP 4.0 (o que vê durante o emparelhamento). A bracelete é reiniciada para ser aplicada, pelo que o novo nome aparece na próxima vez que for ligado. Apenas WHOOP 4.0."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меняет Bluetooth-имя, которое транслирует ваш WHOOP 4.0 (то, что вы видите при сопряжении). Браслет перезагрузится, чтобы применить изменение, поэтому новое имя появится при следующем подключении. Только для WHOOP 4.0."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改你的 WHOOP 4.0 广播的蓝牙名称，即你配对时看到的名称。手环会重启以应用更改，因此新名称会在它下次连接时出现。仅限 WHOOP 4.0。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "變更你的 WHOOP 4.0 廣播的藍牙名稱，即你配對時看到的名稱。手環會重啟以套用變更，因此新名稱會在它下次連接時出現。僅限 WHOOP 4.0。"
          }
        }
      }
    },
    "Changes to this goal" : {
