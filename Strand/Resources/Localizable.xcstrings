    "Other metrics (R-R, frames, battery, history) need a full sync.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Metriken (R-R, Frames, Akku, Verlauf) brauchen eine volle Synchronisierung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otras métricas (R-R, tramas, batería, historial) necesitan una sincronización completa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres métriques (R-R, trames, batterie, historique) nécessitent une synchronisation complète."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altri parametri (R-R, frame, batteria, cronologia) richiedono una sincronizzazione completa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Outras métricas (RR, frames, bateria, histórico) necessitam de uma sincronização completa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для других показателей (R-R, кадры, батарея, история) нужна полная синхронизация."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他指标（R-R、帧、电量、历史）需要一次完整同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他指標（R-R、幀、電量、歷史）需要一次完整同步。"
          }
        }
      }
    },
    "Other sources don’t offload raw per-second data on-device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Quellen übertragen keine rohen Sekundendaten auf das Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otras fuentes no descargan datos en bruto por segundo en el dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres sources ne déchargent pas de données brutes par seconde sur l'appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altre sorgenti non scaricano dati grezzi al secondo sul dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Outras fontes não descarregam dados brutos por segundo para o dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другие источники не выгружают необработанные посекундные данные на устройство."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他来源不会在设备上卸载原始的逐秒数据。"
          }
        },
