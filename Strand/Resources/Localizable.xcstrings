    "Baselines are learned on-device over your first 14 days. Until then, typical ranges apply.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Basislinien werden in deinen ersten 14 Tagen auf dem Gerät gelernt. Bis dahin gelten typische Bereiche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las líneas base se aprenden en el dispositivo durante tus primeros 14 días. Hasta entonces se aplican rangos típicos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les références sont apprises sur l'appareil pendant vos 14 premiers jours. En attendant, des plages types s'appliquent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le linee di base vengono apprese sul dispositivo durante i tuoi primi 14 giorni, fino ad allora si applicano intervalli tipici."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As linhas de base são aprendidas no dispositivo durante os primeiros 14 dias. Até lá, aplicam-se intervalos típicos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нормы формируются на устройстве в течение первых 14 дней. До этого применяются типичные диапазоны."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基线会在你最初的 14 天内于设备本地学习得出，在那之前，采用典型范围。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "基線會在你最初的 14 天內於裝置本地學習得出，在那之前，採用典型範圍。"
          }
        }
      }
    },
