    "Consistency compares your recent bedtimes — a wide spread scores low, even after a good night." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konsistenz vergleicht deine letzten Einschlafzeiten — eine große Streuung ergibt einen niedrigen Wert, auch nach einer guten Nacht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consistency compares your recent bedtimes — a wide spread scores low, even after a good night."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La constancia compara tus horas de acostarte recientes: una dispersión amplia da una puntuación baja, incluso después de una buena noche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La régularité compare vos heures de coucher récentes — un grand écart donne un score bas, même après une bonne nuit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La coerenza confronta le tue ultime ore di andare a dormire: uno spread ampio ottiene un punteggio basso, anche dopo una buona notte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regularność porównuje Twoje ostatnie pory zasypiania — duży rozrzut daje niski wynik, nawet po dobrze przespanej nocy."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A consistência compara suas horas de dormir recentes – uma ampla pontuação é baixa, mesmo depois de uma boa noite."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Последовательность сравнивает время сна в последнее время — широкий разброс имеет низкую оценку даже после спокойной ночи."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一致性会比较您最近的就寝时间——即使在度过了一个美好的夜晚之后，大多数人的得分都较低。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一致性會比較您最近的就寢時間——即使在度過了一個美好的夜晚之後，大多數人的得分都較低。"
          }
        }
      }
    },
