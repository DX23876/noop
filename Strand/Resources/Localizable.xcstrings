    "Optional exercise media has not been downloaded. Logging works without it and media is never copied into workout history." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optionale Übungsmedien wurden nicht geladen. Training funktioniert ohne sie und Medien werden nie in den Trainingsverlauf kopiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha descargado el contenido multimedia opcional. El registro funciona sin él y nunca se copia en el historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les médias d’exercice facultatifs ne sont pas téléchargés. L’enregistrement fonctionne sans eux et ils ne sont jamais copiés dans l’historique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I contenuti multimediali facoltativi non sono stati scaricati. La registrazione funziona senza e non vengono mai copiati nella cronologia."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcjonalne multimedia ćwiczeń nie zostały pobrane. Rejestrowanie działa bez nich i nie są one kopiowane do historii treningów."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os meios opcionais de exercício não foram transferidos. O registo funciona sem eles e nunca são copiados para o histórico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Необязательные медиа упражнений не загружены. Журнал работает без них, и медиа никогда не копируются в историю тренировок."
