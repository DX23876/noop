    "%@ No clear relationship. They move largely independently.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Kein klarer Zusammenhang. Sie bewegen sich weitgehend unabhängig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Sin relación clara. Se mueven de forma mayormente independiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Aucune relation claire. Elles évoluent en grande partie de façon indépendante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Nessuna relazione chiara. Si muovono in gran parte in modo indipendente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Sem relação clara. Movem-se em grande parte de forma independente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Чёткой связи нет. Показатели меняются в основном независимо друг от друга."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有明显关系。两者基本各自独立变化。"
