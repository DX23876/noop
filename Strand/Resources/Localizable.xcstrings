    "Several recovery signals are down. Prioritise rest today.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehrere Erholungswerte sind gesunken. Priorisiere heute Ruhe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Varias señales de recuperación están bajas. Prioriza el descanso hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusieurs signaux de récupération sont en baisse. Priorisez le repos aujourd'hui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Diversi segnali di recupero sono bassi. Dai priorità al riposo oggi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Vários sinais de recuperação caíram. Dê prioridade ao descanso hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Несколько показателей восстановления снижены. Сегодня отдайте приоритет отдыху."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多项恢复指标偏低。今天请优先休息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "多項恢復指標偏低。今天請優先休息。"
          }
        }
      }
    },
    "Several signals are down at once. Treat today as recovery - easy movement, real sleep tonight.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehrere Werte sind gleichzeitig gesunken. Behandle heute als Erholungstag - leichte Bewegung, heute Nacht echter Schlaf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Varias señales han bajado a la vez. Trata hoy como un día de recuperación: movimiento suave, sueño de verdad esta noche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusieurs signaux sont en baisse en même temps. Traitez aujourd'hui comme un jour de récupération : mouvement léger, vrai sommeil ce soir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Diversi segnali sono scesi insieme. Tratta oggi come un giorno di recupero: movimento leggero, sonno vero stanotte."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Vários sinais caíram ao mesmo tempo. Trate o dia de hoje como uma recuperação – movimentos fáceis, sono a sério esta noite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сразу несколько показателей снижены. Считайте сегодняшний день восстановительным — лёгкая активность и полноценный сон этой ночью."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多项指标同时下降。请把今天当作恢复日——轻度活动，今晚保证真正的睡眠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "多項指標同時下降。請把今天當作恢復日——輕度活動，今晚保證真正的睡眠。"
          }
        }
      }
    },
