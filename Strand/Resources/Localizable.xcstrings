    "WHOOP 5.0 / MG supports live data and strap history. Protocol-research tools are available separately in Test Centre." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WHOOP 5.0/MG unterstützt Live-Daten und Bandverlauf. Protokollwerkzeuge sind separat im Testcenter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WHOOP 5.0/MG admite datos en directo e historial. Las herramientas de protocolo están aparte en el Centro de pruebas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WHOOP 5.0/MG gère les données en direct et l’historique. Les outils de protocole sont séparés dans le Centre de test."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WHOOP 5.0/MG supporta i dati in tempo reale e la cronologia della fascia. Gli strumenti di ricerca sul protocollo sono separati nel Centro test."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WHOOP 5.0/MG obsługuje dane na żywo i historię paska. Narzędzia badawcze protokołu są dostępne osobno w Centrum Testowym."
