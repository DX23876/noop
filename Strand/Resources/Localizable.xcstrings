    "Total, active and basal calories for today, with an honest projection." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesamter, aktiver und basaler Kalorienverbrauch für heute – mit ehrlicher Prognose."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total, active and basal calories for today, with an honest projection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calorías totales, activas y basales de hoy, con una proyección clara."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calories totales, actives et basales du jour, avec une projection transparente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calorie totali, attive e basali di oggi, con una proiezione trasparente."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzisiejsze kalorie całkowite, aktywne i podstawowe wraz z uczciwą prognozą."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calorias totais, ativas e basais de hoje, com uma projeção transparente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Общий, активный и базовый расход калорий за сегодня с прозрачным прогнозом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天的总消耗、活动消耗和基础消耗，并提供如实预测。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天的總消耗、活動消耗和基礎消耗，並提供如實預測。"
          }
        }
      }
    },
    "Track a workout manually. Records heart rate and effort until you end it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichne ein Workout manuell auf. Erfasst Herzfrequenz und Belastung, bis du es beendest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra un entrenamiento manualmente. Guarda la frecuencia cardíaca y el esfuerzo hasta que lo termines."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez un entraînement manuellement. Enregistre la fréquence cardiaque et l'effort jusqu'à ce que vous le terminiez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traccia un allenamento manualmente, registra frequenza cardiaca e sforzo finché non lo termini."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Śledź trening ręcznie. Rejestruje tętno i wysiłek, dopóki go nie zakończysz."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acompanhe um treino manualmente. Regista a frequência cardíaca e o esforço até o terminar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записывайте тренировку вручную. Фиксирует пульс и усилие, пока вы её не завершите."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手动追踪一次锻炼，记录心率和消耗，直到你结束它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手動追蹤一次鍛鍊，記錄心率和消耗，直到你結束它。"
          }
        }
      }
    },
