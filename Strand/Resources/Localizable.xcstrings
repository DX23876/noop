        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca empujes hasta el pánico o una fuerte falta de aire."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne poussez jamais jusqu’à la panique ou une forte soif d’air."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non spingere mai fino al panico o a una forte fame d’aria."
