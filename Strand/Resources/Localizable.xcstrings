    "%@: %lld working sets a week, against your recent average of %@. That is a big step up — deliberate is fine, accidental is worth a second look." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %lld Arbeitseinheiten pro Woche, im Vergleich zu deinem aktuellen Durchschnitt von %@. Das ist ein großer Schritt – bewusst ist das in Ordnung, zufällig ist eine zweite Sicht nötig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$lld working sets a week, against your recent average of %3$@. That is a big step up — deliberate is fine, accidental is worth a second look."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %lld sesiones de trabajo a la semana, frente a tu promedio reciente de %@. Es un paso importante — la intención es válida, pero si fue accidental, revisa bien."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %lld séries de travail par semaine, contre votre moyenne récente de %@. C’est un grand pas — la concentration est clé, mais une augmentation imprévue mérite une attention particulière."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %lld allenamenti a settimana, rispetto alla tua media recente di %@. È un passo importante — intenzionale va bene, involontario merita una seconda occhiata."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %lld sesji pracy w tygodniu, względem ostatnich średnich %@. To znaczące zaangażowanie — celowe jest dobrze, ale przypadkowe wymaga dokładniejszego rozważenia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %lld séries de trabalho por semana, contra sua média recente de %@. Isso é um grande avanço — a intenção é boa, mas vale a pena revisar se foi acidental."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %lld рабочих сессий в неделю, против вашего последнего среднего значения %@. Это большой шаг — намеренно — хорошо, случайно — стоит пересмотреть."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@数字 :%lld工作周期为一周, 相对于您最近的平均值%@这是向前迈出的一大步——故意是好的,偶然是值得一看的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@數字 :%lld工作週期為一週, 相對於您最近的平均值%@這是向前邁出的一大步——故意是好的,偶然是值得一看的。"
          }
        }
      }
    },
