    "Record a timestamped moment (and buzz the strap if it's connected).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte einen Moment mit Zeitstempel fest (und lass den Strap vibrieren, wenn er verbunden ist)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra un momento con marca de tiempo (y hace vibrar la pulsera si está conectada)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez un moment horodaté (et faites vibrer le bracelet s'il est connecté)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra un momento con marca temporale (e fai vibrare la fascia se è connessa)."
