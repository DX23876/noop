    "Ask about your charge, effort, rest and workouts, grounded in your own numbers.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frage nach deiner Ladung, Anstrengung, Ruhe und deinen Workouts, basierend auf deinen eigenen Zahlen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta sobre tu carga, esfuerzo, descanso y entrenamientos, basados en tus propios números."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez des questions sur votre charge, votre effort, votre repos et vos entraînements, basées sur vos propres chiffres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi della tua carica, dello sforzo, del riposo e degli allenamenti, basandoti sui tuoi numeri."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte sobre a tua carga, esforço, descanso e treinos, com base nos teus próprios números."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спрашивайте о вашем заряде, усилии, отдыхе и тренировках — на основе ваших собственных данных."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "询问你的能量、消耗、休息和锻炼，一切都基于你自己的数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "詢問你的能量、消耗、休息和鍛鍊，一切都基於你自己的數據。"
          }
        }
      }
    },
