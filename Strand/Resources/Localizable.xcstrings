    "Connect your strap to sync its stored history. Until then, only imported data shows here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde deinen Strap, um seinen gespeicherten Verlauf zu synchronisieren. Bis dahin erscheinen hier nur importierte Daten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta tu pulsera para sincronizar su historial almacenado. Hasta entonces, aquí solo se muestran los datos importados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez votre bracelet pour synchroniser son historique stocké. En attendant, seules les données importées s'affichent ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega la tua fascia per sincronizzare la cronologia memorizzata. Fino ad allora, qui compaiono solo i dati importati."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligue a tua bracelete para tincronizar o histórico armazenado. Até lá, apenas os dados importados são aqui apresentados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите браслет, чтобы синхронизировать сохранённую историю. До этого здесь отображаются только импортированные данные."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接手环以同步其存储的历史数据。在此之前，这里只显示导入的数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接你的手環以同步其儲存的歷史資料。在那之前，這裡只會顯示匯入的資料。"
          }
        }
