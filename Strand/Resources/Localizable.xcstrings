    "Choose the equipment you can use. The exercise library can then show matching exercises. If nothing is selected, every exercise remains available." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle die Ausrüstung, die du nutzen kannst. Die Übungsbibliothek kann dann passende Übungen anzeigen. Ist nichts ausgewählt, bleiben alle Übungen verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige el equipamiento que puedes usar. La biblioteca de ejercicios podrá mostrar los ejercicios adecuados. Si no seleccionas nada, todos los ejercicios siguen disponibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez l'équipement dont vous disposez. La bibliothèque d'exercices peut alors afficher les exercices correspondants. Si rien n'est sélectionné, tous les exercices restent disponibles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli l'attrezzatura che puoi usare. La libreria degli esercizi potrà così mostrare gli esercizi adatti. Se non selezioni nulla, tutti gli esercizi restano disponibili."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz sprzęt, z którego możesz korzystać. Biblioteka ćwiczeń pokaże wtedy pasujące ćwiczenia. Jeśli nic nie wybierzesz, wszystkie ćwiczenia pozostaną dostępne."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
