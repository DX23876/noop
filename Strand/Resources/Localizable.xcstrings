          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOOP 如何将夜晚分为浅色/深色/快速眼动睡眠。 V2配方为默认配方；关闭它以回退到较旧的 V1 阶段。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
