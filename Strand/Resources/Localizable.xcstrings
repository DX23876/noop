    "Just below the larynx, tape sloping slightly down at the front. Do not flex." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knapp unterhalb des Kehlkopfs, Band vorne leicht abfallend. Nicht anspannen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Justo debajo de la laringe, con la cinta ligeramente inclinada hacia abajo por delante. No contraigas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juste sous le larynx, mètre légèrement incliné vers le bas à l'avant. Ne contractez pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appena sotto la laringe, metro leggermente inclinato verso il basso davanti. Non contrarre."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuż poniżej krtani, taśma z przodu lekko opadająca. Nie napinaj."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logo abaixo da laringe, com a fita ligeiramente inclinada para baixo à frente. Não contraia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чуть ниже гортани, лента спереди слегка наклонена вниз. Не напрягайтесь."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在喉结正下方，皮尺前侧略向下倾斜。不要发力。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在喉結正下方，皮尺前側略向下傾斜。不要發力。"
          }
        }
      }
    },
