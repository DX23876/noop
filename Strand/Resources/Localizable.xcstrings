          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый показатель, в одном касании."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一个信号，轻点即达。"
          }
        },
