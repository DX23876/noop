    "Training, routines, workout logging and analytics work fully without media. You can delete the downloaded files at any time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Training, Routinen, Workout-Erfassung und Analysen funktionieren vollständig ohne Medien. Du kannst die heruntergeladenen Dateien jederzeit löschen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El entrenamiento, las rutinas, el registro de entrenamientos y los análisis funcionan por completo sin contenido multimedia. Puedes borrar los archivos descargados cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'entraînement, les routines, l'enregistrement des séances et les analyses fonctionnent entièrement sans médias. Vous pouvez supprimer les fichiers téléchargés à tout moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allenamento, routine, registrazione degli allenamenti e analisi funzionano perfettamente senza contenuti multimediali. Puoi eliminare i file scaricati in qualsiasi momento."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trening, rutyny, zapis treningów i analizy działają w pełni bez multimediów. Pobrane pliki możesz usunąć w dowolnej chwili."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O treino, as rotinas, o registo de treinos e as análises funcionam totalmente sem multimédia. Pode apagar os ficheiros transferidos a qualquer momento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренировки, программы, запись занятий и аналитика полностью работают без медиа. Загруженные файлы можно удалить в любой момент."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "训练、训练计划、训练记录和分析在没有媒体的情况下也完全可用。你可以随时删除已下载的文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訓練、訓練計畫、訓練記錄和分析在沒有媒體的情況下也完全可用。你可以隨時刪除已下載的檔案。"
          }
        }
      }
    },
