        }
      }
    },
    "There are no NOOP backups in your folder yet. Use Back up now first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In deinem Ordner sind noch keine NOOP-Sicherungen. Nutze zuerst „Jetzt sichern“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay respaldos de NOOP en tu carpeta. Usa Respaldar ahora primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas encore de sauvegardes NOOP dans votre dossier. Utilisez d'abord Sauvegarder maintenant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono ancora backup NOOP nella tua cartella. Usa prima Esegui backup ora."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não existem cópia de seguranças NOOP na tua pasta. Utilize Faça cópia de segurança agora primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В вашей папке пока нет резервных копий NOOP. Сначала используйте «Создать резервную копию сейчас»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的文件夹中还没有 NOOP 备份。请先使用「立即备份」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的資料夾中還沒有 NOOP 備份。請先使用「立即備份」。"
          }
        }
      }
    },
    "There wasn't a calm, still window clean enough to describe. Try again after a settled night.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gab kein ruhiges, stilles Fenster, das sauber genug zum Beschreiben war. Versuch es nach einer ruhigen Nacht erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hubo una ventana de calma y quietud lo bastante limpia para describir. Inténtalo de nuevo tras una noche tranquila."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas eu de fenêtre calme et immobile assez propre à décrire. Réessayez après une nuit stable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c'è stata una finestra calma e ferma abbastanza pulita da descrivere. Riprova dopo una notte tranquilla."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não havia uma janela calma e limpa o suficiente para ser descrita. Tente novamente depois de uma noite tranquila."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не нашлось достаточно чистого спокойного, неподвижного интервала для анализа. Попробуйте снова после спокойной ночи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有找到足够平静、静止的时间窗口。请在安稳睡眠一晚后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有足夠乾淨的平靜、靜止時段可供描述。請在安穩的一晚之後再試。"
          }
        }
      }
    },
    "There's about %@ of leftover import scratch space to reclaim. This never removes your imported data.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt etwa %@ übrig gebliebenen Import-Zwischenspeicher freizugeben. Das entfernt nie deine importierten Daten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay alrededor de %@ de espacio temporal de importación por recuperar. Esto nunca elimina tus datos importados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il reste environ %@ d'espace temporaire d'importation à récupérer. Cela ne supprime jamais vos données importées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci sono circa %@ di spazio temporaneo di importazione residuo da recuperare. Questo non rimuove mai i tuoi dati importati."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Há cerca de %@ de espaço residual de importação para recuperar. Isto nunca remove os teus dados importados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Осталось около %@ временного места импорта, которое можно освободить. Это никогда не удаляет уже импортированные данные."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大约有 %@ 的遗留导入临时空间可回收。此操作绝不会移除你导入的数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大約有 %@ 的遺留匯入暫存空間可回收。此操作絕不會移除你匯入的資料。"
          }
        }
      }
    },
    "There's no NOOP data to export yet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt noch keine NOOP-Daten zu exportieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay datos de NOOP para exportar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas encore de données NOOP à exporter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono ancora dati NOOP da esportare."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não existem dados NOOP para exportar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нет данных NOOP для экспорта."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有可导出的 NOOP 数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有可匯出的 NOOP 資料。"
          }
        }
      }
    },
    "There's no NOOP data to export yet. Import or record some first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt noch keine NOOP-Daten zu exportieren. Importiere oder zeichne zuerst etwas auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay datos de NOOP para exportar. Importa o registra algunos primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas encore de données NOOP à exporter. Importez ou enregistrez-en d'abord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono ancora dati NOOP da esportare. Prima importane o registrane qualcuno."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não existem dados NOOP para exportar. Importe ou grave alguns primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нет данных NOOP для экспорта. Сначала импортируйте или запишите данные."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有可导出的 NOOP 数据。请先导入或记录一些数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有可匯出的 NOOP 資料。請先匯入或記錄一些。"
          }
        }
      }
    },
    "There's no progress bar for this kind of goal, and that's deliberate: your strap can't measure it, so any percentage here would be invented. What's shown instead is what did happen — what you completed, and your recovery context.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Art von Ziel gibt es keinen Fortschrittsbalken, und das ist Absicht: Ihr Gurt kann ihn nicht messen, daher wäre jeder Prozentsatz hier erfunden. Stattdessen wird angezeigt, was passiert ist – was Sie abgeschlossen haben und Ihr Wiederherstellungskontext."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no progress bar for this kind of goal, and that's deliberate: your strap can't measure it, so any percentage here would be invented. What's shown instead is what did happen — what you completed, and your recovery context."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay una barra de progreso para este tipo de objetivos, y eso es deliberado: tu correa no puede medirlo, por lo que cualquier porcentaje aquí sería inventado. En cambio, lo que se muestra es lo que sucedió: lo que completó y su contexto de recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas de barre de progression pour ce genre d'objectif, et c'est délibéré : votre bracelet ne peut pas le mesurer, donc n'importe quel pourcentage ici serait inventé. Ce qui est affiché à la place est ce qui s'est passé : ce que vous avez terminé et votre contexte de récupération."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non esiste una barra di avanzamento per questo tipo di obiettivo, e questo è intenzionale: il tuo cinturino non può misurarlo, quindi qualsiasi percentuale qui sarebbe inventata. Ciò che viene mostrato invece è ciò che è accaduto: ciò che hai completato e il contesto di ripristino."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há barra de progresso para esse tipo de meta, e isso é deliberado: sua pulseira não pode medi-la, então qualquer porcentagem aqui seria inventada. Em vez disso, o que é mostrado é o que aconteceu – o que você concluiu e seu contexto de recuperação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для такой цели не существует индикатора прогресса, и это сделано намеренно: ваш ремень не может его измерить, поэтому любой процент здесь можно было бы придумать. Вместо этого отображается то, что произошло — что вы выполнили, и ваш контекст восстановления."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这种目标没有进度条，这是故意的：你的带子无法测量它，所以这里的任何百分比都会被发明。相反，显示的是确实发生的事情——您完成的事情以及您的恢复背景。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這種目標沒有進度條，這是故意的：你的帶子無法測量它，所以這裡的任何百分比都會被發明。相反，顯示的是確實發生的事情——您完成的事情以及您的恢復背景。"
          }
        }
      }
    },
    "There's no trend to show: this goal needs a starting point, a target and a measurement before progress can be compared to time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es lässt sich kein Trend erkennen: Dieses Ziel braucht einen Ausgangspunkt, ein Ziel und eine Messung, bevor der Fortschritt mit der Zeit verglichen werden kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no trend to show: this goal needs a starting point, a target and a measurement before progress can be compared to time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna tendencia que mostrar: este objetivo necesita un punto de partida, una meta y una medición antes de que el progreso pueda compararse con el tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a aucune tendance à montrer : cet objectif a besoin d'un point de départ, d'un objectif et d'une mesure avant que les progrès puissent être comparés au temps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c'è alcuna tendenza da mostrare: questo obiettivo ha bisogno di un punto di partenza, di un target e di una misurazione prima di poter paragonare i progressi al tempo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há nenhuma tendência a mostrar: este objetivo precisa de um ponto de partida, uma meta e uma medição antes que o progresso possa ser comparado ao tempo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет никакой тенденции, которую можно было бы продемонстрировать: для этой цели нужна отправная точка, цель и измерение, прежде чем прогресс можно будет сравнить со временем."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有趋势可以显示：这个目标需要一个起点、一个目标和一个衡量标准，然后才能将进度与时间进行比较。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有趨勢可以顯示：這個目標需要一個起點、一個目標和一個衡量標準，然後才能將進度與時間比較。"
          }
        }
      }
    },
    "These are experimental probes, off by default. The fuller WHOOP 5/MG controls and the raw-sensor CSV export still live in Settings under Diagnostics.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind experimentelle Sonden, standardmäßig aus. Die vollständigeren WHOOP-5/MG-Steuerungen und der Rohsensor-CSV-Export liegen weiter in den Einstellungen unter „Diagnose“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son sondas experimentales, desactivadas por defecto. Los controles más completos de WHOOP 5/MG y la exportación CSV del sensor en bruto siguen en Ajustes, bajo Diagnóstico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce sont des sondes expérimentales, désactivées par défaut. Les commandes plus complètes de WHOOP 5/MG et l'exportation CSV des capteurs bruts se trouvent toujours dans Paramètres, sous Diagnostic."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste sono sonde sperimentali, disattivate per impostazione predefinita. I controlli più completi per WHOOP 5/MG e l'esportazione CSV dei sensori grezzi si trovano ancora in Impostazioni, sotto Diagnostica."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas são sondagens experimentais, desativadas por defeito. Os controlos WHOOP 5/MG mais completos e a exportação CSV do sensor bruto ainda estão disponíveis em Definições em Diagnóstico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это экспериментальные пробы, по умолчанию отключены. Более полные настройки WHOOP 5/MG и экспорт необработанных данных датчиков в CSV по-прежнему находятся в разделе «Диагностика» настроек."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些是实验性探测，默认关闭。更完整的 WHOOP 5/MG 控制项和原始传感器 CSV 导出仍位于「设置」的「诊断」下。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些是實驗性探測，預設關閉。更完整的 WHOOP 5/MG 控制項和原始感測器 CSV 匯出仍位於「設定」的「診斷」下。"
          }
        }
      }
    },
    "These are extra, on-demand HRV lenses computed from today's R-R intervals. They are informational and do not change the stress score above.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind zusätzliche HRV-Blickwinkel auf Abruf, berechnet aus den heutigen R-R-Intervallen. Sie sind informativ und ändern den Stresswert oben nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son lentes de VFC adicionales, bajo demanda, calculadas a partir de los intervalos R-R de hoy. Son informativas y no cambian la puntuación de estrés de arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce sont des angles d'analyse VFC supplémentaires, à la demande, calculés à partir des intervalles R-R d'aujourd'hui. Ils sont informatifs et ne modifient pas le score de stress ci-dessus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste sono lenti HRV aggiuntive, su richiesta, calcolate dagli intervalli R-R di oggi. Sono informative e non modificano il punteggio dello stress qui sopra."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas são lentes HRV extra a pedido, calculadas a partir dos intervalos RR atuais. São informativos e não alteram a pontuação de stress acima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это дополнительные ракурсы ВСР по запросу, рассчитанные по сегодняшним R-R интервалам. Они носят информационный характер и не влияют на показатель стресса выше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些是根据今天的 R-R 间期计算的额外、按需的 HRV 视角。它们仅供参考，不会改变上方的压力评分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些是根據今天的 R-R 間期計算的額外、按需的 HRV 視角。它們僅供參考，不會改變上方的壓力評分。"
          }
        }
      }
    },
    "These are independent approximations from a consumer strap, built on open science: not medical advice, and not WHOOP's official scores.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind unabhängige Näherungen von einem Consumer-Strap, gebaut auf offener Wissenschaft: kein medizinischer Rat und nicht WHOOPs offizielle Werte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son aproximaciones independientes de una pulsera de consumo, construidas sobre ciencia abierta: no son consejo médico ni las puntuaciones oficiales de WHOOP."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce sont des approximations indépendantes issues d'un bracelet grand public, fondées sur la science ouverte : ni un conseil médical, ni les scores officiels de WHOOP."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste sono approssimazioni indipendenti da una fascia di consumo, basate sulla scienza aperta, non sono consulenza medica, né i punteggi ufficiali di WHOOP."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Trata-se de aproximações independentes de um intervalo de consumo, construídas com base na ciência aberta: não nos conselhos médicos, nem nas pontuações oficiais do WHOOP."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это независимые приближённые оценки, полученные с потребительского браслета на основе открытых научных данных: не медицинская консультация и не официальные показатели WHOOP."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些是来自消费级手环的独立近似值，基于开放科学构建，并非医疗建议，也不是 WHOOP 的官方评分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些是來自消費級手環的獨立近似值，基於開放科學構建，並非醫療建議，也不是 WHOOP 的官方評分。"
          }
        }
      }
    },
    "These are independent estimates computed on your device from your Apple Health data, not medical advice. Confidence labels are honest about how much NOOP knows so far.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind unabhängige Schätzungen, berechnet auf deinem Gerät aus deinen Apple-Health-Daten, kein medizinischer Rat. Konfidenz-Labels sind ehrlich dazu, wie viel NOOP bisher weiß."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son estimaciones independientes calculadas en tu dispositivo a partir de tus datos de Apple Health, no consejo médico. Las etiquetas de confianza son honestas sobre cuánto sabe NOOP hasta ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce sont des estimations indépendantes calculées sur votre appareil à partir de vos données Apple Santé, non un conseil médical. Les libellés de confiance indiquent honnêtement ce que NOOP sait jusqu'à présent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste sono stime indipendenti calcolate sul tuo dispositivo a partire dai tuoi dati Apple Health, non consulenza medica. Le etichette di affidabilità sono oneste su quanto NOOP sa finora."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas são estimativas independentes calculadas no teu dispositivo a partir dos dados da Apple Health, e não de aconselhamento médico. Os rótulos de confiança são honestos sobre o quanto o NOOP sabe até agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это независимые оценки, рассчитанные на вашем устройстве по данным Apple Health, не медицинская консультация. Метки достоверности честно показывают, насколько NOOP уже осведомлён."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些是在你的设备上根据你的 Apple 健康数据计算的独立估算值，并非医疗建议。置信度标签会如实反映 NOOP 目前了解多少。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些是在你的裝置上根據你的 Apple 健康資料計算的獨立估算值，並非醫療建議。信賴度標籤會如實反映 NOOP 目前了解多少。"
          }
        }
      }
    },
    "These are local text matches from the PDF, not medical interpretations. Check each value against your report and deselect anything you do not want to keep.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dabei handelt es sich um lokale Textübereinstimmungen aus dem PDF, nicht um medizinische Interpretationen. Vergleichen Sie jeden Wert mit Ihrem Bericht und deaktivieren Sie alles, was Sie nicht behalten möchten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are local text matches from the PDF, not medical interpretations. Check each value against your report and deselect anything you do not want to keep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas son coincidencias de textos locales del PDF, no interpretaciones médicas. Verifique cada valor con su informe y anule la selección de todo lo que no desee conservar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il s'agit de correspondances de texte locales à partir du PDF, et non d'interprétations médicales. Vérifiez chaque valeur par rapport à votre rapport et désélectionnez tout ce que vous ne souhaitez pas conserver."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tratta di corrispondenze di testo locale dal PDF, non di interpretazioni mediche. Confronta ciascun valore con il tuo report e deseleziona tutto ciò che non desideri conservare."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas são correspondências de texto local do PDF, não interpretações médicas. Compare cada valor com seu relatório e desmarque tudo o que você não deseja manter."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это совпадения местного текста с PDF-файлом, а не медицинские интерпретации. Проверьте каждое значение в своем отчете и отмените выбор всего, что вы не хотите сохранять."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些是 PDF 中的本地文本匹配，而不是医学解释。根据您的报告检查每个值并取消选择您不想保留的任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些是 PDF 中的本地文本匹配，而不是醫學解釋。根據您的報告檢查每個值並取消選擇您不想保留的任何內容。"
          }
        }
      }
    },
    "These are the days where your phone also counted steps, so NOOP can learn how your motion maps to steps. Or set the coefficient manually below.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind die Tage, an denen dein Telefon ebenfalls Schritte gezählt hat, damit NOOP lernen kann, wie deine Bewegung auf Schritte abbildet. Oder lege den Koeffizienten unten manuell fest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos son los días en los que tu teléfono también contó pasos, así NOOP puede aprender cómo tu movimiento se traduce en pasos. O ajusta el coeficiente manualmente abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce sont les jours où votre téléphone a aussi compté les pas, afin que NOOP apprenne comment votre mouvement se traduit en pas. Ou définissez le coefficient manuellement ci-dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi sono i giorni in cui anche il tuo telefono ha contato i passi, così NOOP può imparare come il tuo movimento si traduce in passi. Oppure imposta il coefficiente manualmente qui sotto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes são os dias em que o teu telemóvel também contava passos, pelo que o NOOP pode aprender como o teu movimento é mapeado para passos. Ou defina o coeficiente manualmente abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это дни, когда телефон также считал шаги, поэтому NOOP может понять, как ваше движение соотносится с шагами. Либо задайте коэффициент вручную ниже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些是你手机也统计了步数的日子，因此 NOOP 可以学习你的运动如何对应步数。或者在下方手动设置系数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些是你手機也統計了步數的日子，因此 NOOP 可以學習你的運動如何對應步數。或者在下方手動設定係數。"
          }
        }
      }
    },
    "These are your own numbers shown back to you. NOOP doesn't decide whether any value is normal, high or low.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind deine eigenen Zahlen, dir zurückgespiegelt. NOOP entscheidet nicht, ob ein Wert normal, hoch oder niedrig ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son tus propios números mostrados de vuelta. NOOP no decide si algún valor es normal, alto o bajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce sont vos propres chiffres qui vous sont restitués. NOOP ne décide pas si une valeur est normale, haute ou basse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi sono i tuoi stessi numeri riproposti a te. NOOP non decide se un valore sia normale, alto o basso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes são os teus próprios números que lhe são mostrados. O NOOP não decide se algum valor é normal, alto ou baixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это ваши собственные показатели, отображённые для вас же. NOOP не решает, является ли значение нормальным, высоким или низким."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些是原样呈现给你的、你自己的数字。NOOP 不会判定任何数值是正常、偏高还是偏低。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些是原樣呈現給你的、你自己的數字。NOOP 不會判定任何數值是正常、偏高還是偏低。"
          }
        }
      }
    },
    "These backups are unencrypted too. If this folder syncs to Drive, Dropbox or iCloud, the readable file goes there as well — only point it at a service you trust.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch diese Sicherungen sind unverschlüsselt. Wenn dieser Ordner mit Drive, Dropbox oder iCloud synchronisiert wird, landet die lesbare Datei auch dort — zeigen Sie nur auf einen Dienst, dem Sie vertrauen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These backups are unencrypted too. If this folder syncs to Drive, Dropbox or iCloud, the readable file goes there as well — only point it at a service you trust."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas copias de seguridad tampoco están cifradas. Si esta carpeta se sincroniza con Drive, Dropbox o iCloud, el archivo legible también llegará allí: apunte solo a un servicio de confianza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces sauvegardes ne sont pas chiffrées non plus. Si ce dossier se synchronise avec Drive, Dropbox ou iCloud, le fichier lisible y sera aussi copié : ne pointez que vers un service de confiance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche questi backup non sono cifrati. Se questa cartella si sincronizza con Drive, Dropbox o iCloud, anche il file leggibile finisce lì — punta solo a un servizio di cui ti fidi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas cópias de segurança também não estão encriptadas. Se esta pasta sincronizar com o Drive, o Dropbox ou o iCloud, o ficheiro legível também vai parar lá — aponta apenas para um serviço de confiança."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти резервные копии тоже не зашифрованы. Если эта папка синхронизируется с Drive, Dropbox или iCloud, читаемый файл попадёт и туда — указывайте только надёжный сервис."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些备份同样未加密。如果这个文件夹与 Drive、Dropbox 或 iCloud 同步，可读的文件也会一并上传——只指向你信任的服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些備份同樣未加密。如果這個資料夾與 Drive、Dropbox 或 iCloud 同步，可讀的檔案也會一併上傳——只指向你信任的服務。"
          }
        }
      }
    },
    "These days are excluded from the estimate (your phone's real count is shown instead). They're here only so you can judge the estimate's accuracy.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Tage sind von der Schätzung ausgenommen (stattdessen wird die echte Zählung deines Telefons gezeigt). Sie stehen hier nur, damit du die Genauigkeit der Schätzung beurteilen kannst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos días quedan excluidos de la estimación (se muestra el conteo real de tu teléfono en su lugar). Están aquí solo para que juzgues la precisión de la estimación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces jours sont exclus de l'estimation (le comptage réel de votre téléphone est affiché à la place). Ils figurent ici uniquement pour que vous puissiez juger de la précision de l'estimation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi giorni sono esclusi dalla stima (al loro posto è mostrato il conteggio reale del tuo telefono), sono qui solo perché tu possa giudicare l'accuratezza della stima."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes dias são excluídos da estimativa (em vez disso, é mostrada a contagem real do teu telemóvel). Estão aqui apenas para que possa avaliar a precisão da estimativa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти дни исключены из оценки (вместо неё показан реальный подсчёт телефона). Они здесь только для того, чтобы вы могли оценить точность расчёта."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些日子被排除在估算之外（改为显示你手机的真实计数）， 它们出现在这里只是为了让你判断估算的准确性。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些日子被排除在估算之外（改為顯示你手機的真實計數）， 它們出現在這裡只是為了讓你判斷估算的準確性。"
          }
        }
      }
    },
    "These power your heart-rate zones, calorie estimates and recovery baselines. Keep them accurate.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese steuern deine Herzfrequenzzonen, Kalorienschätzungen und Erholungs-Basislinien. Halte sie genau."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These power your heart-rate zones, calorie estimates and recovery baselines. Keep them accurate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos alimentan tus zonas de frecuencia cardíaca, las estimaciones de calorías y las líneas base de recuperación. Mantenlos precisos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces éléments alimentent vos zones de fréquence cardiaque, estimations de calories et références de récupération. Gardez-les précis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi alimentano le tue zone di frequenza cardiaca, le stime caloriche e le linee di base del recupero. Mantienili accurati."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alimentam as tuas zonas de frequência cardíaca, estimativas de calorias e linhas de base de recuperação. Mantenha-os precisos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На их основе рассчитываются пульсовые зоны, оценка калорий и личные нормы восстановления. Следите, чтобы данные были точными."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些数据为你的心率区间、卡路里估算和恢复基线提供支撑。请保持它们准确。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些數據為你的心率區間、卡路里估算和恢復基線提供支撐。請保持它們準確。"
          }
        }
      }
    },
    "These sessions aren't tied to a target yet. Set a goal under Goal & Journey and the coach plans towards it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Sitzungen sind noch nicht an ein Ziel gebunden. Legen Sie unter „Ziel & Reise“ ein Ziel fest und der Coach plant, es zu erreichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These sessions aren't tied to a target yet. Set a goal under Goal & Journey and the coach plans towards it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas sesiones aún no están vinculadas a un objetivo. Establezca una meta en Meta y viaje y el entrenador planea alcanzarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces sessions ne sont pas encore liées à une cible. Fixez un objectif sous Objectif et parcours et le coach planifie en conséquence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste sessioni non sono ancora legate a un obiettivo. Imposta un obiettivo in Obiettivo e percorso e l'allenatore pianifica il raggiungimento di esso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Essas sessões ainda não estão vinculadas a um alvo. Defina uma meta em Meta e Jornada e o treinador planeja alcançá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти сеансы еще не привязаны к цели. Установите цель в разделе «Цель и путь», и тренер планирует ее достижение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些会话尚未与目标绑定。在“目标和旅程”下设定一个目标，教练为实现该目标制定计划。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些會話尚未與目標綁定。在「目標和旅程」下設定一個目標，教練為實現該目標制定計劃。"
          }
        }
      }
    },
    "These sessions have no sport label yet. Pick one for the merged session.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Sitzungen haben noch kein Sportlabel. Wählen Sie eine für die zusammengeführte Sitzung aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
