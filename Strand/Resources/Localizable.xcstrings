    "Zone 5 always ends at your maximum heart rate, so only the five starting points are yours to move." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zone 5 endet immer bei deiner maximalen Herzfrequenz — verschieben kannst du also nur die fünf Startpunkte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zone 5 always ends at your maximum heart rate, so only the five starting points are yours to move."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La zona 5 siempre termina en tu frecuencia cardíaca máxima, así que solo puedes mover los cinco puntos de inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La zone 5 se termine toujours à votre fréquence cardiaque maximale : vous ne pouvez donc déplacer que les cinq points de départ."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La zona 5 finisce sempre alla tua frequenza cardiaca massima, quindi puoi spostare solo i cinque punti di inizio."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strefa 5 zawsze kończy się na Twoim maksymalnym tętnie, więc przesuwać możesz jedynie pięć punktów początkowych."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A zona 5 termina sempre na sua frequência cardíaca máxima, por isso só pode mover os cinco pontos de início."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зона 5 всегда заканчивается на максимальном пульсе, поэтому менять можно только пять начальных точек."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "区间 5 始终以你的最大心率结束，因此你只能移动五个起点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "區間 5 始終以你的最大心率結束，因此你只能移動五個起點。"
          }
        }
      }
    },
