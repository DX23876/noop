          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpocznij trening, gdy strumień ma znaczenie. NOOP rejestruje interwał, tętno, szczyt, średnią i wysiłek z tego samego kanału na żywo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicie um treino quando a transmissão é importante. O NOOP regista o intervalo, FC, pico, média e esforço do mesmo feed em direto."
          }
