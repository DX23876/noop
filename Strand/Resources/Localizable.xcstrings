    "No usable rows found. Check the file has a date column (yyyy-MM-dd) and daily totals.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine nutzbaren Zeilen gefunden. Prüfe, ob die Datei eine Datumsspalte (yyyy-MM-dd) und Tagessummen hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron filas utilizables. Comprueba que el archivo tenga una columna de fecha (yyyy-MM-dd) y totales diarios."
          }
