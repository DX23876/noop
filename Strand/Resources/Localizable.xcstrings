    "%lld readings used · %@ %@ association. This is your own data sitting side by side. It's not a medical finding, and it shows association, not cause.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld Messwerte verwendet · %2$@ %3$@ Assoziation. Das sind deine eigenen Daten im direkten Vergleich. Es ist kein medizinischer Befund und zeigt Zusammenhang, nicht Ursache."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld readings used · %2$@ %3$@ association. This is your own data sitting side by side, it's not a medical finding, and it shows association, not cause."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld lecturas usadas · asociación %@ %@. Son tus propios datos puestos lado a lado. No es un hallazgo médico, y muestra asociación, no causa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld lectures utilisées · association %2$@ %3$@. Ce sont vos propres données mises côte à côte, ce n'est pas un constat médical, et cela montre une association, pas une cause."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld letture usate · associazione %2$@ %3$@. Questi sono i tuoi dati messi a confronto, non è un referto medico e mostra un'associazione, non una causa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld leituras utilizadas · Associação %2$@ %3$@. Estes são os teus próprios dados lado a lado, não são uma descoberta médica e mostram associação, não causa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld измерений использовано · %2$@ %3$@ связь. Это ваши собственные данные, сопоставленные рядом, — не медицинское заключение, и оно показывает связь, а не причину."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用了 %1$lld 条读数 · %2$@ %3$@ 关联。这是你自己的数据并排呈现，它不是医学结论，只显示关联，而非因果。"
          }
