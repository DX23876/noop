        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O endpoint gratuito do ExerciseDB não necessita de chave. Uma chave pessoal para outro fornecedor compatível é guardada no Porta-chaves deste dispositivo. A NOOP solicita apenas uma página e não envia dados de treino ou de saúde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
