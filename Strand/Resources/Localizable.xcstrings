          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una metrica tracciata nel tempo"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma métrica traçada ao longo do tempo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
