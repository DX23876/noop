    "Off by default. Turn this on after you choose to use a provider; chats and local data stay saved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig deaktiviert. Aktivieren Sie diese Option, nachdem Sie sich für die Nutzung eines Anbieters entschieden haben. Chats und lokale Daten bleiben gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. Turn this on after you choose to use a provider; chats and local data stay saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado de forma predeterminada. Actívelo después de elegir utilizar un proveedor; los chats y los datos locales permanecen guardados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé par défaut. Activez cette option après avoir choisi d'utiliser un fournisseur ; les discussions et les données locales restent enregistrées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato per impostazione predefinita. Attivalo dopo aver scelto di utilizzare un provider; le chat e i dati locali rimangono salvati."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado por padrão. Ative isso depois de escolher usar um provedor; bate-papos e dados locais permanecem salvos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию выключено. Включите это после того, как решите использовать провайдера; чаты и локальные данные остаются сохраненными."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭。选择使用提供商后打开此功能；聊天和本地数据保持保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設關閉。選擇使用提供者後開啟此功能；聊天和本機資料保持保存。"
          }
        }
      }
    },
