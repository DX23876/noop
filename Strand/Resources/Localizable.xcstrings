    "The file is removed from this device. There is no copy anywhere else." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei wird von diesem Gerät entfernt. Es gibt nirgendwo eine Kopie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo se elimina de este dispositivo. No hay copia en ningún otro sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier est supprimé de cet appareil. Il n'en existe de copie nulle part ailleurs."
          }
        },
        "it" : {
