        }
      }
    },
    "The method behind the score, not today's values." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Methode hinter dem Wert, nicht die heutigen Zahlen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El método detrás de la puntuación, no los valores de hoy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La méthode derrière le score, pas les valeurs du jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il metodo dietro il punteggio, non i valori di oggi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metoda kryjąca się za wynikiem, a nie dzisiejsze wartości."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O método por detrás da pontuação, não os valores de hoje."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Метод расчёта показателя, а не сегодняшние значения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "评分背后的方法，而非今天的数值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "評分背後的方法，而非今天的數值。"
          }
        }
      }
    },
    "The model then writes the answer in plain language. When a specific number is needed, it can use a permitted tool; NOOP checks that tool locally before returning a result." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Modell schreibt dann die Antwort im Klartext. Wenn eine bestimmte Nummer benötigt wird, kann ein zugelassenes Werkzeug verwendet werden. NOOP überprüft dieses Tool lokal, bevor ein Ergebnis zurückgegeben wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The model then writes the answer in plain language. When a specific number is needed, it can use a permitted tool; NOOP checks that tool locally before returning a result."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luego, el modelo escribe la respuesta en lenguaje sencillo. Cuando se necesita un número específico, se puede utilizar una herramienta permitida; NOOP verifica esa herramienta localmente antes de devolver un resultado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modèle écrit ensuite la réponse en langage clair. Lorsqu'un numéro spécifique est nécessaire, il peut utiliser un outil autorisé ; NOOP vérifie cet outil localement avant de renvoyer un résultat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il modello quindi scrive la risposta in un linguaggio semplice. Quando è necessario un numero specifico, può utilizzare uno strumento consentito; NOOP controlla lo strumento localmente prima di restituire un risultato."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Następnie model pisze odpowiedź prostym językiem. Gdy potrzebna jest konkretna liczba, może użyć dozwolonego narzędzia; NOOP sprawdza je lokalnie przed zwróceniem wyniku."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modelo então escreve a resposta em linguagem simples. Quando for necessário um número específico, pode-se utilizar uma ferramenta permitida; NOOP verifica essa ferramenta localmente antes de retornar um resultado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Затем модель записывает ответ простым языком. Когда требуется определенное количество, можно использовать разрешенный инструмент; NOOP проверяет этот инструмент локально, прежде чем вернуть результат."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "然后模型用简单的语言写出答案。当需要特定数量时，可以使用允许的工具； NOOP 在返回结果之前在本地检查该工具。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "然後模型用簡單的語言寫出答案。當需要特定數量時，可以使用允許的工具； NOOP 在傳回結果之前在本機檢查該工具。"
          }
        }
      }
    },
    "The model this uses lives under Connection & model → Background models." : {
