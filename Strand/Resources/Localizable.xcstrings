    "Estimated from your WHOOP's motion, calibrated to your phone. Not a measured step count." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geschätzt aus der Bewegung deines WHOOP, kalibriert an deinem Telefon. Keine gemessene Schrittzahl."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimado a partir del movimiento de tu WHOOP, calibrado con tu teléfono. No es un recuento de pasos medido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimé à partir du mouvement de votre WHOOP, calibré sur votre téléphone. Pas un nombre de pas mesuré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stimato dal movimento del tuo WHOOP, calibrato sul tuo telefono. Non è un conteggio passi misurato."
