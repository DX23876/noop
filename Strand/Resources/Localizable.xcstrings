    "Completed workouts stay in your history." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abgeschlossene Trainings bleiben in deinem Verlauf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completed workouts stay in your history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los entrenamientos completados permanecen en tu historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les entraînements terminés restent dans votre historique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli allenamenti completati rimangono nella tua cronologia."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukończone treningi pozostają w Twojej historii."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os treinos concluídos ficam no seu histórico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завершенные тренировки остаются в вашей истории."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已完成的锻炼会保留在您的历史记录中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已完成的鍛鍊會保留在您的歷史記錄中。"
          }
        }
      }
    },
    "Completion and effect are stored separately. Missing feedback stays missing and is never treated as “no effect”." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abschluss und Wirkung werden getrennt gespeichert. Fehlendes Feedback bleibt ausbleibend und wird nie als „keine Auswirkung“ gewertet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completion and effect are stored separately. Missing feedback stays missing and is never treated as “no effect”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La finalización y el efecto se almacenan por separado. Los comentarios faltantes permanecen perdidos y nunca se tratan como \"sin efecto\"."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'achèvement et l'effet sont stockés séparément. Les commentaires manquants restent manquants et ne sont jamais traités comme « aucun effet »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il completamento e l'effetto vengono memorizzati separatamente. Il feedback mancante rimane tale e non viene mai trattato come “nessun effetto”."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukończenie i efekt są zapisywane osobno. Brakująca informacja zwrotna pozostaje brakiem i nigdy nie jest traktowana jako „brak efektu”."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A conclusão e o efeito são armazenados separadamente. O feedback ausente permanece ausente e nunca é tratado como “sem efeito”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завершение и эффект хранятся отдельно. Отсутствие обратной связи остается отсутствующим и никогда не рассматривается как «отсутствие эффекта»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完成度和效果是分开存储的。缺失的反馈始终缺失，并且永远不会被视为“无效”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完成度和效果是分開儲存的。缺少的回饋始終缺失，並且永遠不會被視為「無效」。"
          }
        }
      }
    },
