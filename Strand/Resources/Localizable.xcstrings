    "Want the full breakdown of every metric and how sure NOOP is about each one? The “About Apple Watch data” page in Settings has the honest table." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Willst du die volle Aufschlüsselung jeder Metrik und wie sicher NOOP bei jeder ist? Die Seite „Über Apple-Watch-Daten“ in den Einstellungen hat die ehrliche Tabelle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quieres el desglose completo de cada métrica y cuánta confianza tiene NOOP en cada una? La página “Acerca de los datos del Apple Watch” en Ajustes tiene la tabla honesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous voulez le détail complet de chaque métrique et le degré de confiance de NOOP pour chacune ? La page « À propos des données Apple Watch » dans Paramètres contient le tableau honnête."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuoi la suddivisione completa di ogni metrica e quanto NOOP è sicuro di ciascuna? La pagina “Informazioni sui dati Apple Watch” in Impostazioni contiene la tabella onesta."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcesz pełnego zestawienia każdej metryki i pewności, że NOOP dotyczy każdej z nich? Strona „O danych Apple Watch” w Ustawieniach zawiera uczciwą tabelę."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pretende o detalhe completo de cada métrica e qual a certeza do NOOP sobre cada uma delas? A página “Sobre os dados do Apple Watch” em Definições contém a tabela honesta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хотите полную разбивку по каждой метрике и узнать, насколько NOOP уверен в каждой из них? На странице «О данных Apple Watch» в настройках есть честная таблица."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想要每项指标的完整明细以及 NOOP 对每一项的确定程度吗？「设置」中的「关于 Apple Watch 数据」页面有一张诚实的表格。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想要每項指標的完整明細以及 NOOP 對每一項的確定程度嗎？「設定」中的「關於 Apple Watch 資料」頁面有一張誠實的表格。"
          }
        }
      }
    },
