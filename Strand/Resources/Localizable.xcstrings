          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренировки не найдены. Укажите CSV-экспорт из Hevy или JSON-экспорт из Liftosaur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
