    "most recent intake about %@ ago · %lld intakes still in the estimate. Rough guide only, based on what you logged.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "letzte Einnahme vor etwa %1$@ · %2$lld Einnahmen noch in der Schätzung. Nur ein grober Anhaltspunkt, basierend auf deinen Einträgen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "most recent intake about %1$@ ago · %2$lld intakes still in the estimate. Rough guide only, based on what you logged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "última ingesta hace unos %@ · %lld ingestas aún en la estimación. Solo una guía aproximada, basada en lo que registraste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "dernière prise il y a environ %1$@ · %2$lld prises encore dans l'estimation. Indication approximative seulement, basée sur ce que vous avez consigné."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "assunzione più recente circa %@ fa · %lld assunzioni ancora nella stima. Solo un'indicazione di massima, basata su ciò che hai registrato."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "consumo mais recente há cerca de %1$@ · consumo de %2$lld ainda na estimativa. Apenas um guia aproximado, com base no que registou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "последний приём — примерно %1$@ назад · %2$lld приёмов всё ещё учитываются в оценке. Это лишь приблизительный ориентир на основе того, что вы записали."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近一次摄入约在 %@ 前 · 估算中仍包含 %lld 次摄入。仅为粗略参考，基于你的记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最近一次攝取約在 %@ 前 · 估算中仍包含 %lld 筆攝取記錄。僅為粗略參考，依據你記錄的內容。"
          }
        }
      }
    },
