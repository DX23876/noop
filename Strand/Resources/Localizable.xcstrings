    "HR eased %lld → %lld over %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HF sank %1$lld → %2$lld über %3$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "HR eased %1$lld → %2$lld over %3$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La FC se relajó de %lld → %lld en %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FC apaisée %1$lld → %2$lld sur %3$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "FC calata da %lld a %lld in %@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "HR facilitou %1$lld → %2$lld sobre %3$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пульс снизился с %1$lld до %2$lld за %3$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "心率在 %3$@ 内从 %1$lld 缓和到 %2$lld。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "心率在 %3$@ 內從 %1$lld 緩降至 %2$lld。"
          }
        }
      }
    },
    "HR held steady (%lld → %lld). Try a paced breath instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HF blieb stabil (%1$lld → %2$lld). Versuch stattdessen einen getakteten Atemzug."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "HR held steady (%1$lld → %2$lld). Try a paced breath instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La FC se mantuvo estable (%lld → %lld). Prueba mejor una respiración guiada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FC restée stable (%1$lld → %2$lld). Essayez plutôt une respiration guidée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "FC rimasta stabile (%lld → %lld). Prova invece una respirazione guidata."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O HR manteve-se estável (%1$lld → %2$lld). Em vez disso, tente uma respiração controlada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пульс держался стабильно (%1$lld → %2$lld). Попробуйте вместо этого дыхание в заданном темпе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "心率保持平稳（%1$lld → %2$lld）。试试有节奏的呼吸。"
