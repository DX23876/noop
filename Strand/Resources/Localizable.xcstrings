    "Posts after your strap syncs and NOOP scores the day — not the exact second you cross it. At most once per day." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erscheint, nachdem dein Band synchronisiert hat und NOOP den Tag bewertet hat — nicht in der exakten Sekunde des Überschreitens. Höchstens einmal pro Tag."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparece después de que tu banda sincroniza y NOOP puntúa el día — no en el segundo exacto en que lo cruzas. Como máximo una vez al día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apparaît après la synchronisation de votre bracelet et le calcul du jour par NOOP — pas à la seconde exacte du franchissement. Au plus une fois par jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pubblicazioni dopo lo sincronismo del cinturino e i punteggi NOOP della giornata — non il secondo preciso in cui li raggiungi. Al massimo una per giorno."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posty po zsynchronizowaniu paska i zdobyciu punktów NOOP w danym dniu — a nie dokładnie w chwili, gdy go przekroczysz. Najwyżej raz dziennie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Publicações após a sincronização da tua faixa e pontuação NOOP no dia - não no segundo exato em que a cruza. No máximo uma vez por dia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Публикации после синхронизации датчика и оценки NOOP в течение дня — не точное время crossing. Не более одного в день."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在手环同步后，在 NOOP 分数计算当天（非精确秒数）。每天最多一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在錶帶同步並 NOOP 分數後的當天記錄，最多一天一次，並非準確的秒數。"
          }
        }
      }
    },
