          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите оборудование, которым вы можете пользоваться. Тогда библиотека упражнений сможет показывать подходящие упражнения. Если ничего не выбрано, доступны все упражнения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
