          }
        }
      }
    },
    "Backs up to your folder about once a day and keeps the latest %lld. On this platform it runs when you next open NOOP.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichert etwa einmal täglich in deinen Ordner und behält die letzten %lld. Auf dieser Plattform läuft es beim nächsten Öffnen von NOOP."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace una copia en tu carpeta más o menos una vez al día y conserva las últimas %lld. En esta plataforma se ejecuta la próxima vez que abras NOOP."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegarde dans votre dossier environ une fois par jour et conserve les %lld dernières. Sur cette plateforme, cela s'exécute à la prochaine ouverture de NOOP."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegue il backup nella tua cartella circa una volta al giorno e conserva gli ultimi %lld. Su questa piattaforma viene eseguito alla prossima apertura di NOOP."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Faz cópias de segurança da tua pasta uma vez por dia e mantém o %lld mais recente. Nesta plataforma, será executado na próxima vez que abrir o NOOP."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создаёт резервную копию в вашей папке примерно раз в день и хранит последние %lld. На этой платформе запускается при следующем открытии NOOP."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大约每天一次备份到你的文件夹，并保留最新的 %lld 份。在此平台上，它会在你下次打开 NOOP 时运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大約每天一次備份到你的資料夾，並保留最新的 %lld 份。在此平台上，它會在你下次打開 NOOP 時執行。"
          }
        }
      }
    },
