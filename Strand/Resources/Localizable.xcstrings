    "Every exercise works without them. Download the optional pack once to see how each one is done." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Übung funktioniert auch ohne. Lade das optionale Paket einmal, um zu sehen, wie jede Übung ausgeführt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every exercise works without them. Download the optional pack once to see how each one is done."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los ejercicios funcionan sin ellas. Descarga una vez el paquete opcional para ver cómo se hace cada uno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque exercice fonctionne sans elles. Téléchargez une fois le pack facultatif pour voir comment chacun s’exécute."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni esercizio funziona anche senza. Scarica una volta il pacchetto opzionale per vedere come si esegue ciascuno."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każde ćwiczenie działa i bez nich. Pobierz raz opcjonalny pakiet, aby zobaczyć, jak wykonać każde z nich."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os exercícios funcionam sem elas. Transfira uma vez o pacote opcional para ver como se faz cada um."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все упражнения работают и без них. Загрузите необязательный пакет один раз, чтобы видеть технику каждого."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有它们也能使用每个动作。下载一次可选资源包，即可查看每个动作的做法。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有它們也能使用每個動作。下載一次選用資源包，即可查看每個動作的做法。"
          }
        }
      }
    },
