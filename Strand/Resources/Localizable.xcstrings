    "Pick a model first. Tap Refresh next to Model in Coach settings to load the ones your provider offers, or type an id yourself.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle zuerst ein Modell. Tippe in den Coach-Einstellungen neben „Modell“ auf „Aktualisieren“, um die Modelle deines Anbieters zu laden, oder gib selbst eine ID ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a model first. Tap Refresh next to Model in Coach settings to load the ones your provider offers, or type an id yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige primero un modelo. Toca Actualizar junto a Modelo en los ajustes del Coach para cargar los que ofrece tu proveedor, o escribe un id."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez d’abord un modèle. Touchez Actualiser à côté de Modèle dans les réglages du Coach pour charger ceux proposés par votre fournisseur, ou saisissez un identifiant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli prima un modello. Tocca Aggiorna accanto a Modello nelle impostazioni del Coach per caricare quelli offerti dal provider, oppure inserisci un id."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe primeiro um modelo. Toca em Atualizar junto a Modelo nas definições do Coach para carregar os modelos do fornecedor, ou introduz um id."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала выберите модель. Нажмите «Обновить» рядом с пунктом «Модель» в настройках Coach, чтобы загрузить модели провайдера, или введите id вручную."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先选择模型。在 Coach 设置中点击“模型”旁的“刷新”以加载提供商支持的模型，或自行输入 id。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先選擇模型。在 Coach 設定中點一下「模型」旁的「重新整理」以載入供應商提供的模型，或自行輸入 id。"
          }
        }
      }
    },
    "Pick a new active strap": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neuen aktiven Strap auswählen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una nueva pulsera activa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir un nouveau bracelet actif"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una nuova fascia attiva"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma nova bracelete ativa"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите новый активный браслет"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个新的活跃手环"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一個新的活躍手環"
          }
        }
      }
    },
    "Pick a sport. NOOP records HR, peak, average and effort from the live feed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Sportart. NOOP zeichnet HF, Spitze, Durchschnitt und Anstrengung aus dem Live-Feed auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un deporte. NOOP registra FC, pico, media y esfuerzo desde la transmisión en vivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un sport. NOOP enregistre la FC, le pic, la moyenne et l'effort depuis le flux en direct."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli uno sport, NOOP registra FC, picco, media e sforzo dal feed in diretta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um desporto. O NOOP regista HR, pico, média e esforço do feed em direto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите вид спорта. NOOP запишет пульс, пик, среднее значение и усилие из потока в реальном времени."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个运动项目，NOOP 会从实时数据流中记录心率、峰值、平均值和消耗。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一個運動項目，NOOP 會從即時資料流中記錄心率、峰值、平均值和消耗。"
          }
        }
      }
    },
    "Pick a wearable signal (resting HR, HRV, sleep, Charge, weight…) to line it up against this marker. NOOP averages the signal over the %@ before each reading.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Wearable-Signal (Ruhe-HF, HRV, Schlaf, Ladung, Gewicht …), um es gegen diesen Marker zu stellen. NOOP mittelt das Signal über die %@ vor jeder Messung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una señal del wearable (FC en reposo, VFC, sueño, Carga, peso…) para compararla con este marcador. NOOP promedia la señal durante los %@ previos a cada lectura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un signal du wearable (FC au repos, VFC, sommeil, Charge, poids…) pour le comparer à ce marqueur. NOOP calcule la moyenne du signal sur les %@ précédant chaque lecture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un segnale del dispositivo indossabile (FC a riposo, HRV, sonno, carica, peso…) da confrontare con questo marcatore. NOOP calcola la media del segnale sul %@ prima di ogni lettura."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um sinal wearable (FC em repouso, VFC, sono, carga, peso…) para o alinhar com este marcador. O NOOP calcula a média do sinal sobre %@ antes de cada leitura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите сигнал носимого устройства (пульс в покое, ВСР, сон, Заряд, вес…), чтобы сопоставить его с этим маркером. NOOP усредняет сигнал за %@ до каждой записи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个可穿戴信号（静息心率、HRV、睡眠、能量、体重…）以将其与此标记对齐。NOOP 会对每次读数之前 %@ 内的信号取平均值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一個穿戴式訊號（靜息心率、HRV、睡眠、能量、體重…）以將其與此標記對齊。NOOP 會對每次讀數之前 %@ 內的訊號取平均值。"
          }
        }
      }
    },
    "Pick one behaviour you log, one outcome, and a short window. NOOP compares the days you log the behaviour against your behaviour-free days before the start.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Verhalten, das du erfasst, ein Ergebnis und ein kurzes Fenster. NOOP vergleicht die Tage, an denen du das Verhalten erfasst, mit deinen verhaltensfreien Tagen vor dem Start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un hábito que registres, un resultado y una ventana corta. NOOP compara los días en que registras el hábito con tus días sin el hábito antes del inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un comportement que vous enregistrez, un résultat et une fenêtre courte. NOOP compare les jours où vous enregistrez le comportement à vos jours sans ce comportement avant le début."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un comportamento che registri, un risultato e una finestra breve. NOOP confronta i giorni in cui registri il comportamento con i giorni senza il comportamento prima dell'inizio."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um comportamento registado, um resultado e uma janela curta. O NOOP compara os dias em que regista o comportamento com os dias sem comportamento antes do início."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите одно отслеживаемое поведение, один результат и короткий период. NOOP сравнивает дни с этим поведением с днями до начала, когда его не было."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一项你记录的行为、一个结果和一个短窗口。NOOP 会将你记录该行为的日子与开始之前你没有该行为的日子进行比较。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一項你記錄的行為、一個結果和一個短窗口。NOOP 會將你記錄該行為的日子與開始之前你沒有該行為的日子進行比較。"
          }
        }
      }
    },
    "Pick the ring": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle den Ring"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el anillo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir la bague"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli l'anello"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o anel"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите кольцо"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择戒指"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇戒指"
          }
        }
      }
    },
    "Pick what's driving this — the coach uses it to shape its advice, not just decorate the screen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, was dich antreibt — der Coach nutzt das, um seine Ratschläge zu formen, nicht nur zur Deko."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick what's driving this — the coach uses it to shape its advice, not just decorate the screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué te impulsa: el coach lo usa para dar forma a sus consejos, no solo para decorar la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis ce qui te motive — le coach s'en sert pour façonner ses conseils, pas juste pour décorer l'écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli cosa lo spinge: l'allenatore lo usa per dare forma ai suoi consigli, non solo per decorare lo schermo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o que está motivando isso – o treinador usa isso para moldar seus conselhos, não apenas para decorar a tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, что движет этим — тренер использует это для формирования своих советов, а не просто для украшения экрана."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择驱动因素——教练用它来制定建议，而不仅仅是装饰屏幕。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇驅動因素——教練用它來製定建議，而不僅僅是裝飾螢幕。"
          }
        }
      }
    },
    "Pick when the nap started and ended. NOOP stages it from your data as its own session, separate from the night's sleep.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, wann das Nickerchen begann und endete. NOOP teilt es aus deinen Daten als eigene Sitzung ein, getrennt vom Nachtschlaf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cuándo empezó y terminó la siesta. NOOP la clasifica a partir de tus datos como una sesión propia, separada del sueño nocturno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez quand la sieste a commencé et s'est terminée. NOOP la classe à partir de vos données comme sa propre séance, distincte du sommeil de la nuit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli quando è iniziato e finito il sonnellino. NOOP ne ricostruisce le fasi dai tuoi dati come sessione a sé, separata dal sonno notturno."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha quando o cochilo começou e terminou. O NOOP organiza-o a partir dos teus dados como uma sessão própria, separada da noite de sono."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите, когда начался и закончился дневной сон. NOOP определит его стадии по вашим данным как отдельную сессию, независимую от ночного сна."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择小睡的开始和结束时间。NOOP 会将其作为独立于夜间睡眠的单独会话，根据你的数据进行分期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
