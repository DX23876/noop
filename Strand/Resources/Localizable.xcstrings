    "Weekly sets are judged against the researched range once the week is complete." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wochensätze werden erst nach Abschluss der Woche an der erforschten Spanne gemessen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weekly sets are judged against the researched range once the week is complete."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las series semanales se comparan con el rango investigado una vez completada la semana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les séries hebdomadaires sont comparées à la plage étudiée une fois la semaine terminée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serie settimanali vengono confrontate con l'intervallo studiato solo a settimana conclusa."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serie tygodniowe są oceniane względem zbadanego zakresu dopiero po zakończeniu tygodnia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As séries semanais são comparadas com o intervalo investigado assim que a semana estiver completa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недельные подходы сравниваются с исследованным диапазоном только после завершения недели."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整周结束后，才会将每周组数与研究区间比较。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整週結束後，才會將每週組數與研究區間比較。"
          }
        }
      }
    },
