    "You've banked about %@ of sleep debt over %@. Surplus nights count back against it. An earlier night or two would clear it." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast über %2$@ etwa %1$@ Schlafdefizit angesammelt. Überschuss-Nächte zählen dagegen. Ein oder zwei frühere Nächte würden es ausgleichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You've banked about %1$@ of sleep debt over %2$@. Surplus nights count back against it. An earlier night or two would clear it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has acumulado alrededor de %@ de deuda de sueño en %@. Las noches con superávit la reducen. Una o dos noches acostándote más temprano la eliminarían."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez accumulé environ %1$@ de dette de sommeil sur %2$@. Les nuits en excédent la réduisent. Une ou deux nuits plus tôt suffiraient à l'effacer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai accumulato circa %@ di debito di sonno su %@. Le notti in surplus lo riducono. Una o due serate anticipate lo azzererebbero."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nałożyłeś około %1$@ długu snu na %2$@. Nadwyżki nocy odliczają się do tego. Wcześniejsza noc lub dwie załatwiłyby sprawę."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acumulou cerca de %1$@ de dívida de sono em relação a %2$@. As noites excedentes contam contra ele. Uma ou duas noites anteriores resolveriam tudo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы накопили около %1$@ недосыпа за %2$@. Ночи с избытком сна засчитываются в его погашение. Одна-две более ранние ночи помогли бы его закрыть."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你累积了约 %@ 的睡眠负债，时间跨度为%@。盈余的夜晚会抵消它。早睡一两晚就能还清。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你累積了約 %@ 的睡眠負債（期間：%@）。有盈餘的夜晚會抵銷它。早睡一兩晚就能還清。"
          }
        }
      }
    },
