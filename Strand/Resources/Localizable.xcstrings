    "Reanalysis replaces derived scores only. Raw sensor data and your sleep or workout corrections stay unchanged." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Neuanalyse ersetzt nur abgeleitete Werte. Rohdaten sowie deine Schlaf- und Workout-Korrekturen bleiben unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reanalysis replaces derived scores only. Raw sensor data and your sleep or workout corrections stay unchanged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nuevo análisis solo sustituye las puntuaciones derivadas. Los datos sin procesar y tus correcciones de sueño o entrenamientos no cambian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nouvelle analyse remplace uniquement les scores calculés. Les données brutes et vos corrections de sommeil ou d’entraînement restent inchangées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nuova analisi sostituisce solo i punteggi calcolati. I dati grezzi e le correzioni di sonno o allenamenti restano invariati."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponowna analiza zastępuje tylko wyliczone wyniki. Surowe dane oraz poprawki snu i treningów pozostają bez zmian."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A nova análise substitui apenas as pontuações calculadas. Os dados brutos e as correções de sono ou treino permanecem inalterados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторный анализ заменяет только вычисленные показатели. Исходные данные и исправления сна или тренировок не меняются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新分析只会替换计算出的分数。原始传感器数据以及睡眠或训练修正不会改变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新分析只會替換計算出的分數。原始感測器資料以及睡眠或訓練修正不會改變。"
          }
        }
      }
    },
