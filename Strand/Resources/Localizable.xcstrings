          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Edite como o treinador pensa e fala. Entra em vigor na tua próxima mensagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
