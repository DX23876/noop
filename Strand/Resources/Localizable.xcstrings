          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется для тренировочной недели, недельного плана, карты регулярности и активных недель в разделе «Сила»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于训练周、每周计划、规律性热图以及“力量”中的活跃周。"
