        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esforço de poderes agora; Carregue e descanse assim que as noites suficientes e a descodificação forem confirmadas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас обеспечивает данными Усилие; Заряд и Отдых — как только накопится достаточно ночей и подтвердится декодирование"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在驱动消耗；待累积足够的夜晚并确认解码后，将驱动能量和休息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前為消耗提供資料；累積足夠夜晚並確認解碼後，也會支援能量和休息"
          }
        }
      }
    },
    "Powers Rest, Effort, Fitness Age and steps, plus Charge once recovery calibrates": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speist Ruhe, Anstrengung, Fitnessalter und Schritte, plus Ladung, sobald die Erholung kalibriert ist"
          }
        },
        "es": {
          "stringUnit": {
