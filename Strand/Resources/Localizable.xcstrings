    "Removing a waypoint doesn't change your goal or its date — only the route to it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen Wegpunkt zu entfernen ändert weder dein Ziel noch sein Datum — nur die Route dorthin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removing a waypoint doesn't change your goal or its date — only the route to it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar un punto no cambia tu objetivo ni su fecha, solo la ruta hacia él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer un jalon ne change ni votre objectif ni sa date — seulement l'itinéraire pour y arriver."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovere una tappa non cambia il tuo obiettivo né la sua data — solo la rotta per arrivarci."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięcie punktu trasy nie zmienia Twojego celu ani jego daty — zmienia tylko drogę do niego."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remover um ponto não muda o teu objetivo nem a sua data — apenas a rota até lá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаление точки не меняет ни цель, ни её дату — только маршрут к ней."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
