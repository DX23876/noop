    "Charge %lld today, so your band is %lld–%lld bpm.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge heute %lld, daher liegt dein Zielbereich bei %lld–%lld bpm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge hoy %lld, así que tu zona es %lld–%lld ppm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge de %lld aujourd'hui, donc votre zone est de %lld–%lld bpm."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge oggi %lld, quindi la tua fascia è %lld–%lld bpm."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Carregue %lld hoje, então a tua banda terá %lld–%lld bpm."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заряд %lld сегодня, поэтому ваш диапазон — %lld–%lld уд/мин."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天 Charge 为 %lld，因此你的目标区间为 %lld–%lld bpm。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天 Charge 為 %lld，因此你的目標區間為 %lld–%lld bpm。"
          }
        }
      }
    },
