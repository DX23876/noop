    "Sleep scored from how long you slept versus how much you needed, how efficient the night was, and the restorative (deep and REM) share of it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlaf bewertet daraus, wie lange du im Verhältnis zu deinem Bedarf geschlafen hast, wie effizient die Nacht war und welchen erholsamen Anteil (Tief- und REM-Schlaf) sie hatte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sueño se puntúa según cuánto dormiste frente a cuánto necesitabas, lo eficiente que fue la noche y la proporción reparadora (profundo y REM)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sommeil est noté selon la durée dormie par rapport à votre besoin, l'efficacité de la nuit et la part réparatrice (profond et paradoxal)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sonno viene valutato in base a quanto hai dormito rispetto a quanto ti serviva, all'efficienza della notte e alla quota rigenerante (profondo e REM)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen oceniany jest na podstawie tego, jak długo spałeś w porównaniu z tym, ile potrzebujesz, jak wydajna była noc i jaki był jej udział w regeneracji (głęboki i REM)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sono foi avaliado com base no tempo que dormiu versus quanto precisava, quão eficiente foi a noite e a parcela reparadora (profunda e REM) da mesma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оценка сна складывается из того, сколько вы спали относительно потребности, насколько эффективной была ночь, и доли восстановительного (глубокого и быстрого) сна в ней."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠评分基于实际睡眠时长与所需时长的对比、整晚的睡眠效率，以及修复性睡眠（深睡和快速眼动）所占的比例。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠評分依據：你的睡眠時長相對於所需時長、整晚的效率，以及修復性睡眠（深睡和 REM）所佔的比例。"
          }
        }
      }
    },
    "Sleep sorting, scores, recording, and where your numbers come from." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlaf-Einsortierung, Werte, Aufzeichnung und woher deine Zahlen kommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clasificación del sueño, puntuaciones, registro y de dónde vienen tus números."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classement du sommeil, scores, enregistrement, et d'où viennent vos chiffres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordinamento del sonno, punteggi, registrazione e da dove vengono i tuoi numeri."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortowanie snu, wyniki, nagrywanie i skąd pochodzą Twoje liczby."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classificação do sono, pontuações, gravação e de onde vêm os teus números."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сортировка сна, оценки, запись и то, откуда берутся ваши данные."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
