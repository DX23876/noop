    "Are these the same session?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist das dieselbe Einheit?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
