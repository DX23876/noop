    "%@: %@ kg is above your estimated one-rep max of %@ kg for this movement. The estimate is a projection, not a lift you made — but check the number." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %@ kg liegt über deinem geschätzten Ein-Wiederholungs-Maximum von %@ kg für diese Bewegung. Die Schätzung ist eine Projektion, kein Gewicht, das du gehoben hast – aber überprüfe die Zahl."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@ kg is above your estimated one-rep max of %3$@ kg for this movement. The estimate is a projection, not a lift you made — but check the number."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %@ kg supera tu máximo estimado de un repetición de %@ kg para este movimiento. La estimación es una proyección, no un levantamiento — pero revisa la cifra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %@ kg dépasse votre estimation de la charge maximale d’un seul mouvement de %@ kg. Cette estimation est une projection, pas une répétition réelle — vérifiez le chiffre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %@ kg è sopra la tua stima di massimo di un ripetimento di %@ kg per questo movimento. La stima è una proiezione, non un sollevamento effettivamente eseguito — ma controlla il valore."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %@ kg jest powyżej szacowanej maksymalnej jednej próby tego ruchu — %@ kg. Szacunek jest prognozą, a nie faktem — sprawdź liczbę."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %@ kg está acima do seu máximo estimado de um rep de %@ kg para este movimento. A estimativa é uma projeção, não um levantamento que você fez — mas verifique o número."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %@ кг превышают ваш предполагаемый максимум одной реполя — %@ кг для этого движения. Оценка — это прогноз, а не совершенная работа — но проверьте цифру."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@数字 :%@千克高于您估计的最多一分之一%@用于此运动。 估计是投影,而不是你搭的电梯——但请检查数字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@數字 :%@千克高於您估計的最多一分之一%@用於此運動。 估計是投影,而不是你搭的電梯——但請檢查數字。"
          }
        }
      }
    },
