    "Calibrating. Building your baseline. About %lld more nights until your scores are personal." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalibrierung. Deine Basislinie wird aufgebaut. Noch etwa %lld Nächte, bis deine Werte persönlich sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calibrando. Construyendo tu línea base. Faltan unas %lld noches para que tus puntuaciones sean personales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
