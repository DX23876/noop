    "Warn me about caffeine close to bedtime" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warne mich vor Koffein nahe der Schlafenszeit"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avísame sobre la cafeína cerca de la hora de dormir"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M'avertir en cas de caféine proche du coucher"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvisami sulla caffeina vicino all'ora di dormire"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostrzegaj mnie o kofeinie przed snem"
          }
