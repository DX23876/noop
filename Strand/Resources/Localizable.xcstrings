          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un petit rappel"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una rapida spinta"
          }
        },
        "pt-PT": {
