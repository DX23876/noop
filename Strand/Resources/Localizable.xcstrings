    "Buzzes after you've been sitting past your threshold.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibriert, wenn du länger als deine Schwelle gesessen hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibra cuando llevas sentado más tiempo de tu umbral."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibre quand vous êtes resté assis au-delà de votre seuil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibra quando sei rimasto seduto oltre la tua soglia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Emite um sinal sonoro depois de passar do limite."
