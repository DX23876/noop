          }
        }
      }
    },
    "Saved to %@. Your database is %@, over the %@ NOOP restores without asking — the backup is complete and valid, and restoring it will ask you to confirm once." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gekennzeichnet als %@. Deine Datenbank ist %@, über die %@ NOOP-Wiederherstellung ohne Eingabe — der Backup-Prozess ist abgeschlossen und gültig, und die Wiederherstellung wird dich bestätigen lassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Saved to %1$@. Your database is %2$@, over the %3$@ NOOP restores without asking — the backup is complete and valid, and restoring it will ask you to confirm once."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardado en %@. La base de datos es %@, y la restauración sin %@ restaura automáticamente — la copia es completa y válida, y la restauración te pedirá confirmar una vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauvé dans %@. Votre base de données est %@, sur les %@ NOOPs de récupération sans autorisation — la sauvegarde est complète et valide, et la restauration vous demandera une confirmation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvato in %@. La tua base dati è %@, e in %@ l'azione NOOP ripristina automaticamente senza conferma — la copia di sicurezza è completa e valida, e il ripristino richiede conferma."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisane do %@. Twoja baza danych jest %@, ponad %@ NOOP przywraca bez potwierdzania — zapis jest kompletny i ważny, a przywrócenie wymaga potwierdzenia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardado para %@. A sua base de dados é %@, e o %@ NOOP restaura sem necessidade — o backup está completo e válido, e a restauração pedirá confirmação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранено в %@. База данных находится в %@, а %@ NOOP восстанавливает данные без подтверждения — резерв сохраняется и является действительным, и восстановление потребует подтверждения."
