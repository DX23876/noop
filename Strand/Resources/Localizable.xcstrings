          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accettazioni, rifiuti e sessioni saltate ripetuti per le sessioni suggerite"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceitações, recusas e sessões ignoradas repetidas em sessões sugeridas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторяющиеся принятия, отказы и пропуски предложенных тренировок"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "围绕建议训练的重复接受、拒绝和跳过"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圍繞建議訓練的重複接受、拒絕與跳過"
          }
        }
      }
    },
    "Replace all current data with the backup %@? This cannot be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle aktuellen Daten durch die Sicherung %@ ersetzen? Das kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Reemplazar todos los datos actuales con el respaldo %@? Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacer toutes les données actuelles par la sauvegarde %@ ? Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituire tutti i dati attuali con il backup %@? Questa operazione non può essere annullata."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitua todos os dados atuais pelo cópia de segurança %@? Isto não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заменить все текущие данные резервной копией %@? Это действие нельзя отменить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用备份 %@ 替换当前的全部数据？此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要用備份 %@ 取代目前的所有資料嗎？此操作無法復原。"
          }
        }
      }
    },
    "Replace all current data with the backup from %@? This cannot be undone.": {
