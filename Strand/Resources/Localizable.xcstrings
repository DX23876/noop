          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dejaste una sesión en marcha. No se ha perdido nada: retómala donde la dejaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as laissé une séance en cours. Rien n'est perdu : reprends là où tu t'es arrêté."
          }
        },
        "it" : {
