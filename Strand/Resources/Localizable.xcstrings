            "state" : "translated",
            "value" : "Na wysokości brodawek, na końcu normalnego wydechu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À altura dos mamilos, no fim de uma expiração normal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На уровне сосков, в конце обычного выдоха."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在乳头高度，正常呼气末测量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在乳頭高度，正常呼氣末測量。"
          }
        }
      }
    },
    "At or a little above your usual load, and it is working." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf oder etwas über deiner üblichen Belastung – und es wirkt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Igual o algo por encima de tu carga habitual, y está funcionando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Égale ou un peu au-dessus de votre charge habituelle, et ça fonctionne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pari o poco sopra il tuo carico abituale, e funziona."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na zwykłym poziomie lub nieco powyżej – i to działa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Igual ou um pouco acima da tua carga habitual, e está a resultar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На уровне обычной нагрузки или чуть выше — и это работает."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "负荷等于或略高于平时，并且有效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "負荷等於或略高於平時，並且有效。"
          }
        }
      }
    },
    "at or below baseline" : {
      "localizations" : {
