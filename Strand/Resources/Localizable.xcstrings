        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дешевая и быстрая модель, используемая только для обслуживания памяти. Чтобы сохранить дешевизну, сохраняйте небольшой размер."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "廉价、快速的模型仅用于内存维护——保持较小的尺寸以保持便宜。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "廉價、快速的模型僅用於記憶體維護——保持較小的尺寸以保持便宜。"
          }
        }
      }
    },
    "The coach can't send this by itself — only this button does." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Coach kann das nicht alleine erledigen – dafür ist nur diese Schaltfläche da."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El entrenador no puede enviarlo por sí solo — solo este botón sí."
          }
        },
        "fr" : {
          "stringUnit" : {
