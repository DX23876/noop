    "Research-grade alternatives / precision tweaks. Opt-in, off by default, non-clinical." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Research-Grade Alternativen / Präzisions-Tweaks. Opt-in, standardmäßig ausgeschaltet, nicht klinisch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opciones de grado de investigación / ajustes de precisión. Opt-in, por defecto, no clínico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
