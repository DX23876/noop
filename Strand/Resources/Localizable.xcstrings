            "value" : "Pas encore de répartition de la Charge"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora nessun dettaglio della carica"
          }
        },
        "pl" : {
          "stringUnit" : {
