          }
        }
      }
    },
    "Removes this recorded sleep and recomputes the day without it. NOOP won't re-detect sleep in this window. You can undo for a few seconds after.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt diesen aufgezeichneten Schlaf und berechnet den Tag ohne ihn neu. NOOP erkennt den Ruhezustand in diesem Fenster nicht erneut. Anschließend können Sie den Vorgang einige Sekunden lang rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes this recorded sleep and recomputes the day without it. NOOP won't re-detect sleep in this window. You can undo for a few seconds after."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina este sueño registrado y vuelve a calcular el día sin él. NOOP no volverá a detectar el sueño en esta ventana. Puedes deshacerlo durante unos segundos después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime ce sommeil enregistré et recalcule la journée sans celui-ci. NOOP ne détectera pas à nouveau le sommeil dans cette fenêtre. Vous pouvez annuler pendant quelques secondes après."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove questo sonno registrato e ricalcola il giorno senza di esso. NOOP non rileverà nuovamente il sonno in questa finestra. Puoi annullare per alcuni secondi dopo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove esse sono registrado e recalcula o dia sem ele. NOOP não detectará novamente o sono nesta janela. Você pode desfazer por alguns segundos depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет записанный сон и пересчитывает день без него. NOOP не будет повторно определять сон в этом окне. Вы можете отменить действие через несколько секунд."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除此记录的睡眠并重新计算没有它的一天。 NOOP 不会在此窗口中重新检测睡眠。您可以在几秒钟后撤消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除此記錄的睡眠並重新計算沒有它的一天。 NOOP 不會在此視窗中重新偵測睡眠。您可以在幾秒鐘後撤消。"
          }
        }
      }
    },
    "Removes this recorded sleep and recomputes the day without it. This can't be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt diesen aufgezeichneten Schlaf und berechnet den Tag ohne ihn neu. Das kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina este sueño registrado y recalcula el día sin él. Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime ce sommeil enregistré et recalcule le jour sans lui. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove questo sonno registrato e ricalcola il giorno senza di esso. Questa azione non può essere annullata."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove esse sono registado e recalcula o dia sem ele. Isso não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет эту запись сна и пересчитывает день без неё. Это действие нельзя отменить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除这条已记录的睡眠，并在没有它的情况下重新计算当天。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除這筆已記錄的睡眠，並在沒有它的情況下重新計算當天。此操作無法撤銷。"
          }
        }
      }
    },
