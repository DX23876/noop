          "stringUnit" : {
            "state" : "translated",
            "value" : "Weszli razem; przechowywane jako dwa znaczniki, dzięki czemu każdy z nich idealnie dopasowuje się do sygnałów."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrou junto; armazenados como dois marcadores para que cada um esteja perfeitamente alinhado com os teus sinais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введены вместе; сохраняются как два маркера, чтобы каждый точно совпадал с вашими сигналами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一起录入；存储为两个标记，以便各自与你的信号清晰对齐。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一起錄入；儲存為兩個標記，以便各自與你的訊號清晰對齊。"
          }
        }
      }
    },
    "Entirely optional. Everything else works without a goal, and you can change or drop it any time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Völlig optional. Alles andere funktioniert auch ohne Ziel, und du kannst es jederzeit ändern oder verwerfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entirely optional. Everything else works without a goal, and you can change or drop it any time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totalmente opcional. Todo lo demás funciona sin un objetivo, y puedes cambiarlo o eliminarlo cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entièrement facultatif. Tout le reste fonctionne sans objectif, et vous pouvez le changer ou l’abandonner à tout moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del tutto facoltativo. Tutto il resto funziona senza un obiettivo e puoi modificarlo o eliminarlo in qualsiasi momento."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Całkowicie opcjonalne. Wszystko inne działa bez celu, a Ty możesz go zmienić lub porzucić w dowolnej chwili."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totalmente opcional. Todo o resto funciona sem objetivo e você pode alterá-lo ou abandoná-lo a qualquer momento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Совершенно необязательно. Все остальное работает без цели, и вы можете изменить или отказаться от него в любой момент."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全可选。其他一切都没有目标，您可以随时更改或放弃它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全可選。其他一切都沒有目標，您可以隨時更改或放棄它。"
          }
        }
      }
    },
    "Equal breath · ~5.5 br/min coherence" : {
