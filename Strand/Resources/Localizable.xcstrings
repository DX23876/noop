        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спрашивайте о вашем заряде, усилии, отдыхе и тренировках — на основе ваших собственных данных."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
