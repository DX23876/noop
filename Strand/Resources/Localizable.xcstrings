          "stringUnit": {
            "state": "translated",
            "value": "休息 ↔ 能量"
          }
        }
      }
    },
    "Rest: how restorative was your sleep?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhe: Wie erholsam war dein Schlaf?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descanso: ¿qué tan reparador fue tu sueño?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repos : à quel point votre sommeil a-t-il été réparateur ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riposo: quanto è stato rigenerante il tuo sonno?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Descanso: quão reparador foi o teu sono?"
