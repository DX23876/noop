    "Track a workout manually. Records heart rate and effort until you end it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichne ein Workout manuell auf. Erfasst Herzfrequenz und Anstrengung, bis du es beendest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra un entrenamiento manualmente. Guarda la frecuencia cardíaca y el esfuerzo hasta que lo termines."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez un entraînement manuellement. Enregistre la fréquence cardiaque et l'effort jusqu'à ce que vous le terminiez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traccia un allenamento manualmente, registra frequenza cardiaca e sforzo finché non lo termini."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhe um treino manualmente. Regista a frequência cardíaca e o esforço até o terminar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывайте тренировку вручную. Фиксирует пульс и усилие, пока вы её не завершите."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动追踪一次锻炼，记录心率和消耗，直到你结束它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手動追蹤一次鍛鍊，記錄心率和消耗，直到你結束它。"
          }
        }
      }
    },
    "Tracks your wake time — around %@ lately. Refreshes each time you open NOOP.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolgt Ihre Weckzeit – in letzter Zeit etwa %@. Wird jedes Mal aktualisiert, wenn Sie NOOP öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracks your wake time — around %@ lately. Refreshes each time you open NOOP."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Realiza un seguimiento de tu hora de despertar: alrededor del %@ últimamente. Se actualiza cada vez que abre NOOP."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suit votre heure de réveil – vers %@ ces derniers temps. S'actualise chaque fois que vous ouvrez NOOP."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiene traccia del tuo orario di veglia, intorno alle %@ ultimamente. Si aggiorna ogni volta che apri NOOP."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitora seu horário de despertar — por volta de %@ recentemente. Atualiza cada vez que você abre NOOP."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отслеживает время пробуждения — около %@ за последнее время. Обновляется каждый раз, когда вы открываете NOOP."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟踪您的起床时间 — 最近 %@ 左右。每次打开NOOP时刷新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "追蹤您的起床時間 — 最近 %@ 左右。每次開啟NOOP時刷新。"
          }
        }
      }
    },
