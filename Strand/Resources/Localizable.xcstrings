    "Partly estimated — your device didn't cover the whole day." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teilweise geschätzt — dein Gerät hat nicht den ganzen Tag erfasst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parcialmente estimado: tu dispositivo no cubrió todo el día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partiellement estimé : votre appareil n'a pas couvert toute la journée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parzialmente stimato: il tuo dispositivo non ha coperto l'intera giornata."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Częściowo oszacowane — Twoje urządzenie nie objęło całego dnia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parcialmente estimado — o teu dispositivo não cobriu o dia inteiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Частично оценено — устройство не охватило весь день."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分估算——你的设备未覆盖全天。"
          }
        },
