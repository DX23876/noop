    "RIR counts the repetitions left in reserve; RPE rates the set from 1 to 10. Off hides per-set effort entry and keeps ratings you already logged." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RIR zählt die Wiederholungen in Reserve; RPE bewertet den Satz von 1 bis 10. „Aus“ blendet die Eingabe pro Satz aus und behält bereits erfasste Bewertungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RIR cuenta las repeticiones en reserva; RPE valora la serie del 1 al 10. «Desactivado» oculta la entrada por serie y conserva las valoraciones ya registradas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le RIR compte les répétitions en réserve ; le RPE note la série de 1 à 10. « Désactivé » masque la saisie par série et conserve les évaluations déjà enregistrées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RIR conta le ripetizioni di riserva; RPE valuta la serie da 1 a 10. «Off» nasconde l'inserimento per serie e mantiene le valutazioni già registrate."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RIR liczy powtórzenia w zapasie; RPE ocenia serię w skali od 1 do 10. „Wyłączony” ukrywa ocenę przy seriach i zachowuje już zapisane oceny."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O RIR conta as repetições em reserva; o RPE avalia a série de 1 a 10. «Desligado» oculta a introdução por série e mantém as avaliações já registadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RIR — число повторений в запасе; RPE оценивает подход по шкале от 1 до 10. «Выкл.» скрывает ввод в каждом подходе и сохраняет уже записанные оценки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RIR 表示保留的次数；RPE 以 1 到 10 为一组评分。“关闭”会隐藏每组的输入，并保留已记录的评分。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RIR 表示保留的次數；RPE 以 1 到 10 為一組評分。「關閉」會隱藏每組的輸入，並保留已記錄的評分。"
          }
        }
      }
    },
