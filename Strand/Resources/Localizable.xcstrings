            "state" : "translated",
            "value" : "En el objetivo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans l'objectif"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In linea con l'obiettivo"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na cel"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No alvo"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В пределах цели"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
