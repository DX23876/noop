    "Waypoints are a plan, not a score — tap one to move it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wegpunkte sind ein Plan, keine Wertung — tippe einen an, um ihn zu verschieben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waypoints are a plan, not a score — tap one to move it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los puntos son un plan, no una puntuación: toca uno para moverlo."
          }
        },
        "fr" : {
