        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если запрос не появился, включите NOOP в разделе Настройки › Здоровье › Доступ к данным и устройства."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
