    "WHOOP 5.0 / MG bonds to one device at a time. Unpair it from the official WHOOP app first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WHOOP 5.0 / MG koppelt sich immer nur mit einem Gerät. Entkopple es zuerst in der offiziellen WHOOP-App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WHOOP 5.0 / MG se vincula a un solo dispositivo a la vez. Desvincúlalo primero de la app oficial de WHOOP."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le WHOOP 5.0 / MG se lie à un seul appareil à la fois. Dissociez-le d'abord de l'application officielle WHOOP."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WHOOP 5.0 / MG si abbina a un dispositivo alla volta. Prima disaccoppialo dall'app ufficiale WHOOP."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WHOOP 5.0 / MG łączy się z jednym urządzeniem na raz. Najpierw usuń parę z oficjalnej aplikacji WHOOP."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O WHOOP 5.0/MG liga-se a um dispositivo de cada vez. Primeiro, desemparelhe-o a partir da aplicação oficial WHOOP."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WHOOP 5.0 / MG сопрягается только с одним устройством одновременно. Сначала отвяжите его в официальном приложении WHOOP."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
