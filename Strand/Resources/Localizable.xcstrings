        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruota di un quarto di giro, braccia che pendono naturalmente. Scegli un lato e usa sempre lo stesso."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
