    "%lld%% left. The strap stops recording near 10%% — it won't capture tonight unless you charge it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld%% übrig. Der Strap hört bei etwa 10%% auf aufzuzeichnen – ohne Aufladen erfasst er die heutige Nacht nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Batería al %lld%%. La pulsera deja de registrar cerca del 10%% — no captará esta noche si no la cargas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il reste %lld%%. Le bracelet cesse d'enregistrer vers 10%% — il ne captera pas cette nuit sans recharge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Batteria al %lld%%. La fascia smette di registrare intorno al 10%% — non registrerà stanotte se non la ricarichi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Bateria a %lld%%. A correia deixa de gravar perto dos 10%% – não vai captar esta noite se não a carregares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Осталось %lld%%. Браслет прекращает запись около 10%% — без зарядки он не запишет сегодняшнюю ночь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剩余 %lld%%。手环在约 10%% 时就会停止记录——不充电就无法记录今晚。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剩餘 %lld%%。手環在約 10%% 時就會停止記錄——不充電就無法記錄今晚。"
          }
        }
      }
    },
