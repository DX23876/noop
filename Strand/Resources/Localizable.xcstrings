    "Set a wake time for specific days (a lie-in at the weekend, say). Days you leave alone use the time above." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege eine Aufwachzeit für bestimmte Tage fest (etwa Ausschlafen am Wochenende). Tage, die du nicht anfasst, nutzen die Zeit oben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define una hora de despertar para días concretos (por ejemplo, dormir hasta tarde el fin de semana). Los días que no toques usan la hora de arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez une heure de réveil pour des jours spécifiques (une grasse matinée le week-end, par exemple). Les jours que vous ne modifiez pas utilisent l'heure ci-dessus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta un orario di sveglia per giorni specifici, ad esempio una dormita nel weekend. I giorni che lasci invariati usano l'orario sopra."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw porę budzenia w określone dni (np. odpoczynek w weekend). Dni, w których zostajesz sam, wykorzystaj czas podany powyżej."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina um horário para acordar em dias específicos (por exemplo, um descanso ao fim de semana). Nos dias em que sai sozinho, utilize o tempo acima."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задайте время пробуждения для конкретных дней (например, для более позднего подъёма на выходных). Для остальных дней используется время, указанное выше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为特定的日子设置起床时间，比如周末睡个懒觉。你未作设置的日子会使用上方的时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為特定的日子設定起床時間，比如週末睡個懶覺。你未作設定的日子會使用上方的時間。"
          }
        }
      }
    },
