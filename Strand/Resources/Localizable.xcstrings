    "Simple rhythmic connected pacing at 2 seconds in and 2 seconds out — useful when you want a steady musical-feel loop without holds." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einfaches rhythmisch verbundenes Tempo: 2 Sekunden ein und 2 Sekunden aus — gut für eine gleichmäßige, musikalische Schleife ohne Halten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simple rhythmic connected pacing at 2 seconds in and 2 seconds out — useful when you want a steady musical-feel loop without holds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritmo conectado simple: 2 segundos in y 2 out — útil cuando quieres un bucle estable con feel musical sin retenções."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rythme connecté simple : 2 secondes in et 2 out — utile pour une boucle stable au feeling musical sans rétentions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritmo connesso semplice: 2 secondi in e 2 out — utile quando vuoi un loop stabile con feel musicale senza trattenute."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prosty rytmicznie połączony rytm: 2 sekundy in i 2 out — gdy chcesz stabilną, muzyczną pętlę bez wstrzymań."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritmo ligado simples: 2 segundos in e 2 out — útil quando queres um loop estável com feel musical sem retenções."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Простой ритмично-связный темп: 2 секунды in и 2 out — когда нужен ровный «музыкальный» цикл без задержек."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "简单连贯节奏：吸 2 秒、呼 2 秒——想要稳定、偏音乐感的循环且不屏息时很合适。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "簡單連貫節奏：吸 2 秒、呼 2 秒——想要穩定、偏音樂感的循環且不屏息時很合適。"
          }
        }
      }
    },
