    "Sleep deleted. NOOP won't detect sleep between %@ and %@ again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlaf gelöscht. NOOP erkennt den Schlaf zwischen %@ und %@ nicht mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Sleep deleted. NOOP won't detect sleep between %1$@ and %2$@ again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sueño eliminado. NOOP no detectará el sueño entre %@ y %@ nuevamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommeil supprimé. NOOP ne détectera plus le sommeil entre %@ et %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonno cancellato. NOOP non rileverà più il sonno tra %@ e %@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono excluído. NOOP não detectará suspensão entre %@ e %@ novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сон удален. NOOP больше не обнаружит сон между %@ и %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠删除了。 NOOP 不会再次检测 %@ 和 %@ 之间的睡眠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠刪除了。 NOOP 不會再偵測 %@ 與 %@ 之間的睡眠。"
          }
        }
      }
    },
