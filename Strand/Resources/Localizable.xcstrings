          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritmo medio per sessione"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Średnie tempo na sesję"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
