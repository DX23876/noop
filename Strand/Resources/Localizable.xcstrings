    "Tonight's lands after you sleep with the strap on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wert für heute Nacht kommt, nachdem du mit dem Strap geschlafen hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
