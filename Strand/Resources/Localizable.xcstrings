        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это может занять несколько минут. NOOP сохраняет все исходные данные и ручные исправления и пересчитывает только производные показатели."
          }
        },
        "zh-Hans" : {
