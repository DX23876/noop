    "%lld sets are on none of these axes (%@) — a deadlift filed under lower back sits outside push and pull, and is not counted as either." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Sätze liegen auf keiner dieser Achsen (%@) — ein Kreuzheben, das unter unterem Rücken geführt wird, liegt außerhalb von Push und Pull und zählt für keines von beiden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld series no están en ninguno de estos ejes (%@): un peso muerto clasificado en zona lumbar queda fuera de empuje y tirón, y no cuenta como ninguno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld séries ne figurent sur aucun de ces axes (%@) — un soulevé de terre classé dans le bas du dos se situe hors poussée et tirage, et n'est compté ni dans l'un ni dans l'autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serie %lld non si trovano su nessuno di questi assi (%@) — uno stacco archiviato sotto la parte bassa della schiena si trova al di fuori del push and pull e non viene conteggiato come nessuno dei due."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seria %lld nie znajduje się na żadnej z tych osi (%@) — martwy ciąg wykonany pod dolną częścią pleców znajduje się poza pchaniem i ciągnięciem i nie jest liczony jako żadna z nich."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld séries não estão em nenhum destes eixos (%@) — um levantamento terra classificado na zona lombar fica fora de empurrar e puxar, e não conta para nenhum."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наборы %lld не находятся ни на одной из этих осей (%@) — становая тяга, проведенная под поясницей, находится за пределами толчков и тяг и не считается ни одной из них."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 组不属于上述任何一个轴（%@）——例如归入下背部的硬拉，既不算推也不算拉，因此不计入对比。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 組不屬於上述任何一個軸（%@）——例如歸入下背部的硬拉，既不算推也不算拉，因此不計入對比。"
          }
        }
      }
    },
    "%lld sets couldn't be matched to a muscle group — their exercise isn't in the synced catalogue yet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Sätze ließen sich keiner Muskelgruppe zuordnen — ihre Übung steht noch nicht im synchronisierten Katalog."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld series no se pudieron asignar a un grupo muscular: su ejercicio aún no está en el catálogo sincronizado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld séries n'ont pas pu être rattachées à un groupe musculaire — leur exercice n'est pas encore dans le catalogue synchronisé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile abbinare le serie %lld a un gruppo muscolare: il loro esercizio non è ancora nel catalogo sincronizzato."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można dopasować serii %lld do grupy mięśni — ich ćwiczenia nie znajdują się jeszcze w zsynchronizowanym katalogu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld séries não puderam ser atribuídas a um grupo muscular — o seu exercício ainda não está no catálogo sincronizado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наборы %lld не удалось сопоставить с группой мышц — их упражнений еще нет в синхронизированном каталоге."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 组无法与肌肉群匹配 - 他们的练习尚未出现在同步目录中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 組無法與肌肉群匹配 - 他們的練習尚未出現在同步目錄中。"
          }
        }
      }
    },
