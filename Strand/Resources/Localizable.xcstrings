    "Surfaces a device-conditional, unverified SpO₂ estimate in the Blood Oxygen tile when no calibrated reading exists." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gerät gibt eine unbestimmte, auf dem Gerät basierende Schätzung von SpO₂ in der Blutoxygen-Karte aus, wenn keine kalibrierte Messung verfügbar ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra una estimación de SpO₂ basada en el dispositivo, sin verificación, en la casilla de Oxígeno Sanguíneo cuando no hay lectura calibrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affichage d'une estimation de SpO₂ conditionnelle et non vérifiée sur la vignette Oxygénothérapie lorsque la lecture est non calibrée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra una stima di SpO₂ condizionata dal dispositivo e non verificata nella scheda dell'ossigeno sanguigno quando non esiste una lettura calibrata."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wywołuje dane dotyczące poziomu oksydacji zależnego od urządzenia, jeśli nie ma poprawnych danych."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra uma estimativa de SpO₂ condicionada ao dispositivo e não verificada na caixa de Oxigénio Sangrento quando não há leitura calibrada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает условие использования устройства, неофициальное предвзятое значение уровня кислорода во время тренировки, если нет проверенных данных."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当没有校准读数时，在血氧仪表中显示一个设备特定且未经验证的SpO₂估算"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在血氧圖下方顯示裝置條件下的非驗證 SpO₂ 估值，當無校準讀數時。"
          }
        }
      }
    },
