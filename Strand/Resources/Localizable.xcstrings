    "Learning your baseline, %lld of %lld nights." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Baseline wird gelernt, %lld von %lld Nächten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Learning your baseline, %1$lld of %2$lld nights."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprendiendo tu línea base: %lld de %lld noches."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apprentissage de votre référence, %lld de %lld nuits."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apprendimento della tua linea di base, %1$lld di %2$lld notti."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nauka linii bazowej, %1$lld z %2$lld nocy."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprendendo a tua linha de base, %1$lld de %2$lld noites."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Формируем вашу норму, %lld из %lld ночей."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在学习你的基线，%1$lld / %2$lld 晚。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在學習你的基線，%1$lld / %2$lld 晚。"
          }
        }
      }
    },
    "Learning your baseline, %lld of %lld nights. %lld of the last %lld nights recorded no HRV. Check the strap is worn overnight and syncing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Ausgangswert wird gelernt, %lld von %lld Nächten. %lld der letzten %lld Nächte haben keine HRV aufgezeichnet. Prüfe, ob das Armband nachts getragen wird und synchronisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprendiendo tu línea base, %lld de %lld noches. %lld de las últimas %lld noches no registraron VFC. Comprueba que llevas la pulsera de noche y que sincroniza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apprentissage de votre référence, %lld nuits sur %lld. %lld des %lld dernières nuits n'ont enregistré aucune VFC. Vérifiez que le bracelet est porté la nuit et qu'il se synchronise."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apprendimento della tua media, %lld di %lld notti. %lld delle ultime %lld notti registrate non presentano HRV. Verifica che l'orologio sia indossato durante la notte e in sincronia."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uczenie się podstawowej wartości, %lld z %lld noc. %lld z ostatnich %lld noców zarejestrowanych nie posiadało RIR. Sprawdź, czy pasek jest założony na noc i jest synchronizowany."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A aprender a tua linha de base, %lld de %lld noites. %lld das últimas %lld noites não registaram VFC. Verifica se usas a pulseira à noite e se sincroniza."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Определение базовых значений, %lld ночей из %lld дня. %lld из последних %lld дней не содержали данных о реакции организма. Проверьте, что браслет надежен ночью и синхронизируется."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "学习基准，%lld个连续%lld晚。%lld个连续%lld晚没有记录到HRV。检查带子是否穿戴过夜并同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "學習基線，%lld 個 %lld 晚，%lld 個最後 %lld 個晚無 HRV。請確認帶子夜間佩戴並正常同步。"
          }
        }
      }
    },
