    "Regular tempo (~3.8s in / 3.8s out) is the default sustainable pace for a first pass and for staying the full 15 minutes." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regular-Tempo (~3,8 s ein / 3,8 s aus) ist das nachhaltige Standardtempo für den ersten Durchgang und für volle 15 Minuten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nRegular tempo (~3.8s in / 3.8s out) is the default sustainable pace for a first pass and for staying the full 15 minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tempo Regular (~3,8 s in / 3,8 s out) es el ritmo sostenible por defecto para el primer pase y para mantener los 15 minutos completos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tempo Regular (~3,8 s in / 3,8 s out) est le rythme durable par défaut pour un premier passage et pour tenir les 15 minutes complètes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tempo Regular (~3,8 s in / 3,8 s out) è il ritmo sostenibile predefinito per il primo passaggio e per restare i 15 minuti interi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo Regular (~3,8 s in / 3,8 s out) to domyślne, zrównoważone tempo na pierwszy przebieg i na pełne 15 minut."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ritmo Regular (~3,8 s in / 3,8 s out) é o ritmo sustentável predefinido para a primeira passagem e para aguentar os 15 minutos completos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Темп Regular (~3,8 с in / 3,8 с out) — устойчивый темп по умолчанию для первого прохода и для полных 15 минут."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regular 节奏（约 3.8 秒吸 / 3.8 秒呼）是首次练习与坚持满 15 分钟的可持续默认节奏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regular 節奏（約 3.8 秒吸 / 3.8 秒呼）是首次練習與堅持滿 15 分鐘的可持續預設節奏。"
          }
        }
      }
    },
