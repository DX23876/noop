    "Your signals are aligned and your load is supported. A harder session is well backed today.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Werte stimmen überein und deine Belastung ist gedeckt. Eine härtere Einheit ist heute gut abgesichert."
          }
        },
        "es": {
          "stringUnit": {
