    "Still learning your baseline. A few more nights and this fills in.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Basislinie wird noch gelernt. Nach ein paar weiteren Nächten füllt sich das."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía estamos aprendiendo tu línea base. Con algunas noches más, esto se completará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre ligne de base est encore en cours d'apprentissage. Après quelques nuits de plus, ceci se complétera."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua linea di base è ancora in fase di apprendimento. Con qualche altra notte, questo si completerà."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda a aprender a tua linha de base. Mais umas noites e isso é preenchido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Норма ещё формируется. Ещё несколько ночей — и данные появятся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍在学习你的基线。再过几晚，这里就会显示数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "仍在學習你的基線。再過幾晚，這裡就會顯示資料。"
          }
        }
      }
    },
