    "End the experiment plan. Journal and metric history stay untouched.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende den Experimentplan. Tagebuch- und Metrikverlauf bleiben unberührt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Finaliza el plan del experimento. El diario y el historial de métricas quedan intactos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminer le plan d'expérience. Le journal et l'historique des métriques restent intacts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina il piano dell'esperimento. Il diario e la cronologia delle metriche rimangono intatti."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerre o plano da experiência. O histórico do diário e das métricas permanece intacto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершить план эксперимента. История журнала и метрик останется без изменений."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束实验计划。日志和指标历史保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束實驗計劃。日誌和指標歷史保持不變。"
          }
        }
      }
    },
