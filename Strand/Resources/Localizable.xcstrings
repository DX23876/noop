    "Ask the coach for a new one if you still want it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frage den Coach nach einer neuen Version, wenn du sie noch möchtest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregunta al entrenador si aún quieres una nueva sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez au coach une nouvelle session si vous le souhaitez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi al coach una nuova unità se vuoi ancora quella."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapytaj trenera o nowy kod, jeśli nadal chcesz."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peça ao treinador uma nova sessão se ainda quiser."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запросите тренера нового значения, если вы все еще хотите."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你仍然想要，请咨询教练，获取新的版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若您仍希望，請詢問教練是否需要更新。"
          }
        }
      }
    },
    "Ask the coach what to do this week. Anything it suggests lands here for your yes first — nothing gets scheduled behind your back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frag den Coach, was diese Woche ansteht. Alles, was er vorschlägt, landet zuerst hier für dein Ja — nichts wird hinter deinem Rücken verplant."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask the coach what to do this week. Anything it suggests lands here for your yes first — nothing gets scheduled behind your back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregunta al coach qué hacer esta semana. Todo lo que proponga aparece aquí primero para que des el sí: nada se programa a tus espaldas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande au coach quoi faire cette semaine. Tout ce qu'il propose arrive ici d'abord pour ton accord — rien n'est planifié dans ton dos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi all'allenatore cosa fare questa settimana. Tutto ciò che suggerisce arriva prima qui per il tuo sì: nulla viene programmato alle tue spalle."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapytaj trenera, co robić w tym tygodniu. Wszystko, co zaproponuje, trafia najpierw tutaj po Twoją zgodę — nic nie jest planowane za Twoimi plecami."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pergunte ao treinador o que fazer esta semana. Qualquer coisa que ele sugira chega aqui primeiro para o seu sim - nada é programado pelas suas costas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спросите тренера, что делать на этой неделе. Все, что он предлагает, сначала попадает сюда для вашего «да» — ничего не запланировано за вашей спиной."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "询问教练这周要做什么。它建议的任何内容都会首先出现在您的“是”中——没有任何事情会在您背后安排。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "詢問教練這週要做什麼。它建議的任何內容都會首先出現在您的“是”中——沒有任何事情會在您背後安排。"
          }
        }
      }
    },
