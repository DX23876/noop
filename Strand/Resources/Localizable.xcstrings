    "Good morning. Your smart alarm just woke you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guten Morgen. Dein Smart-Wecker hat dich gerade geweckt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buenos días. Tu alarma inteligente acaba de despertarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bonjour. Votre alarme intelligente vient de vous réveiller."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buongiorno. La tua sveglia intelligente ti ha appena svegliato."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzień dobry. Twój inteligentny alarm właśnie Cię obudził."
