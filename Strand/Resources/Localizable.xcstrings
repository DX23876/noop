    "Calories and macros are read from Apple Health, so anything you log in another app counts here automatically." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalorien und Makros kommen aus Apple Health — was du in einer anderen App erfasst, zählt hier automatisch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las calorías y los macros se leen de Apple Salud, así que lo que registres en otra app cuenta aquí automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les calories et les macros sont lues depuis Apple Santé : ce que vous saisissez dans une autre app compte ici automatiquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calorie e macro sono lette da Apple Salute, quindi ciò che registri in un'altra app conta qui automaticamente."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalorie i makro są odczytywane z Apple Health, więc to, co zapiszesz w innej aplikacji, liczy się tu automatycznie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As calorias e os macros são lidos da Apple Saúde, por isso o que registar noutra app conta aqui automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Калории и макросы читаются из Apple Health, поэтому всё, что вы записываете в другом приложении, учитывается здесь автоматически."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "热量与宏量营养素从 Apple 健康读取，你在其他 App 记录的内容会自动计入这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "熱量與宏量營養素從 Apple 健康讀取，你在其他 App 記錄的內容會自動計入這裡。"
          }
        }
      }
    },
