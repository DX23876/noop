          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your photo stays on %@. The coach is never shown your picture — only its name and tone reach your provider."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu foto permanece en %@. Al coach nunca se le muestra tu imagen; solo su nombre y su tono llegan a tu proveedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta photo reste sur %@. Le coach ne voit jamais ton image — seuls son nom et son ton parviennent à ton fournisseur."
