          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快速推動"
          }
        }
      }
    },
    "A quick word before we connect": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kurzes Wort, bevor wir verbinden"
          }
        },
        "es": {
          "stringUnit": {
