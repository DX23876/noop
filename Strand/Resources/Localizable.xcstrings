    "See how Charge, Effort and Rest are calculated, and how they differ from WHOOP.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh, wie Ladung, Anstrengung und Ruhe berechnet werden und wie sie sich von WHOOP unterscheiden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira cómo se calculan la Carga, el Esfuerzo y el Descanso, y en qué se diferencian de WHOOP."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Découvrez comment la Charge, l'Effort et le Repos sont calculés, et en quoi ils diffèrent de WHOOP."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scopri come vengono calcolati carica, sforzo e riposo, e in cosa differiscono da WHOOP."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja como são calculados a Carga, o Esforço e o Descanso e como diferem do WHOOP."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узнайте, как рассчитываются Заряд, Усилие и Отдых и чем они отличаются от показателей WHOOP."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "了解能量、消耗和休息如何计算，以及它们与 WHOOP 的区别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "了解能量、消耗和休息如何計算，以及它們與 WHOOP 的區別。"
          }
        }
      }
    },
