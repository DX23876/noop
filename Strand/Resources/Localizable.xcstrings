    "No measured temperature for these nights — showing the difference from your baseline instead. A re-score refills temperatures for nights that have one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diese Nächte keine gemessene Temperatur — stattdessen wird die Abweichung von deinem Ausgangswert gezeigt. Eine Neubewertung füllt Temperaturen für Nächte nach, die eine haben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin temperatura medida para estas noches: se muestra la diferencia respecto a tu línea base. Un recálculo rellena las temperaturas de las noches que la tengan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune température mesurée pour ces nuits — l'écart par rapport à votre référence est affiché à la place. Un recalcul rétablit les températures des nuits qui en ont une."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun valore di temperatura misurato per queste notti — viene visualizzato il valore differenziale rispetto alla tua media. Una ri-valutazione ripristina le temperature per le notti con dati."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak pomiaru temperatury w tych nocach — wyświetlany jest odchylenie od podstawowej wartości. Ponowna ocena uzupełnia temperatury w przypadkach, gdy są dostępne."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem temperatura medida para estas noites — é mostrada a diferença face à tua linha de base. Um novo cálculo repõe as temperaturas das noites que a tenham."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для этих ночей отсутствует измерение температуры — показана только разница от базовой точки. Пересчет восстанавливает температуры для ночей, где их есть."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些夜晚没有测量温度——显示的是与基线值的差异。重新评分会为有记录的夜晚补充温度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些夜晚沒有測量溫度——顯示的是與基線的差異。重新評估將為有紀錄之夜重新設定溫度。"
          }
        }
      }
    },
