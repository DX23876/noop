          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo estratto è troppo grande per essere rivisto localmente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto extraído é muito grande para ser revisado localmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Извлеченный текст слишком велик для локального просмотра."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
