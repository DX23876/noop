    "%@. Swipe or tap to change day": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Zum Tageswechsel streichen oder tippen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Desliza o toca para cambiar de día"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Balayez ou touchez pour changer de jour"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Scorri o tocca per cambiare giorno"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Deslize ou toque para alterar o dia"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Проведите пальцем или нажмите, чтобы сменить день"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。滑动或点击以切换日期"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。滑動或點擊以切換日期"
