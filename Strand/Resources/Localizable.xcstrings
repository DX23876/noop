    "Stops reading a cycle phase from your nightly temperature. You can turn it back on here any time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beendet das Ablesen einer Zyklusphase aus deiner nächtlichen Temperatur. Du kannst es hier jederzeit wieder einschalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja de leer la fase del ciclo a partir de tu temperatura nocturna. Puedes volver a activarlo aquí cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrête de déduire une phase du cycle à partir de votre température nocturne. Vous pouvez le réactiver ici à tout moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smette di rilevare una fase del ciclo dalla tua temperatura notturna. Puoi riattivarlo qui in qualsiasi momento."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przestaje odczytywać fazę cyklu na podstawie nocnej temperatury. W każdej chwili możesz włączyć tę funkcję ponownie tutaj."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pára de ler uma fase do ciclo a partir da tua temperatura nocturna. Pode ligá-lo novamente aqui a qualquer momento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прекращает определение фазы цикла по ночной температуре. Вы можете снова включить это здесь в любой момент."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止从你的夜间温度中读取周期阶段。你可以随时在这里重新开启它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止從你的夜間溫度中讀取週期階段。你可以隨時在這裡重新開啟它。"
          }
        }
      }
    },
    "Stops recording and saves what's captured so far" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beendet die Aufzeichnung und speichert, was bisher erfasst wurde"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja de grabar y guarda lo capturado hasta ahora"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrête l'enregistrement et enregistre ce qui a été capturé jusqu'ici"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interrompe la registrazione e salva ciò che è stato catturato finora"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatrzymuje nagrywanie i zapisuje dotychczas przechwycone nagrania"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para a gravação e guarda o que foi capturado até agora"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Останавливает запись и сохраняет уже собранные данные"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止记录并保存目前已采集的内容"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止記錄並儲存目前已擷取的內容"
          }
        }
      }
    },
    "Stops the button moving if you brush it. Tapping still opens Coach." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verhindert, dass sich der Knopf verschiebt, wenn du ihn streifst. Antippen öffnet den Coach weiterhin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stops the button moving if you brush it. Tapping still opens Coach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evita que el botón se mueva si lo rozas. Al tocarlo sigue abriéndose el Coach."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empêche le bouton de bouger si tu l'effleures. Un appui ouvre toujours le Coach."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arresta il movimento del pulsante se lo spazzoli. Toccando si apre ancora Coach."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapobiega przesunięciu przycisku przy muśnięciu. Dotknięcie nadal otwiera trenera."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interrompe o movimento do botão se você tocá-lo. Tocar ainda abre Coach."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
