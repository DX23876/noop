            "state": "translated",
            "value": "Aus: Der Coach antwortet allgemein und sendet keine deiner Metriken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: el coach responde de forma general y no envía ninguna de tus métricas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé : le coach répond de façon générale et n'envoie aucune de vos métriques."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Off, il coach risponde in modo generico e non invia nessuna delle tue metriche."
          }
        },
        "pt-PT": {
          "stringUnit": {
