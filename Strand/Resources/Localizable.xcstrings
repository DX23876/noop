    "Fatigue is an estimate from working sets and exponential decay. It does not measure recovery or readiness." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ermüdung ist eine Schätzung aus Arbeitssätzen und exponentiellem Abklingen. Sie misst weder Erholung noch Trainingsbereitschaft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fatigue is an estimate from working sets and exponential decay. It does not measure recovery or readiness."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fatiga es una estimación basada en las series de trabajo y el decaimiento exponencial. No mide la recuperación ni la disposición para entrenar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fatigue est une estimation issue des séries de travail et d’une décroissance exponentielle. Elle ne mesure ni la récupération ni l’aptitude à s’entraîner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’affaticamento è una stima basata sulle serie allenanti e sul decadimento esponenziale. Non misura il recupero o la prontezza."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmęczenie jest oszacowaniem na podstawie serii roboczych i wykładniczego zaniku. Nie mierzy regeneracji ani gotowości."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fadiga é uma estimativa baseada nas séries de trabalho e no decaimento exponencial. Não mede a recuperação nem a prontidão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Утомление — это оценка по рабочим подходам и экспоненциальному затуханию. Она не измеряет восстановление или готовность."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "疲劳值根据正式组和指数衰减进行估算，不代表对恢复或训练准备度的测量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "疲勞值根據正式組和指數衰減進行估算，不代表對恢復或訓練準備度的測量。"
          }
        }
      }
    },
