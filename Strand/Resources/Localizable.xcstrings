        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás en equilibrio con tu línea base, así que un esfuerzo moderado es acertado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes en équilibre avec votre référence, un effort modéré est donc bien jugé"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei in equilibrio con la tua linea di base, quindi un carico moderato è una buona scelta"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Está em equilíbrio com a tua linha de base, pelo que um esforço moderado é bem avaliado"
