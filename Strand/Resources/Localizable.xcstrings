    "Building your baseline. About %lld more %@ until your scores are personal.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Basislinie wird aufgebaut. Noch etwa %1$lld %2$@, bis deine Werte persönlich sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Building your baseline. About %1$lld more %2$@ until your scores are personal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Construyendo tu línea base. Faltan unos %lld %@ para que tus puntuaciones sean personales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
