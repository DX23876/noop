    "Incl. Helio. Live heart rate where the band exposes it. Help us test.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkl. Helio. Live-Herzfrequenz, wo das Band sie freigibt. Hilf uns beim Testen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incl. Helio. Frecuencia cardíaca en vivo cuando la banda la expone. Ayúdanos a probar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclut Helio. Fréquence cardiaque en direct lorsque la bande l'expose. Aidez-nous à tester."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incl. Helio. Frequenza cardiaca in diretta dove il braccialetto la espone. Aiutaci a testare."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclui. Hélio. Frequência cardíaca em direto onde a banda a expõe. Ajude-nos a testar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкл. Helio. Пульс в реальном времени там, где браслет его предоставляет. Помогите нам протестировать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包括 Helio。手环开放时可读实时心率。帮我们一起测试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "含 Helio。只要手環有開放即可顯示即時心率。幫我們測試。"
          }
        }
      }
    },
