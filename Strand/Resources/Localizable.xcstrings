          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się teraz bezpiecznie wykonać kopii zapasowej. Ostatnie zmiany nadal znajdują się w dzienniku zapisów z wyprzedzeniem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível fazer o cópia de segurança em segurança agora. As alterações recentes ainda estão no registo de gravação antecipada."
