            "state": "translated",
            "value": "Associez et gérez les bandes dont NOOP tire ses lectures."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbina e gestisci le fasce da cui NOOP legge."
          }
        },
