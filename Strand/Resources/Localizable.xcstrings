    "Rate it from 1 to 10. NOOP multiplies your rating by the session duration and keeps it separate from heart-rate and strength load." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewerte sie von 1 bis 10. NOOP multipliziert deine Bewertung mit der Dauer und hält sie getrennt von Herzfrequenz- und Kraft-Last."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valórala del 1 al 10. NOOP multiplica tu valoración por la duración y la mantiene separada de la carga cardíaca y de fuerza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notez-la de 1 à 10. NOOP multiplie votre note par la durée et la sépare des charges cardio et de force."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valutala da 1 a 10. NOOP moltiplica il voto per la durata e lo mantiene separato dal carico cardiaco e di forza."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oceń od 1 do 10. NOOP mnoży ocenę przez czas trwania i oddziela ją od obciążenia tętna i siłowego."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avalia de 1 a 10. A NOOP multiplica a avaliação pela duração e mantém-na separada das cargas cardíaca e de força."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оцените от 1 до 10. NOOP умножает оценку на длительность и не смешивает её с кардио- и силовой нагрузкой."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按 1 到 10 评分。NOOP 将评分乘以训练时长，并与心率负荷和力量负荷分开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
