    "Coherent breathing at six seconds in and six seconds out (~5 breaths per minute). A slow equal pace aimed at calm and HRV-friendly rhythm — estimate only, not a clinical reading." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kohärentes Atmen: sechs Sekunden ein und sechs Sekunden aus (~5 Atemzüge pro Minute). Langsames gleiches Tempo für Ruhe und HRV-freundlichen Rhythmus — nur Schätzung, kein klinischer Wert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coherent breathing at six seconds in and six seconds out (~5 breaths per minute). A slow equal pace aimed at calm and HRV-friendly rhythm — estimate only, not a clinical reading."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiración coherente: seis segundos in y seis out (~5 respiraciones por minuto). Ritmo lento e igual para calma y un ritmo amable con la HRV — solo estimación, no lectura clínica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiration cohérente : six secondes in et six out (~5 respirations par minute). Rythme lent et égal pour le calme et un rythme favorable à la HRV — estimation seulement, pas une lecture clinique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiro coerente: sei secondi in e sei out (~5 respiri al minuto). Ritmo lento e uguale per calma e un ritmo amico della HRV — solo stima, non lettura clinica."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koherentne oddychanie: sześć sekund in i sześć out (~5 oddechów na minutę). Wolne równe tempo dla spokoju i rytmu przyjaznego HRV — tylko szacunek, nie odczyt kliniczny."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiração coerente: seis segundos in e seis out (~5 respirações por minuto). Ritmo lento e igual para calma e um ritmo amigo da HRV — só estimativa, não leitura clínica."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когерентное дыхание: шесть секунд in и шесть out (~5 дыханий в минуту). Медленный равный темп для спокойствия и HRV-дружественного ритма — только оценка, не клиническое чтение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相干呼吸：吸 6 秒、呼 6 秒（约每分钟 5 次）。慢而均等，偏平静与 HRV 友好节奏——仅为估算，非临床读数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相干呼吸：吸 6 秒、呼 6 秒（約每分鐘 5 次）。慢而均等，偏平靜與 HRV 友好節奏——僅為估算，非臨床讀數。"
          }
        }
      }
    },
