          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand %1$@ est plus élevé, %2$@ tend à être plus bas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando %@ è più alto, %@ tende a essere più basso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando %1$@ é maior, %2$@ tende a ser menor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда %1$@ выше, %2$@ обычно ниже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当%@较高时，%@往往较低。"
          }
        },
