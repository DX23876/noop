    "Avg HR is shown as typed. The HR graph, zones and Effort stay from the recorded session.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ø-HF wird wie eingegeben angezeigt. HF-Graph, Zonen und Anstrengung bleiben aus der aufgezeichneten Sitzung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La FC media se muestra tal como la escribiste. El gráfico de FC, las zonas y el Esfuerzo se mantienen de la sesión registrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La FC moy. est affichée telle que saisie. Le graphique de FC, les zones et l'Effort restent ceux de la séance enregistrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La FC media è mostrata come digitata. Il grafico FC, le zone e lo sforzo restano quelli della sessione registrata."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Avg HR é mostrado conforme introduzido. O gráfico de FC, zonas e esforço permanecem na sessão gravada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Средний пульс отображается как введено вручную. График пульса, зоны и Усилие остаются из записанной сессии."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平均心率按你输入的显示。心率图、区间和消耗仍来自记录的会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
